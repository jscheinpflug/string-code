Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"canonicalizeDummies", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"terms", ",", "canonicalize"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"canonicalize", "[", "term_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"indices", ",", "rules"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Find", " ", "all", " ", "module"}], "-", 
           RowBox[{"generated", " ", "indices"}]}], "*)"}], 
         RowBox[{
          RowBox[{"indices", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Cases", "[", 
             RowBox[{"term", ",", 
              RowBox[{"s_Symbol", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{
                 RowBox[{"SymbolName", "[", "s", "]"}], ",", 
                 RowBox[{"__", "~~", "\"\<$\>\"", "~~", 
                  RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ",", 
              "Infinity"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Replace", " ", "with", " ", "canonical", " ", "names", " ", "in", 
            " ", "order", " ", "of", " ", "appearance"}], "*)"}], 
          RowBox[{"rules", "=", 
           RowBox[{"Thread", "[", 
            RowBox[{"indices", "->", 
             RowBox[{"Take", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "\[Mu]D", ",", "\[Nu]D", ",", "\[Rho]D", ",", "\[Sigma]D", ",",
                  "\[Tau]D", ",", "\[Lambda]D"}], "}"}], ",", 
               RowBox[{"Length", "[", "indices", "]"}]}], "]"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"term", "/.", " ", "rules"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Apply", " ", "to", " ", "each", " ", "term", " ", "in", " ", "the", " ",
         "sum"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
        RowBox[{"Total", "[", 
         RowBox[{"canonicalize", "/@", 
          RowBox[{"(", 
           RowBox[{"List", "@@", "expr"}], ")"}]}], "]"}], ",", 
        RowBox[{"canonicalize", "[", "expr", "]"}]}], "]"}]}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"twoBracketReplRule", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Private`z", "[", 
         RowBox[{"2", ",", "1"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "z0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`z", "[", 
         RowBox[{"2", ",", "2"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", 
       RowBox[{"-", "z0"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`q", "[", 
         RowBox[{"2", ",", "1"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "r0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`q", "[", 
         RowBox[{"2", ",", "2"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "r0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`zbar", "[", 
         RowBox[{"2", ",", "1"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "z0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`zbar", "[", 
         RowBox[{"2", ",", "2"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", 
       RowBox[{"-", "z0"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`qbar", "[", 
         RowBox[{"2", ",", "1"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "r0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Private`qbar", "[", 
         RowBox[{"2", ",", "2"}], "]"}], "[", 
        RowBox[{"{", "}"}], "]"}], ":>", "r0"}], ",", " ", 
      RowBox[{"Private`r0", ":>", "r0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derAppend", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{
         RowBox[{"R", "[", 
          RowBox[{"before___", ",", 
           RowBox[{"ProfileX", "[", 
            RowBox[{"F_", ",", "indices_", ",", "a_", ",", "b_"}], "]"}], ",",
            "after___"}], "]"}], "*", 
         RowBox[{
          RowBox[{"der", "[", "G_", "]"}], "[", "\[Mu]_", "]"}], "*", 
         "rest___"}], "]"}], "/;", 
       RowBox[{"G", "===", "F"}]}], ":>", 
      RowBox[{"rest", " ", 
       RowBox[{"R", "[", 
        RowBox[{"before", ",", 
         RowBox[{"ProfileX", "[", 
          RowBox[{"F", ",", 
           RowBox[{"Append", "[", 
            RowBox[{"indices", ",", "\[Mu]"}], "]"}], ",", "a", ",", "b"}], 
          "]"}], ",", "after"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{
         RowBox[{"R", "[", 
          RowBox[{"before___", ",", 
           RowBox[{"ProfileX", "[", 
            RowBox[{"F_", ",", "indices_", ",", "a_", ",", "b_"}], "]"}], ",",
            "after___"}], "]"}], "*", 
         RowBox[{
          RowBox[{
           RowBox[{"der", "[", "G_", "]"}], "[", "\[Mu]_", "]"}], "^", 
          "n_Integer"}], "*", "rest___"}], "]"}], "/;", 
       RowBox[{"G", "===", "F"}]}], ":>", 
      RowBox[{"rest", " ", 
       RowBox[{"R", "[", 
        RowBox[{"before", ",", 
         RowBox[{"ProfileX", "[", 
          RowBox[{"F", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"indices", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"\[Mu]", ",", "n"}], "]"}]}], "]"}], ",", "a", ",", 
           "b"}], "]"}], ",", "after"}], "]"}]}]}]}], "}"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.987574411315071*^9, 3.987574411317347*^9}, {
  3.987574590918693*^9, 3.987574601706283*^9}, {3.9875746379951363`*^9, 
