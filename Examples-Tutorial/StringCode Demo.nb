However, we can attack more complicated OPE's. Take psi-psi-S for example

In[46]:= chirals = Private`chiralspins;
antichirals = Private`antichiralspins;

In[48]:= psi1[mu_] := R[exp\[Phi]f[-1, z1], \[Psi][mu, 0, z1]];

In[49]:= psi2[nu_] := R[exp\[Phi]f[-1, z2], \[Psi][nu, 0, z2]];

In[50]:= S3[alpha_] := R[S[{chirals[[alpha]], "chiral"}, -1/2, {}, 0, z3]];

In[51]:= T1[alpha_] := 
  Table[OPEProjected[0, 0][Bosonize[psi1[mu]], Bosonize[psi2[nu]], 
     Bosonize@S3[alpha]] // Together, {mu, 1, 10}, {nu, 1, 10}];

In[52]:= T2[alpha_] := 
  Table[Sum[
     1/(4 (z1 - z2)^2 (z1 - z3) (z2 - z3))
       I Bosonize[
       R[S[{chirals[[\[Alpha]1]], "chiral"}, -(5/2), {}, 0, 
         0]]] ((z1 - z2) GammaAntisymmetricProduct[{GammaUDHold[mu], 
           GammaDUHold[nu]}, \[Alpha]1, 
          alpha] + (z1 + z2 - 2 z3) If[\[Alpha]1 == alpha, 1, 0] If[mu == nu, 
          1, 0]), {\[Alpha]1, 1, 16}], {mu, 1, 10}, {nu, 1, 10}] // Simplify;

In[53]:= Table[T1[alpha] === T2[alpha], {alpha, 1, 16}]

Out[53]= {True, True, True, True, True, True, True, True, True, True, True, True, \
True, True, True, True}

