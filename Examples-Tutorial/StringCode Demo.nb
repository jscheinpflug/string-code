Reproducing Subscript[AdS, 5]*S^5 solution paper - [2507.12921, M. Cho, JG, JS, X. Yin]

In[6]:= (*Here we define the string fields which appear in the paper. \
Below we define massless string fields at ghost number +2, \
in both the NSNS and RR sector. \
These are the string fields which describe the background, \
as well as linear perturbations around it.*)
flux[F_, \[Alpha]_, \[Beta]_, z_, zbar_] := 
  R[ProfileX[F[\[Alpha], \[Beta]], {}, z, zbar], c[0, z], ct[0, zbar], 
   S[{\[Alpha], "chiral"}, -1/2, {}, 0, z], 
   St[{\[Beta], "chiral"}, -1/2, {}, 0, zbar]];

graviton[h_, \[Mu]_, \[Nu]_, z_, zbar_] := 
  R[ProfileX[h[\[Mu], \[Nu]], {}, z, zbar], c[0, z], ct[0, zbar], 
   exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
   exp\[Phi]tf[-1, zbar], \[Psi]t[\[Nu], 0, zbar]];

ghostDilaton[Dil_, z_, zbar_] := 
  R[ProfileX[Dil, {}, z, zbar], c[0, z], ct[0, zbar], \[Eta][0, z], 
    exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] - 
   R[ProfileX[Dil, {}, z, zbar], c[0, z], ct[0, zbar], 
    exp\[Phi]b[-2, z], \[Xi][1, z], \[Eta]t[0, zbar]];

auxField[Aux_, \[Mu]_, z_, 
   zbar_] := (1/2)*
    R[c[1, z] + ct[1, zbar], ProfileX[Aux[\[Mu]], {}, z, zbar], c[0, z], 
     ct[0, zbar], exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
     exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] + (1/2)*
    R[c[1, z] + ct[1, zbar], ProfileX[Aux[\[Mu]], {}, z, zbar], c[0, z], 
     ct[0, zbar], exp\[Phi]b[-2, z], \[Xi][1, z], 
     exp\[Phi]tf[-1, zbar], \[Psi]t[\[Mu], 0, zbar]];

fluxConstant[\[Alpha]_, \[Beta]_, z_, zbar_] := 
  R[c[0, z], ct[0, zbar], S[{\[Alpha], "chiral"}, -1/2, {}, 0, z], 
   St[{\[Beta], "chiral"}, -1/2, {}, 0, zbar]];

(*We also define massless string fields at ghost number +1 in the NSNS, \
RNS and NSR sectors. Notably, \
these include the Hamiltonian and supersymmetries.*)

susyRNS[\[Lambda]_, \[Alpha]_, z_, zbar_] := 
  R[ProfileX[\[Lambda][\[Alpha]], {}, z, zbar], c[0, z], ct[0, zbar], 
   S[{\[Alpha], "chiral"}, -1/2, {}, 0, z], 
   exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]];

susyNSR[\[Lambda]_, \[Alpha]_, z_, zbar_] := 
  R[ProfileX[\[Lambda][\[Alpha]], {}, z, zbar], c[0, z], ct[0, zbar], 
   exp\[Phi]b[-2, z], \[Xi][1, z], St[{\[Alpha], "chiral"}, -1/2, {}, 0, zbar]];

symNSNS[V_, \[Mu]_, z_, zbar_] := 
  R[ProfileX[V[\[Mu]], {}, z, zbar], c[0, z], ct[0, zbar], 
    exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
    exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] + 
   R[ProfileX[V[\[Mu]], {}, z, zbar], c[0, z], ct[0, zbar], 
    exp\[Phi]b[-2, z], \[Xi][1, z], 
    exp\[Phi]tf[-1, zbar], \[Psi]t[\[Mu], 0, zbar]];

susyRNSConstant[\[Alpha]_, z_, zbar_] := 
  R[c[0, z], ct[0, zbar], S[{\[Alpha], "chiral"}, -1/2, {}, 0, z], 
   exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]];

susyNSRConstant[\[Alpha]_, z_, zbar_] := 
  R[c[0, z], ct[0, zbar], exp\[Phi]b[-2, z], \[Xi][1, z], 
   St[{\[Alpha], "chiral"}, -1/2, {}, 0, zbar]];

symNSNSConst[\[Mu]_, z_, zbar_] := 
  R[c[0, z], ct[0, zbar], exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
    exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] + 
   R[c[0, z], ct[0, zbar], exp\[Phi]b[-2, z], \[Xi][1, z], 
    exp\[Phi]tf[-1, zbar], \[Psi]t[\[Mu], 0, zbar]];

