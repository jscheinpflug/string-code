Now, let's define some useful vertex operators:

In[13]:= flux[F_, \[Alpha]_, \[Beta]_, z_, zbar_] := 
  R[ProfileX[F[\[Alpha], \[Beta]], {}, z, zbar], c[0, z], ct[0, zbar], 
   S[{\[Alpha], "chiral"}, -1/2, {}, 0, z], 
   St[{\[Beta], "chiral"}, -1/2, {}, 0, zbar]];

graviton[h_, \[Mu]_, \[Nu]_, z_, zbar_] := 
  R[ProfileX[h[\[Mu], \[Nu]], {}, z, zbar], c[0, z], ct[0, zbar], 
   exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
   exp\[Phi]tf[-1, zbar], \[Psi]t[\[Nu], 0, zbar]];

ghostDilaton[Dil_, z_, zbar_] := 
  R[ProfileX[Dil, {}, z, zbar], c[0, z], ct[0, zbar], \[Eta][0, z], 
    exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] - 
   R[ProfileX[Dil, {}, z, zbar], c[0, z], ct[0, zbar], 
    exp\[Phi]b[-2, z], \[Xi][1, z], \[Eta]t[0, zbar]];

auxField[Aux_, \[Mu]_, z_, 
   zbar_] := (1/2)*
    R[c[1, z] + ct[1, zbar], ProfileX[Aux[\[Mu]], {}, z, zbar], c[0, z], 
     ct[0, zbar], exp\[Phi]f[-1, z], \[Psi][\[Mu], 0, z], 
     exp\[Phi]tb[-2, zbar], \[Xi]t[1, zbar]] + (1/2)*
    R[c[1, z] + ct[1, zbar], ProfileX[Aux[\[Mu]], {}, z, zbar], c[0, z], 
     ct[0, zbar], exp\[Phi]b[-2, z], \[Xi][1, z], 
     exp\[Phi]tf[-1, zbar], \[Psi]t[\[Mu], 0, zbar]];

We can compute BRST action on them

(*BRST action on picture -1/2 massless R sector*)

In[110]:= ((actBRST[flux[F, \[Alpha]1, \[Beta]1, 0, 0]] // canonicalizeDummies // 
      Expand) //. derAppend // Expand) //. {\[Delta][\[Mu]D, \[Mu]D] :> 10}

Out[110]= 1/4 \[Alpha]p GammaAntisymmetricProductHold[{}, \[Alpha]2, \[Alpha]1] R[
   c[0, 0], c[1, 0], ct[0, 0], 
   ProfileX[F[\[Alpha]1, \[Beta]1], {\[Mu]D, \[Mu]D}, 0, 0], 
   S[{\[Alpha]2, "chiral"}, -(1/2), {}, 0, 0], 
   St[{\[Beta]1, "chiral"}, -(1/2), {}, 0, 0]] - 
 1/4 \[Alpha]p GammaAntisymmetricProductHold[{}, \[Alpha]t1, \[Beta]1] R[
   c[0, 0], ct[0, 0], ct[1, 0], 
   ProfileX[F[\[Alpha]1, \[Beta]1], {\[Mu]D, \[Mu]D}, 0, 0], 
   S[{\[Alpha]1, "chiral"}, -(1/2), {}, 0, 0], 
   St[{\[Alpha]t1, "chiral"}, -(1/2), {}, 0, 0]] + 
 1/4 Sqrt[\[Alpha]p]
   GammaAntisymmetricProductHold[{GammaDUHold[\[Mu]D]}, \[Alpha]t1, \
\[Beta]1] R[c[0, 0], ct[0, 0], 
   ProfileX[F[\[Alpha]1, \[Beta]1], {\[Mu]D}, 0, 0], 
   S[{\[Alpha]1, "chiral"}, -(1/2), {}, 0, 0], 
   St[{\[Alpha]t1, "antichiral"}, 1/2, {}, 0, 0], \[Eta]t[0, 0]] + 
 1/4 Sqrt[\[Alpha]p]
   GammaAntisymmetricProductHold[{GammaDUHold[\[Mu]D]}, \[Alpha]2, \
\[Alpha]1] R[c[0, 0], ct[0, 0], 
   ProfileX[F[\[Alpha]1, \[Beta]1], {\[Mu]D}, 0, 0], 
   S[{\[Alpha]2, "antichiral"}, 1/2, {}, 0, 0], 
   St[{\[Beta]1, "chiral"}, -(1/2), {}, 0, 0], \[Eta][0, 0]]

(*BRST action on picture -1 massless NSNS sector: vector*)

In[111]:= actBRST[graviton[h, \[Mu], \[Nu], 0, 0]] //. derAppend // ContractDelta // 
  canonicalizeDummies // Simplify

Out[111]= -(1/4) Sqrt[\[Alpha]p] (R[c[0, 0], ct[0, 0], exp\[Phi]f[-1, 0], 
    ProfileX[h[\[Mu], \[Nu]], {\[Nu]}, 0, 0], \[Eta]t[0, 0], \[Psi][\[Mu], 0, 
     0]] + R[c[0, 0], ct[0, 0], exp\[Phi]tf[-1, 0], 
    ProfileX[h[\[Mu], \[Nu]], {\[Mu]}, 0, 0], \[Eta][0, 0], \[Psi]t[\[Nu], 0, 
     0]] + Sqrt[\[Alpha]p] (R[c[0, 0], c[1, 0], ct[0, 0], exp\[Phi]f[-1, 0], 
       exp\[Phi]tf[-1, 0], 
       ProfileX[h[\[Mu], \[Nu]], {\[Mu]D, \[Mu]D}, 0, 0], \[Psi][\[Mu], 0, 
