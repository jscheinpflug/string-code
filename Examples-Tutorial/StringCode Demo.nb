In[110]:= Quit[]

StringCode - demo

Initialization

In[1]:= Needs["StringCode`"];

InitStringCode[<|"theory" -> "TypeII", "CFT" -> "FlatSpace", 
   "conventions" -> "TypeII-Ashoke", "bracket" -> "Flat"|>];

Useful tools

In[3]:= canonicalizeDummies[expr_] := 
 Module[{terms, canonicalize}, 
  canonicalize[term_] := 
   Module[{indices, rules},(*Find all module-generated indices*)
    indices = 
     DeleteDuplicates[
      Cases[term, 
       s_Symbol /; StringMatchQ[SymbolName[s], __ ~~ "$" ~~ DigitCharacter ..],
        Infinity]];
    (*Replace with canonical names in order of appearance*)
    rules = Thread[
      indices -> 
       Take[{\[Mu]D, \[Nu]D, \[Rho]D, \[Sigma]D, \[Tau]D, \[Lambda]D}, 
        Length[indices]]];
    term /. rules];
  (*Apply to each term in the sum*)
  If[Head[expr] === Plus, Total[canonicalize /@ (List @@ expr)], 
   canonicalize[expr]]]

twoBracketReplRule = {Private`z[2, 1][{}] :> z0, Private`z[2, 2][{}] :> -z0, 
   Private`q[2, 1][{}] :> r0, Private`q[2, 2][{}] :> r0, 
   Private`zbar[2, 1][{}] :> z0, Private`zbar[2, 2][{}] :> -z0, 
   Private`qbar[2, 1][{}] :> r0, Private`qbar[2, 2][{}] :> r0, 
   Private`r0 :> r0};

derAppend = {HoldPattern[
      R[before___, ProfileX[F_, indices_, a_, b_], after___]*der[G_][\[Mu]_]*
       rest___] /; G === F :> 
    rest R[before, ProfileX[F, Append[indices, \[Mu]], a, b], after], 
   HoldPattern[
      R[before___, ProfileX[F_, indices_, a_, b_], after___]*
       der[G_][\[Mu]_]^n_Integer*rest___] /; G === F :> 
    rest R[before, ProfileX[F, Join[indices, ConstantArray[\[Mu], n]], a, b], 
      after]};


Simple usage

Operators and their normal-ordered products

In[3]:= (*Operators are written with their position and number of derivatives they car\
ry*)

In[59]:= c[1, z]

Out[59]= c[1, z]

In[5]:= (*R is a header for normal-ordered product*)

In[60]:= R[c[1, z], c[2, z]]

Out[60]= R[c[1, z], c[2, z]]

In[7]:= (*It is automatically ordered, with Grassmann signs*)

In[55]:= R[c[1, z], c[0, z]]

Out[55]= -R[c[0, z], c[1, z]]

In[56]:= R[c[1, z], c[1, z]]

Out[56]= 0

Wick contractions

In[10]:= (*We can Wick contract simple operators*)

In[57]:= Wick[c[1, z], b[0, w]]

Out[57]= -(1/(w - z)^2)

In[12]:= (*And composites too*)

In[58]:= SWick[dX[\[Mu], 0, z], expX[k, 0, 0]]

Out[58]= -((I \[Alpha]p k[\[Mu]])/(2 z))

Some simple OPEs

In[14]:= (*Can capture the singular part of OPE*)

In[61]:= OPEProjected[0, 0][R[b[0, z]], R[c[0, w]]]

Out[61]= 1/(-w + z)

In[62]:= OPEProjected[0, 0][R[dX[\[Mu], 0, z]], R[dX[\[Nu], 0, 0]]]

Out[62]= -((\[Alpha]p \[Delta][\[Mu], \[Nu]])/(2 z^2))

In[63]:= (*But also the regular part, at higher levels*)

In[64]:= OPEProjected[1, 0][R[b[0, z]], R[c[0, w]]]

Out[64]= R[b[0, 0], c[0, 0]]

In[65]:= OPEProjected[2, 0][R[b[0, z]], R[c[0, w]]]

Out[65]= w R[b[0, 0], c[1, 0]] + z R[b[1, 0], c[0, 0]]

In[66]:= OPEProjected[2, 0][R[dX[\[Mu], 0, z]], R[dX[\[Nu], 0, 0]]]

Out[66]= R[dX[\[Mu], 0, 0], dX[\[Nu], 0, 0]]

TypeII convention presets have a few useful operators defined

In[67]:= Tmatter[z] // canonicalizeDummies

Out[67]= -(R[dX[\[Mu]D, 0, z], dX[\[Mu]D, 0, z]]/\[Alpha]p) + 
 R[\[Psi][\[Mu]D, 0, z], \[Psi][\[Mu]D, 1, z]]

In[68]:= Gmatter[z] // canonicalizeDummies

Out[68]= -(R[dX[\[Mu]D, 0, z], \[Psi][\[Mu]D, 0, z]]/Sqrt[\[Alpha]p])

In[69]:= jBRST[z] // canonicalizeDummies

Out[69]= 1/2 R[c[0, z], d\[Phi][1, z]] + 3/2 R[c[1, z], d\[Phi][0, z]] + 
 R[b[0, z], c[0, z], c[1, z]] - 
 R[c[0, z], dX[\[Mu]D, 0, z], dX[\[Mu]D, 0, z]]/\[Alpha]p - 
 1/2 R[c[0, z], d\[Phi][0, z], d\[Phi][0, z]] - 
 R[c[0, z], \[Eta][0, z], \[Xi][1, z]] + 
 R[c[0, z], \[Psi][\[Mu]D, 0, z], \[Psi][\[Mu]D, 1, z]] - 
 1/4 R[b[0, z], exp\[Phi]b[2, z], \[Eta][0, z], \[Eta][1, z]] + 
 R[dX[\[Mu]D, 0, z], 
  exp\[Phi]f[1, z], \[Eta][0, z], \[Psi][\[Mu]D, 0, z]]/Sqrt[\[Alpha]p]

We can compute their OPE

In[24]:= (*Tmatter-Tmatter OPE*)

In[25]:= (*2 Tmatter(z)/z^2*)

In[70]:= OPEProjected[2, 0][Tmatter[z], Tmatter[0]] // canonicalizeDummies // 
  ContractDelta // Simplify

Out[70]= (2 (-R[dX[\[Nu]D, 0, 0], 
     dX[\[Nu]D, 0, 0]] + \[Alpha]p R[\[Psi][\[Nu]D, 0, 0], \[Psi][\[Nu]D, 1, 
      0]]))/(z^2 \[Alpha]p)

In[71]:= (*partial Tmatter(z)/z*)

In[72]:= OPEProjected[3, 0][Tmatter[z], Tmatter[0]] // ContractDelta // 
  Simplify // canonicalizeDummies

Out[72]= (-2 R[dX[\[Mu]D, 0, 0], 
   dX[\[Mu]D, 1, 0]] + \[Alpha]p R[\[Psi][\[Mu]D, 0, 0], \[Psi][\[Mu]D, 2, 
    0]])/(z \[Alpha]p)

In[73]:= Ttotal[z] // canonicalizeDummies

Out[73]= -R[d\[Phi][1, z]] - 2 R[b[0, z], c[1, z]] - R[b[1, z], c[0, z]] - 
 R[dX[\[Mu]D, 0, z], dX[\[Mu]D, 0, z]]/\[Alpha]p - 
 1/2 R[d\[Phi][0, z], d\[Phi][0, z]] - R[\[Eta][0, z], \[Xi][1, z]] + 
 R[\[Psi][\[Mu]D, 0, z], \[Psi][\[Mu]D, 1, z]]

In[74]:= (*Ttotal-Ttotal has 2 Total/z^2*)

In[75]:= OPEProjected[2, 0][Ttotal[z], Ttotal[0]] // ContractDelta // 
  Simplify // canonicalizeDummies

Out[75]= -1/(z^2 \[Alpha]p) (2 \[Alpha]p R[d\[Phi][1, 0]] + 
    4 \[Alpha]p R[b[0, 0], c[1, 0]] + 2 \[Alpha]p R[b[1, 0], c[0, 0]] + 
    2 R[dX[\[Mu]D, 0, 0], dX[\[Mu]D, 0, 0]] + \[Alpha]p R[d\[Phi][0, 0], 
      d\[Phi][0, 0]] + 2 \[Alpha]p R[\[Eta][0, 0], \[Xi][1, 0]] - 
    2 \[Alpha]p R[\[Psi][\[Mu]D, 0, 0], \[Psi][\[Mu]D, 1, 0]])

In[76]:= (*Necessary checks for jBRST being Virasoro primary*)

In[77]:= (OPEProjected[-1, 0][Ttotal[z], jBRST[0]] // ContractDelta // 
    Simplify) /. {\[Delta][a_, b_]^2 :> Dim} // FullSimplify

Out[77]= (3 (-10 + Dim) R[c[0, 0]])/(4 z^4)

In[78]:= (OPEProjected[0, 0][Ttotal[z], jBRST[0]] // ContractDelta // 
    Simplify) /. {\[Delta][a_, b_]^2 :> Dim} // FullSimplify

Out[78]= 0

In[79]:= (*We see 1/z^2 jBRST[\
0] after canonicalization as we should for a Virasoro primary current*)

In[80]:= (((OPEProjected[1, 0][Ttotal[z], jBRST[0]] // ContractDelta // 
        Simplify) /. {\[Delta][a_, b_]^2 :> Dim}) - 1/z^2 jBRST[0]) // 
  FullSimplify // canonicalizeDummies

Out[80]= 1/(z^2 \[Alpha]p) (-R[c[0, 0], dX[\[Mu]D, 0, 0], dX[\[Mu]D, 0, 0]] + 
   R[c[0, 0], dX[\[Nu]D, 0, 0], 
    dX[\[Nu]D, 0, 0]] + \[Alpha]p R[
     c[0, 0], \[Psi][\[Mu]D, 0, 0], \[Psi][\[Mu]D, 1, 0]] - \[Alpha]p R[
     c[0, 0], \[Psi][\[Nu]D, 0, 0], \[Psi][\[Nu]D, 1, 0]] + 
   Sqrt[\[Alpha]p]
     R[dX[\[Rho]D, 0, 0], 
     exp\[Phi]f[1, 0], \[Eta][0, 0], \[Psi][\[Rho]D, 0, 0]] - 
   Sqrt[\[Alpha]p]
     R[dX[\[Sigma]D, 0, 0], 
     exp\[Phi]f[1, 0], \[Eta][0, 0], \[Psi][\[Sigma]D, 0, 0]])

In[81]:= (*jBRST-jBRST OPE only have pure c-\
ghost terms as expected (did the calculation a while ago by hand)*)

In[82]:= (OPEProjected[-1, 0][jBRST[z], jBRST[0]] // ContractDelta // 
    Simplify) /. {\[Delta][a_, b_]^2 :> Dim} // FullSimplify

Out[82]= ((20 - 3 Dim) R[c[0, 0], c[1, 0]] + (-10 + Dim) R[
   exp\[Phi]b[2, 0], \[Eta][0, 0], \[Eta][1, 0]])/(4 z^3)

In[83]:= (OPEProjected[0, 0][jBRST[z], jBRST[0]] // ContractDelta // 
     Simplify) /. {\[Delta][a_, b_]^2 :> Dim} // 
  FullSimplify // canonicalizeDummies

Out[83]= 1/(8 z^2 Sqrt[\[Alpha]p]) (Sqrt[\[Alpha]p] ((20 - 3 Dim) R[c[0, 0], 
        c[2, 0]] + (-10 + 
         Dim) (R[exp\[Phi]b[2, 0], \[Eta][0, 0], \[Eta][2, 0]] + 
