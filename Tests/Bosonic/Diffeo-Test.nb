          RowBox[{"number", ":", "\[Mu]$1234"}]}], "->", "\[Mu]1"}], "*)"}], 
       RowBox[{"replacements", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"dummies", "->", 
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
