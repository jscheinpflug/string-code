Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"addToPathRecursive", "[", "root_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fullRoot", ",", "allDirs"}], "}"}], ",", 
      RowBox[{
       RowBox[{"fullRoot", "=", 
        RowBox[{"ExpandFileName", "[", "root", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"allDirs", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"FileNames", "[", 
           RowBox[{"\"\<*\>\"", ",", "fullRoot", ",", "Infinity"}], "]"}], 
          ",", 
          RowBox[{
           RowBox[{
            RowBox[{"DirectoryQ", "[", "#", "]"}], "&&", 
            RowBox[{"!", 
             RowBox[{"StringMatchQ", "[", 
              RowBox[{
               RowBox[{"FileNameTake", "[", "#", "]"}], ",", "\"\<.*\>\""}], 
              "]"}]}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"allDirs", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Prepend", "[", 
          RowBox[{"allDirs", ",", "fullRoot"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"$Path", ",", "dir"}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"$Path", ",", "dir"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "allDirs"}], "}"}]}], "]"}], ";"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goUpDirectories", "[", 
