Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ReplaceDummyIndices", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ReplaceDummyIndices", "[", "expr_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dummies", ",", "replacements"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "all", " ", "dummy", " ", "index", " ", "symbols", " ", 
        "like", " ", "\[Mu]$1234"}], "*)"}], 
      RowBox[{
       RowBox[{"dummies", "=", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"s_Symbol", "/;", 
            RowBox[{"StringMatchQ", "[", 
             RowBox[{
              RowBox[{"SymbolName", "[", "s", "]"}], ",", 
              RowBox[{"___", "~~", "\"\<$\>\"", "~~", "NumberString"}]}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Replace", " ", "each", " ", "dummy", " ", "with", " ", "base", " ", 
          "name", " ", "plus", " ", "running", " ", 
          RowBox[{"number", ":", "\[Mu]$1234"}]}], "->", "\[Mu]1"}], "*)"}], 
       RowBox[{"replacements", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"dummies", "->", 
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"base", "=", 
                 RowBox[{"StringReplace", "[", 
                  RowBox[{
                   RowBox[{"SymbolName", "[", "#1", "]"}], ",", 
                   RowBox[{
                    RowBox[{"\"\<$\>\"", "~~", "__"}], "->", "\"\<\>\""}]}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{"ToExpression", "[", 
                RowBox[{"base", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], 
             "&"}], ",", "dummies"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"expr", "/.", " ", "replacements"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\n"}], "Input",
