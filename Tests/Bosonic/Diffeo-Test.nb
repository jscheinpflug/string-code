    RowBox[{
     RowBox[{"{", "parts", "}"}], ",", 
     RowBox[{
      RowBox[{"parts", "=", 
       RowBox[{"FileNameSplit", "[", 
        RowBox[{"ExpandFileName", "[", "path", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"parts", ",", 
         RowBox[{
          RowBox[{"Length", "[", "parts", "]"}], "-", "n"}]}], "]"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
