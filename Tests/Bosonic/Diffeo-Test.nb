                  RowBox[{
                   RowBox[{"SymbolName", "[", "#1", "]"}], ",", 
                   RowBox[{
                    RowBox[{"\"\<$\>\"", "~~", "__"}], "->", "\"\<\>\""}]}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{"ToExpression", "[", 
                RowBox[{"base", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], 
             "&"}], ",", "dummies"}], "]"}]}], "]"}]}], ";", 
