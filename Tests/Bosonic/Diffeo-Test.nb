        "like", " ", "\[Mu]$1234"}], "*)"}], 
      RowBox[{
       RowBox[{"dummies", "=", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"s_Symbol", "/;", 
            RowBox[{"StringMatchQ", "[", 
