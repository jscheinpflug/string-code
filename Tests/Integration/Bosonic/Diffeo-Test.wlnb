   "kind": 2,
   "value": "keepUpTo[expr_,n_]:=Module[{terms},terms=If[Head[expr]===Plus,List@@expr,{expr}];\nTotal[Select[terms,Total[Cases[#,ProfileX[_,l_,_]:>Length[l],All]]<=n&]]]",
   "languageId": "wolfram",
   "outputs": [],
