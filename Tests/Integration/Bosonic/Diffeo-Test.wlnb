   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "rep[v_,idx_]:={ProfileXAntiHolo[v,{},n_]:>Sequence[],ProfileXHolo[v,{},n_]:>ProfileX[v,idx,n]};\n\ncombineProfilesRule={c_*r_R*der[v_][i_]^p_/;!FreeQ[r,ProfileXAntiHolo[v,{},_]]:>With[{idx=Table[i,p]},c*(r/. rep[v,idx])],c_*r_R*der[v_][i_]/;!FreeQ[r,ProfileXAntiHolo[v,{},_]]:>c*(r/. rep[v,{i}]),r_R*der[v_][i_]^p_/;!FreeQ[r,ProfileXAntiHolo[v,{},_]]:>With[{idx=Table[i,p]},r/. rep[v,idx]],r_R*der[v_][i_]/;!FreeQ[r,ProfileXAntiHolo[v,{},_]]:>r/. rep[v,{i}],c_*r_R/;!FreeQ[r,_ProfileXAntiHolo]:>With[{v=First@Cases[r,ProfileXAntiHolo[v_,{},_]:>v,{1}]},c*(r/. rep[v,{}])],r_R/;!FreeQ[r,_ProfileXAntiHolo]:>With[{v=First@Cases[r,ProfileXAntiHolo[v_,{},_]:>v,{1}]},r/. rep[v,{}]]};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "extractCoeffProfile[expr_,template_]:=Module[{tTerms,eTerms,getSig,getCoeff,getProfiles,tSig,tCoeff,matches,results,grouped},tTerms=If[Head[Expand[template]]===Plus,List@@Expand[template],{Expand[template]}];\neTerms=If[Head[Expand[expr]]===Plus,List@@Expand[expr],{Expand[expr]}];\ngetSig[term_]:=Module[{rExpr},rExpr=FirstCase[term,_R,None,{0,Infinity}];\nIf[rExpr===None,{},Sort@Select[List@@rExpr,Head[#]=!=ProfileX&]]];\ngetCoeff[term_]:=term/. _R->1;\ngetProfiles[term_]:=Module[{rExpr},rExpr=FirstCase[term,_R,None,{0,Infinity}];\nIf[rExpr===None,{},Select[List@@rExpr,Head[#]===ProfileX&]]];\ntSig=getSig[tTerms[[1]]];\ntCoeff=getCoeff[tTerms[[1]]];\n(*Find ALL matching terms*)matches=Select[eTerms,getSig[#]===tSig&];\nIf[Length[matches]==0,Return[<|\"coeff\"->$Failed,\"profiles\"->$Failed|>]];\n(*Create initial results*)results=<|\"coeff\"->getCoeff[#]/tCoeff,\"profiles\"->getProfiles[#]|>&/@matches;\n(*Group by profiles and sum coefficients*)grouped=GroupBy[results,#[\"profiles\"]&,Total[#[[All,\"coeff\"]]]&];\n(*Return combined results*)KeyValueMap[<|\"coeff\"->#2,\"profiles\"->#1|>&,grouped]]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
