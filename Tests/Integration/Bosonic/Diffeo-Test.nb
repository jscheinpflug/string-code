Cell[BoxData[
 RowBox[{
  RowBox[{"extractCoeffProfile", "[", 
   RowBox[{"expr_", ",", "template_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tTerms", ",", "eTerms", ",", "getSig", ",", "getCoeff", ",", 
      "getProfiles", ",", "tSig", ",", "tCoeff", ",", "matches", ",", 
      "results", ",", "grouped"}], "}"}], ",", 
    RowBox[{
     RowBox[{"tTerms", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"Expand", "[", "template", "]"}], "]"}], "===", "Plus"}], 
        ",", 
        RowBox[{"List", "@@", 
         RowBox[{"Expand", "[", "template", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"Expand", "[", "template", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eTerms", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"Expand", "[", "expr", "]"}], "]"}], "===", "Plus"}], ",", 
        RowBox[{"List", "@@", 
         RowBox[{"Expand", "[", "expr", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"Expand", "[", "expr", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getSig", "[", "term_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "rExpr", "}"}], ",", 
        RowBox[{
         RowBox[{"rExpr", "=", 
          RowBox[{"FirstCase", "[", 
           RowBox[{"term", ",", "_R", ",", "None", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rExpr", "===", "None"}], ",", 
           RowBox[{"{", "}"}], ",", 
           RowBox[{"Sort", "@", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"List", "@@", "rExpr"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", "#", "]"}], "=!=", "ProfileX"}], "&"}]}],
              "]"}]}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getCoeff", "[", "term_", "]"}], ":=", 
      RowBox[{"term", "/.", " ", 
       RowBox[{"_R", "->", "1"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getProfiles", "[", "term_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "rExpr", "}"}], ",", 
        RowBox[{
         RowBox[{"rExpr", "=", 
          RowBox[{"FirstCase", "[", 
           RowBox[{"term", ",", "_R", ",", "None", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rExpr", "===", "None"}], ",", 
           RowBox[{"{", "}"}], ",", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"List", "@@", "rExpr"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "#", "]"}], "===", "ProfileX"}], "&"}]}], 
            "]"}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tSig", "=", 
      RowBox[{"getSig", "[", 
       RowBox[{"tTerms", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tCoeff", "=", 
      RowBox[{"getCoeff", "[", 
       RowBox[{"tTerms", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Find", " ", "ALL", " ", "matching", " ", "terms"}], "*)"}], 
     RowBox[{"matches", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"eTerms", ",", 
        RowBox[{
