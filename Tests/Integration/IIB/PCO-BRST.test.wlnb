{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII BRST and PCO Tests\n\nHolomorphic non-spin equations A.23-A.59 under TypeII-Ashoke conventions.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "goUpDirectories[path_String, n_Integer:1] := Module[{parts}, parts = FileNameSplit[ExpandFileName[path]]; FileNameJoin[Take[parts, Length[parts] - n]]];\nnbDir = Quiet @ Check[NotebookDirectory[], $Failed];\nrepoRoot = If[nbDir === $Failed, ExpandFileName[\".\"], goUpDirectories[nbDir, 2]];\nIf[DirectoryQ[FileNameJoin[{repoRoot, \"StringCode\"}]] && !MemberQ[$Path, FileNameJoin[{repoRoot, \"StringCode\"}]], AppendTo[$Path, FileNameJoin[{repoRoot, \"StringCode\"}]]];\nNeeds[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];\nreplaceUniqueSymbols[expr_] := expr /. s_Symbol /; StringContainsQ[SymbolName[s], \"$\"] :> Symbol[StringReplace[SymbolName[s], \"$\" -> \"dol\"]];\nextractIndexSymbols[expr_] := DeleteDuplicates @ Flatten @ Join[\n  Cases[expr, dX[i_Symbol, _, _] :> i, Infinity],\n  Cases[expr, dXt[i_Symbol, _, _] :> i, Infinity],\n  Cases[expr, \\[Psi][i_Symbol, _, _] :> i, Infinity],\n  Cases[expr, \\[Psi]t[i_Symbol, _, _] :> i, Infinity],\n  Cases[expr, ProfileX[_, ders_List, _, _] :> Cases[ders, i_Symbol :> i, Infinity], Infinity],\n  Cases[expr, ProfileXHolo[_, ders_List, _] :> Cases[ders, i_Symbol :> i, Infinity], Infinity],\n  Cases[expr, ProfileXAntiHolo[_, ders_List, _] :> Cases[ders, i_Symbol :> i, Infinity], Infinity]\n];\ncanonicalizeIndices[expr_] := Module[{inds = extractIndexSymbols[expr], idxRules},\n  idxRules = Thread[inds -> Array[Symbol[\"muCanon\" <> ToString[#]] &, Length[inds]]];\n  Expand[expr /. idxRules]\n];\nnormalizeExpPhiParity[expr_] := expr /. {\n  exp\\[Phi]f[q_Integer?EvenQ, z_] :> exp\\[Phi]b[q, z],\n  exp\\[Phi]b[q_Integer?OddQ, z_] :> exp\\[Phi]f[q, z],\n  exp\\[Phi]tf[q_Integer?EvenQ, z_] :> exp\\[Phi]tb[q, z],\n  exp\\[Phi]tb[q_Integer?OddQ, z_] :> exp\\[Phi]tf[q, z]\n};\nextractDerBaseAndIndices[der[inner_][i_]] := Module[{base, ders},\n  {base, ders} = extractDerBaseAndIndices[inner];\n  {base, Append[ders, i]}\n];\nextractDerBaseAndIndices[g_] := {g, {}};\n\n(* In tests, treat leftover der factors as ProfileX derivative-list append instructions. *)\nmatchingDerivativeAppendList[derExpr : der[_][_], profile_, ders_List] := Module[{base, allDers},\n  {base, allDers} = extractDerBaseAndIndices[derExpr];\n  If[\n    Head[base] === Symbol && Head[profile] === Symbol && SymbolName[base] === SymbolName[profile],\n    If[Length[allDers] > Length[ders] && Take[allDers, Length[ders]] === ders,\n      Drop[allDers, Length[ders]],\n      {Last[allDers]}\n    ],\n    {}\n  ]\n];\n\nappendMatchingProfileDerivative[ra_, derExpr : der[_][_]] := ra /. {\n  ProfileX[h_, ders_List, z_, zb_] /; matchingDerivativeAppendList[derExpr, h, ders] =!= {} :>\n    ProfileX[h, Join[ders, matchingDerivativeAppendList[derExpr, h, ders]], z, zb],\n  ProfileXHolo[h_, ders_List, z_] /; matchingDerivativeAppendList[derExpr, h, ders] =!= {} :>\n    ProfileXHolo[h, Join[ders, matchingDerivativeAppendList[derExpr, h, ders]], z],\n  ProfileXAntiHolo[h_, ders_List, zb_] /; matchingDerivativeAppendList[derExpr, h, ders] =!= {} :>\n    ProfileXAntiHolo[h, Join[ders, matchingDerivativeAppendList[derExpr, h, ders]], zb]\n};\n\nhasMatchingProfileDerivative[ra_, derExpr : der[_][_]] := appendMatchingProfileDerivative[ra, derExpr] =!= ra;\n\n(* Fold derivative factors into the single normal-ordered product carried by a term. *)\nabsorbOneDerivativeFactor::usage = \"Absorbs one derivative factor into a matching ProfileX derivative list when possible.\";\nabsorbOneDerivativeFactor[currentR_, derExpr : der[_][_]] :=\n  If[hasMatchingProfileDerivative[currentR, derExpr], appendMatchingProfileDerivative[currentR, derExpr], currentR];\n\n(* Fold derivative factors into the single normal-ordered product carried by a term.\n   Handles both der[...] and (der[...])^n factors without relying on algebraic power expansion. *)\nabsorbDerivativesInTimesTerm::usage = \"Absorbs derivative factors in a multiplicative term into a matching ProfileX operator.\";\nabsorbDerivativesInTimesTerm[term_Times] := Module[{factors, rPos, r, others, newR, kept},\n  factors = List @@ term;\n  rPos = FirstPosition[factors, _R, Missing[\"NotFound\"]];\n  If[rPos === Missing[\"NotFound\"], Return[term]];\n  r = factors[[First[rPos]]];\n  others = Delete[factors, First[rPos]];\n  {newR, kept} = Fold[\n    Function[{state, fct},\n      Module[{curR = state[[1]], curKept = state[[2]], d, n, nextR, remaining},\n        Which[\n          MatchQ[fct, der[_][_]],\n            If[hasMatchingProfileDerivative[curR, fct],\n              {appendMatchingProfileDerivative[curR, fct], curKept},\n              {curR, Append[curKept, fct]}\n            ],\n          MatchQ[fct, Power[der[_][_], _Integer?Positive]],\n            d = fct[[1]];\n            n = fct[[2]];\n            nextR = curR;\n            remaining = n;\n            While[remaining > 0 && hasMatchingProfileDerivative[nextR, d],\n              nextR = appendMatchingProfileDerivative[nextR, d];\n              remaining--;\n            ];\n            If[remaining == 0,\n              {nextR, curKept},\n              {nextR, Append[curKept, d^remaining]}\n            ],\n          True,\n            {curR, Append[curKept, fct]}\n        ]\n      ]\n    ],\n    {r, {}},\n    others\n  ];\n  If[newR === r, term, Times @@ Join[kept, {newR}]]\n];\nabsorbDerivativesInTimesTerm[term_] := term;\n\nnormalizeProfileDerivatives::usage = \"Normalizes derivative factors into ProfileX derivative-list form for test comparisons.\";\nnormalizeProfileDerivatives[expr_] := FixedPoint[\n  Module[{terms, rewritten},\n    terms = If[Head[#] === Plus, List @@ #, {#}];\n    rewritten = absorbDerivativesInTimesTerm /@ terms;\n    Expand[Total[rewritten]]\n  ] &,\n  Expand[expr]\n];\ncanon[expr_] := Module[{e = expr},\n  e = Expand[e /. {\\[Alpha]p -> 1}];\n  e = replaceUniqueSymbols[e];\n  e = normalizeExpPhiParity[e];\n  e = normalizeProfileDerivatives[e];\n  e = canonicalizeIndices[e];\n  e = Expand[Contract[ContractDelta[e]]];\n  canonicalizeIndices[e]\n];\nassertEq[eq_, input_, action_, expected_] := Module[{got, gotCanon, expectedCanon, diffCanon, ok},\n  got = action[input];\n  gotCanon = canon[got];\n  expectedCanon = canon[expected];\n  diffCanon = canon[Expand[got - expected]];\n  ok = gotCanon === expectedCanon ||\n    ToString[InputForm[gotCanon]] === ToString[InputForm[expectedCanon]] ||\n    Simplify[diffCanon] === 0 ||\n    FullSimplify[diffCanon] === 0;\n  Print[eq, \": \", If[ok, \"PASSED\", \"FAILED\"]];\n  If[!ok,\n    Print[\"Input: \", input];\n    Print[\"Expected: \", expectedCanon];\n    Print[\"Got: \", gotCanon];\n    Print[\"CanonDiff: \", diffCanon]\n  ];\n  ok\n];\nactPCOHoloFn = Private`actPCOHolo;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## BRST Cases",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "brstCases = {\n  {\"A.23\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]], Private`actBRSTHolo,\n    1/4 R[ProfileX[f, {\\[Rho], \\[Rho]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]] -\n    1/4 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], \\[Eta][0, 0]]},\n  {\"A.24\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]], Private`actBRSTHolo,\n    1/4 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], c[1, 0], \\[Eta][0, 0]]},\n  {\"A.33\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]], Private`actBRSTHolo,\n    1/4 R[ProfileX[f, {\\[Rho], \\[Rho]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]] -\n    1/2 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]]},\n  {\"A.34\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]], Private`actBRSTHolo,\n    -1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], \\[Eta][0, 0]] +\n     1/2 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]]},\n  {\"A.35\", R[ProfileX[f, {}, 0, 0], c[0, 0], \\[Eta][0, 0]], Private`actBRSTHolo,\n    1/4 R[ProfileX[f, {\\[Rho], \\[Rho]}, 0, 0], c[0, 0], c[1, 0], \\[Eta][0, 0]]},\n  {\"A.36\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], \\[Eta][0, 0]], Private`actBRSTHolo, 0}\n};\nbrstResults = Map[assertEq[#[[1]], #[[2]], #[[3]], #[[4]]] &, brstCases];",
   "languageId": "wolfram",
