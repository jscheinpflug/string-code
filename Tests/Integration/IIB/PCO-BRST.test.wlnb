  {
   "kind": 2,
   "value": "pcoCases = {\n  {\"A.37\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]], actPCOHoloFn,\n    -1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], dX[\\[Mu], 0, 0]] -\n    1/2 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], \\[Psi][\\[Nu], 0, 0], \\[Psi][\\[Mu], 0, 0]] +\n    1/4 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], d\\[Phi][0, 0]] -\n    1/4 R[ProfileX[f, {}, 0, 0], \\[Eta][0, 0], exp\\[Phi]f[1, 0], \\[Psi][\\[Mu], 0, 0]]},\n  {\"A.38\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]], actPCOHoloFn,\n    -1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], dX[\\[Mu], 0, 0]] -\n    1/2 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], c[1, 0], \\[Psi][\\[Nu], 0, 0], \\[Psi][\\[Mu], 0, 0]] +\n    1/4 R[ProfileX[f, {\\[Mu]}, 0, 0], c[0, 0], c[1, 0], d\\[Phi][0, 0]] -\n    1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], \\[Eta][1, 0], exp\\[Phi]f[1, 0], \\[Psi][\\[Mu], 0, 0]] +\n    1/4 R[ProfileX[f, {}, 0, 0], c[1, 0], \\[Eta][0, 0], exp\\[Phi]f[1, 0], \\[Psi][\\[Mu], 0, 0]] -\n    1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], \\[Eta][0, 0], d\\[Phi][0, 0], exp\\[Phi]f[1, 0], \\[Psi][\\[Mu], 0, 0]]},\n  {\"A.46\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0]], actPCOHoloFn,\n    0},\n  {\"A.47\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], dX[\\[Mu], 0, 0]], actPCOHoloFn,\n    1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]]},\n  {\"A.48\", R[ProfileX[f, {\\[Rho]}, 0, 0], c[0, 0], exp\\[Phi]b[-3, 0], dX[\\[Rho], 0, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    -1/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.49\", R[ProfileX[f, {\\[Rho]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-3, 0], dX[\\[Rho], 0, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    -1/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.50\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 1, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    -1/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.51\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 1, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    -1/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.52\", R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][2, 0]], actPCOHoloFn, 0},\n  {\"A.53\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][2, 0]], actPCOHoloFn,\n    -R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Nu], 0, 0]]},\n  {\"A.54\", -3 R[ProfileX[f, {}, 0, 0], c[0, 0], d\\[Phi][0, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    3/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.55\", -3 R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], d\\[Phi][0, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    3/2 R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Nu], 0, 0]] +\n    3/4 R[ProfileX[f, {\\[Nu]}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.56\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[2, 0], exp\\[Phi]b[-3, 0], \\[Psi][\\[Nu], 0, 0], \\[Xi][1, 0]], actPCOHoloFn,\n    -1/2 R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Nu], 0, 0]]},\n  {\"A.57\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[3, 0], \\[Xi][2, 0], \\[Xi][1, 0], exp\\[Phi]b[-4, 0]], actPCOHoloFn,\n    6 R[ProfileX[f, {}, 0, 0], c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]},\n  {\"A.58\", R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], c[3, 0], \\[Xi][2, 0], \\[Xi][1, 0], exp\\[Phi]b[-4, 0]], actPCOHoloFn,\n    6 R[ProfileX[f, {}, 0, 0], c[0, 0], c[1, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]]}\n};\npcoResults = Map[assertEq[#[[1]], #[[2]], #[[3]], #[[4]]] &, pcoCases];",
