{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII Spin-Field Cocycle Integration Tests\n\nDeterministic associativity, graded-sign, and OPE-based Euclidean gamma-covariance checks on bosonized spin-field states.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];\n\nClearAll[\n  halfIntegerQ,\n  gsoProjectedQ,\n  rSectorQ,\n  nsSectorQ,\n  assocResidualNumericQ,\n  gradedSignCheck,\n  withShift,\n  toOp,\n  firstNonZeroIndex,\n  deterministicPairs,\n  deterministicTriples,\n  deterministicCompositeCases,\n  suiteSummary,\n  mergedPowerCoefficient,\n  stateCoefficient,\n  spinSpinToVectorMatrices,\n  pairingMatrix,\n  extractGammaMatrices,\n  sameChiralGammaMatrices,\n  sPlus,\n  sPhase,\n  sMinus,\n  mixSpinSame,\n  mixSpinPhase,\n  mixPsi1,\n  mixPsi2,\n  mixSpinPsi1,\n  mixPsiSt1,\n  mixTriPsiSpinPhase,\n  mixTriSpinAntiPsi,\n  mixNSTStPhase,\n  mixSAntiNS,\n  mixQuadNSRamond,\n  excitedSpinSPlus10,\n  excitedSpinStPlus10,\n  excitedSpinSPlus11,\n  excitedSpinStPlus11,\n  excitedSpinSPhase21,\n  excitedSpinStPlus1121,\n  excitedSpinSPlus1112,\n  excitedSpinStMinus112131,\n  excitedSpinPair1111,\n  excitedSpinPair1011Phase,\n  excitedSpinPairPhase2110,\n  excitedSpinPair112121,\n  excitedSpinPair111211,\n  excitedSpinPairMinusTriplePlusQuad\n];\n\nnumericAssocCoords = {u -> 5, ub -> 5, z -> 3, zb -> 3, w -> 1, wb -> 1};\nnumericPairCoords = {z -> 3, w -> 1};\n\nhalfIntegerQ[x_] := IntegerQ[2 x] && !IntegerQ[x];\ngsoProjectedQ[spinVec_] := IntegerQ[Total[spinVec]] && EvenQ[Total[spinVec]];\nrSectorQ[spinVec_] := And @@ (halfIntegerQ /@ spinVec);\nnsSectorQ[spinVec_] := And @@ (IntegerQ /@ spinVec);\n\nassocResidualNumericQ[a_, b_, c_] := TrueQ[\n  Simplify[((OPE[OPE[a, b], c] - OPE[a, OPE[b, c]]) /. numericAssocCoords) == 0]\n];\n\ngradedSignCheck[a_, b_, expectedSign_] := Module[{ab, ba},\n  ab = Simplify[OPE[a, b] /. numericPairCoords];\n  ba = Simplify[OPE[R[b[[1]]], R[a[[1]]]] /. numericPairCoords];\n  TrueQ[Simplify[ab/ba == expectedSign]]\n];\n\nwithShift[spin6_, compIndex_, delta_] := ReplacePart[spin6, compIndex -> spin6[[compIndex]] + delta];\ntoOp[spin6_, coord_] := R[expH[spin6, coord]];\nfirstNonZeroIndex[v_] := First @ FirstPosition[Abs[v], _?(# > 0 &)];\n\ndeterministicPairs[candsA_, candsB_, n_] := Take[\n  Flatten[\n    Table[{candsA[[i]], candsB[[j]]}, {i, 1, Min[10, Length[candsA]]}, {j, 1, Length[candsB]}],\n    1\n  ],\n  UpTo[n]\n];\n\ndeterministicTriples[pool_, n_] := Take[\n  Flatten[\n    Table[{pool[[i]], pool[[j]], pool[[k]]}, {i, 1, Min[5, Length[pool]]}, {j, 1, Min[4, Length[pool]]}, {k, 1, Length[pool]}],\n    2\n  ],\n  UpTo[n]\n];\n\ndeterministicCompositeCases[builders_List, n_Integer] := Module[{m = Length[builders], indexTriples},\n  indexTriples = Take[\n    DeleteDuplicates @ Flatten[\n      Table[\n        {\n          1 + a,\n          1 + Mod[a + b + 1, m],\n          1 + Mod[a + 2 b + 3 c + 2, m]\n        },\n        {c, 0, m - 1},\n        {b, 0, m - 1},\n        {a, 0, m - 1}\n      ],\n      2\n    ],\n    UpTo[n]\n  ];\n  Table[\n    With[{triple = indexTriples[[i]]},\n      <|\n        \"name\" -> StringRiffle[builders[[triple, \"name\"]], \" / \"],\n        \"triple\" -> {\n          builders[[triple[[1]], \"op\"]][u, ub],\n          builders[[triple[[2]], \"op\"]][z, zb],\n          builders[[triple[[3]], \"op\"]][w, wb]\n        }\n      |>\n    ],\n    {i, 1, Length[indexTriples]}\n  ]\n];\n\nsuiteSummary[name_, cases_, results_] := Association[\n  \"name\" -> name,\n  \"total\" -> Length[cases],\n  \"passed\" -> Count[results, True],\n  \"failed\" -> Count[results, False],\n  \"sampleFailures\" -> Take[Pick[cases, results, False], UpTo[3]]\n];\n\nmergedPowerCoefficient[leftCharge_List, rightCharge_List, power_] := mergedPowerCoefficient[leftCharge, rightCharge, power] =\n  Bosonize[\n    Expand[\n      Coefficient[OPE[R[expH[leftCharge, z]], R[expH[rightCharge, 0]]], z, power] /. z -> 0\n    ]\n  ];\n\nstateCoefficient[pVec_, vecCharge_, pSpin_, inSpin_, pOut_, outSpin_, zPower_] := Simplify[\n  Coefficient[\n    mergedPowerCoefficient[Join[{pVec}, vecCharge], Join[{pSpin}, inSpin], zPower],\n    R[expH[Join[{pOut}, outSpin], 0]]\n  ]\n];\n\nspinSpinToVectorMatrices[pLeft_, basisLeft_, pRight_, basisRight_, pOut_, zPower_] := Table[\n  Table[\n    Simplify[\n      Coefficient[\n        mergedPowerCoefficient[Join[{pLeft}, basisLeft[[a]]], Join[{pRight}, basisRight[[b]]], zPower],\n        R[expH[Join[{pOut}, Private`vectors[[vec]]], 0]]\n      ]\n    ],\n    {a, 1, Length[basisLeft]},\n    {b, 1, Length[basisRight]}\n  ],\n  {vec, 1, Length[Private`vectors]}\n];\n\npairingMatrix[pLeft_, basisLeft_, pRight_, basisRight_, pOut_, zPower_] := Table[\n  Simplify[\n    Coefficient[\n      mergedPowerCoefficient[Join[{pLeft}, basisLeft[[a]]], Join[{pRight}, basisRight[[b]]], zPower],\n      R[expH[Join[{pOut}, ConstantArray[0, 5]], 0]]\n    ]\n  ],\n  {a, 1, Length[basisLeft]},\n  {b, 1, Length[basisRight]}\n];\n\nextractGammaMatrices[pVec_, pSpin_, basisIn_, pOut_, basisOut_, zPower_] := Module[{rawMats},\n  rawMats = Table[\n    Table[\n      stateCoefficient[pVec, Private`vectors[[vec]], pSpin, basisIn[[a]], pOut, basisOut[[b]], zPower],\n      {a, 1, Length[basisIn]},\n      {b, 1, Length[basisOut]}\n    ],\n    {vec, 1, Length[Private`vectors]}\n  ];\n  Table[\n    Simplify[Sum[Private`basisChangeM[[mu, vec]] rawMats[[vec]], {vec, 1, Length[Private`vectors]}]],\n    {mu, 1, Length[Private`vectors]}\n  ]\n];\n\nsameChiralGammaMatrices[pLeft_, basisLeft_, pRight_, basisRight_, pOut_, zPower_] := Module[{rawMats},\n  rawMats = spinSpinToVectorMatrices[pLeft, basisLeft, pRight, basisRight, pOut, zPower];\n  Table[\n    Simplify[Sum[Inverse[Private`basisChangeM][[vec, mu]] rawMats[[vec]], {vec, 1, Length[Private`vectors]}]],\n    {mu, 1, Length[Private`vectors]}\n  ]\n];\n\nsPlus = {{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"};\nsPhase = {{1/2, 1/2, 1/2, -1/2, -1/2}, \"chiral\"};\nsMinus = {{-1/2, -1/2, -1/2, -1/2, -1/2}, \"antichiral\"};\n\nexcitedSpinSPlus10[coord_, anti_] := excitedSpinSPlus10[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, 0}}, 0, coord]]];\nexcitedSpinStPlus10[coord_, anti_] := excitedSpinStPlus10[coord, anti] = Bosonize[R[St[sPlus, -1/2, {{1, 0}}, 0, anti]]];\nexcitedSpinSPlus11[coord_, anti_] := excitedSpinSPlus11[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, -1}}, 0, coord]]];\nexcitedSpinStPlus11[coord_, anti_] := excitedSpinStPlus11[coord, anti] = Bosonize[R[St[sPlus, -1/2, {{1, -1}}, 0, anti]]];\nexcitedSpinSPhase21[coord_, anti_] := excitedSpinSPhase21[coord, anti] = Bosonize[R[S[sPhase, -1/2, {{2, -1}}, 0, coord]]];\nexcitedSpinStPlus1121[coord_, anti_] := excitedSpinStPlus1121[coord, anti] = Bosonize[R[St[sPlus, -1/2, {{1, -1}, {2, -1}}, 0, anti]]];\nexcitedSpinSPlus1112[coord_, anti_] := excitedSpinSPlus1112[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, -1}, {1, -2}}, 0, coord]]];\nexcitedSpinStMinus112131[coord_, anti_] := excitedSpinStMinus112131[coord, anti] = Bosonize[R[St[sMinus, -1/2, {{1, -1}, {2, -1}, {3, -1}}, 0, anti]]];\n\nexcitedSpinPair1111[coord_, anti_] := excitedSpinPair1111[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, -1}}, 0, coord], St[sPlus, -1/2, {{1, -1}}, 0, anti]]];\nexcitedSpinPair1011Phase[coord_, anti_] := excitedSpinPair1011Phase[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, 0}}, 0, coord], St[sPhase, -1/2, {{1, -1}}, 0, anti]]];\nexcitedSpinPairPhase2110[coord_, anti_] := excitedSpinPairPhase2110[coord, anti] = Bosonize[R[S[sPhase, -1/2, {{2, -1}}, 0, coord], St[sPlus, -1/2, {{1, 0}}, 0, anti]]];\nexcitedSpinPair112121[coord_, anti_] := excitedSpinPair112121[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, -1}, {2, -1}}, 0, coord], St[sPhase, -1/2, {{2, -1}}, 0, anti]]];\nexcitedSpinPair111211[coord_, anti_] := excitedSpinPair111211[coord, anti] = Bosonize[R[S[sPlus, -1/2, {{1, -1}, {1, -2}}, 0, coord], St[sPlus, -1/2, {{1, -1}}, 0, anti]]];\nexcitedSpinPairMinusTriplePlusQuad[coord_, anti_] := excitedSpinPairMinusTriplePlusQuad[coord, anti] = Bosonize[R[S[sMinus, -1/2, {{1, -1}, {2, -1}, {3, -1}}, 0, coord], St[sPlus, -1/2, {{1, 0}, {2, 0}, {1, -1}, {2, -1}}, 0, anti]]];\n\nmixSpinSame[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], St[sPlus, -1/2, {}, 0, anti]]];\nmixSpinPhase[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], St[sPhase, -1/2, {}, 0, anti]]];\nmixPsi1[coord_, anti_] := Bosonize[R[\\[Psi][1, 0, coord], \\[Psi]t[1, 0, anti]]];\nmixPsi2[coord_, anti_] := Bosonize[R[\\[Psi][2, 0, coord], \\[Psi]t[2, 0, anti]]];\nmixSpinPsi1[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], \\[Psi]t[1, 0, anti]]];\nmixPsiSt1[coord_, anti_] := Bosonize[R[\\[Psi][1, 0, coord], St[sPlus, -1/2, {}, 0, anti]]];\nmixTriPsiSpinPhase[coord_, anti_] := Bosonize[R[\\[Psi][1, 0, coord], S[sPlus, -1/2, {}, 0, coord], St[sPhase, -1/2, {}, 0, anti]]];\nmixTriSpinAntiPsi[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], St[sPlus, -1/2, {}, 0, anti], \\[Psi]t[1, 0, anti]]];\nmixNSTStPhase[coord_, anti_] := Bosonize[R[exp\\[Phi]f[-1, coord], \\[Psi][1, 0, coord], St[sPhase, -1/2, {}, 0, anti]]];\nmixSAntiNS[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], exp\\[Phi]tf[-1, anti], \\[Psi]t[1, 0, anti]]];\nmixQuadNSRamond[coord_, anti_] := Bosonize[R[exp\\[Phi]f[-1, coord], \\[Psi][2, 0, coord], S[sPlus, -1/2, {}, 0, coord], St[sPhase, -1/2, {}, 0, anti]]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Core Suites",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "rBaseSpin6 = Join[\n  Table[Join[{-1/2}, Private`chiralspins[[i]]], {i, 1, Length[Private`chiralspins]}],\n  Table[Join[{-1/2}, Private`antichiralspins[[i]]], {i, 1, Length[Private`antichiralspins]}]\n];\n\nrExcitedSpin6 = DeleteDuplicates @ Join[\n  Table[withShift[rBaseSpin6[[i]], 2 + Mod[i - 1, 5], 1], {i, 1, Min[20, Length[rBaseSpin6]]}],\n  Table[withShift[rBaseSpin6[[i]], 2 + Mod[i, 5], 2], {i, 1, Min[10, Length[rBaseSpin6]]}],\n  Table[withShift[rBaseSpin6[[i]], 2 + Mod[i + 1, 5], -1], {i, 1, Min[20, Length[rBaseSpin6]]}],\n  Table[ReplacePart[rBaseSpin6[[i]], 1 -> -3/2], {i, 1, Min[12, Length[rBaseSpin6]]}],\n  Table[ReplacePart[rBaseSpin6[[i]], 1 -> 1/2], {i, 1, Min[12, Length[rBaseSpin6]]}]\n];\n\nnsBaseSpin6 = Table[Join[{-1}, Private`vectors[[i]]], {i, 1, Length[Private`vectors]}];\n\nnsExcitedSpin6 = DeleteDuplicates @ Join[\n  Table[\n    Module[{idx = firstNonZeroIndex[Private`vectors[[i]]]},\n      withShift[Join[{-1}, Private`vectors[[i]]], idx + 1, 2 Sign[Private`vectors[[i, idx]]]]\n    ],\n    {i, 1, Length[Private`vectors]}\n  ],\n  Table[\n    Module[{idx = firstNonZeroIndex[Private`vectors[[i]]]},\n      withShift[Join[{1}, Private`vectors[[i]]], idx + 1, 2 Sign[Private`vectors[[i, idx]]]]\n    ],\n    {i, 1, Length[Private`vectors]}\n  ],\n  Table[Join[{1}, Private`vectors[[i]]], {i, 1, Length[Private`vectors]}]\n];\n\nrCandidates = Select[DeleteDuplicates @ Join[rBaseSpin6, rExcitedSpin6], rSectorQ[#] && gsoProjectedQ[#] &];\nnsCandidates = Select[DeleteDuplicates @ Join[nsBaseSpin6, nsExcitedSpin6], nsSectorQ[#] && gsoProjectedQ[#] &];\nassocStatePool = Sort @ DeleteDuplicates @ Join[\n  Take[rCandidates, UpTo[20]],\n  Take[nsCandidates, UpTo[20]],\n  Take[Select[rCandidates, Max[Abs[Rest[#]]] > 1/2 &], UpTo[10]],\n  Take[Select[nsCandidates, Max[Abs[Rest[#]]] > 1/2 &], UpTo[10]]\n];\n\nassocTriples = deterministicTriples[assocStatePool, 60];\nrPairs = deterministicPairs[rCandidates, rCandidates, 60];\nnsPairs = deterministicPairs[nsCandidates, nsCandidates, 60];\nmixedPairs = deterministicPairs[rCandidates, nsCandidates, 60];\n\ncaseCountCheck = Length[assocTriples] == 60 && Length[rPairs] == 60 && Length[nsPairs] == 60 && Length[mixedPairs] == 60;\n\nassocResults = assocResidualNumericQ[toOp[#[[1]], u], toOp[#[[2]], z], toOp[#[[3]], w]] & /@ assocTriples;\nrResults = gradedSignCheck[toOp[#[[1]], z], toOp[#[[2]], w], -1] & /@ rPairs;\nnsResults = gradedSignCheck[toOp[#[[1]], z], toOp[#[[2]], w], 1] & /@ nsPairs;\nmixedResults = gradedSignCheck[toOp[#[[1]], z], toOp[#[[2]], w], 1] & /@ mixedPairs;\n\ncoreSuites = {\n  suiteSummary[\"Associativity\", assocTriples, assocResults],\n  suiteSummary[\"R/R graded sign\", rPairs, rResults],\n  suiteSummary[\"NS/NS graded sign\", nsPairs, nsResults],\n  suiteSummary[\"R/NS graded sign\", mixedPairs, mixedResults]\n};\n\ncoreCaseResults = Join[assocResults, rResults, nsResults, mixedResults];\ncoreCaseCount = Length[coreCaseResults];\ncoreTestsPass = caseCountCheck && coreCaseCount == 240 && AllTrue[coreCaseResults, TrueQ];\n\nPrint[<|\"caseCountCheck\" -> caseCountCheck, \"coreCaseCount\" -> coreCaseCount|>];\nPrint /@ coreSuites;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Excited Spin Associativity",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "excitedSpinFieldBuilders = {\n  <|\"name\" -> \"S+ {1,0}\", \"op\" -> excitedSpinSPlus10|>,\n  <|\"name\" -> \"St+ {1,0}\", \"op\" -> excitedSpinStPlus10|>,\n  <|\"name\" -> \"S+ {1,-1}\", \"op\" -> excitedSpinSPlus11|>,\n  <|\"name\" -> \"St+ {1,-1}\", \"op\" -> excitedSpinStPlus11|>,\n  <|\"name\" -> \"Sphase {2,-1}\", \"op\" -> excitedSpinSPhase21|>,\n  <|\"name\" -> \"St+ {1,-1}{2,-1}\", \"op\" -> excitedSpinStPlus1121|>,\n  <|\"name\" -> \"S+ {1,-1}{1,-2}\", \"op\" -> excitedSpinSPlus1112|>,\n  <|\"name\" -> \"St- {1,-1}{2,-1}{3,-1}\", \"op\" -> excitedSpinStMinus112131|>\n};\n\nexcitedSpinAssocCases = deterministicCompositeCases[excitedSpinFieldBuilders, 12];\nexcitedSpinAssocResults = assocResidualNumericQ @@@ (excitedSpinAssocCases[[All, \"triple\"]]);\nexcitedSpinAssocSuite = suiteSummary[\"Excited spin associativity\", excitedSpinAssocCases[[All, \"name\"]], excitedSpinAssocResults];\nexcitedSpinAssocTestsPass = Length[excitedSpinAssocCases] == 12 && AllTrue[excitedSpinAssocResults, TrueQ];\n\nPrint[excitedSpinAssocSuite];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Excited Composite Associativity",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "excitedSpinCompositeBuilders = {\n  <|\"name\" -> \"S+{1,-1}-St+{1,-1}\", \"op\" -> excitedSpinPair1111|>,\n  <|\"name\" -> \"S+{1,0}-Stphase{1,-1}\", \"op\" -> excitedSpinPair1011Phase|>,\n  <|\"name\" -> \"Sphase{2,-1}-St+{1,0}\", \"op\" -> excitedSpinPairPhase2110|>\n};\n\nexcitedCompositeAssocCases = deterministicCompositeCases[excitedSpinCompositeBuilders, 3];\nexcitedCompositeAssocResults = assocResidualNumericQ @@@ (excitedCompositeAssocCases[[All, \"triple\"]]);\nexcitedCompositeAssocSuite = suiteSummary[\"Excited composite associativity\", excitedCompositeAssocCases[[All, \"name\"]], excitedCompositeAssocResults];\nexcitedCompositeAssocTestsPass = Length[excitedCompositeAssocCases] == 3 && AllTrue[excitedCompositeAssocResults, TrueQ];\n\nPrint[excitedCompositeAssocSuite];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Composite Associativity",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "compositeOpBuilders = {\n  <|\"name\" -> \"S-St same\", \"op\" -> mixSpinSame|>,\n  <|\"name\" -> \"S-St phase\", \"op\" -> mixSpinPhase|>,\n  <|\"name\" -> \"psi1-psit1\", \"op\" -> mixPsi1|>,\n  <|\"name\" -> \"psi2-psit2\", \"op\" -> mixPsi2|>,\n  <|\"name\" -> \"S-psit1\", \"op\" -> mixSpinPsi1|>,\n  <|\"name\" -> \"psi1-St\", \"op\" -> mixPsiSt1|>,\n  <|\"name\" -> \"psi1-S-Stphase\", \"op\" -> mixTriPsiSpinPhase|>,\n  <|\"name\" -> \"S-St-psit1\", \"op\" -> mixTriSpinAntiPsi|>,\n  <|\"name\" -> \"e^-phi-psi1-Stphase\", \"op\" -> mixNSTStPhase|>,\n  <|\"name\" -> \"S-e^-phit-psit1\", \"op\" -> mixSAntiNS|>,\n  <|\"name\" -> \"e^-phi-psi2-S-Stphase\", \"op\" -> mixQuadNSRamond|>\n};\n\ncompositeAssocCases = deterministicCompositeCases[compositeOpBuilders, 60];\ncompositeAssocResults = assocResidualNumericQ @@@ (compositeAssocCases[[All, \"triple\"]]);\ncompositeAssocSuite = suiteSummary[\"Composite associativity\", compositeAssocCases[[All, \"name\"]], compositeAssocResults];\ncompositeAssocTestsPass = Length[compositeAssocCases] == 60 && AllTrue[compositeAssocResults, TrueQ];\n\nPrint[compositeAssocSuite];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Euclidean Gamma Covariance",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "pairingSA = pairingMatrix[-1/2, Private`chiralspins, -3/2, Private`antichiralspins, -2, -2];\npairingAS = pairingMatrix[-3/2, Private`antichiralspins, -1/2, Private`chiralspins, -2, -2];\nsameChiralU = sameChiralGammaMatrices[-1/2, Private`chiralspins, -1/2, Private`chiralspins, -1, -1];\nsameChiralD = sameChiralGammaMatrices[-3/2, Private`antichiralspins, -3/2, Private`antichiralspins, -3, -3];\nmixedUDMinus = extractGammaMatrices[-1, -1/2, Private`chiralspins, -3/2, Private`antichiralspins, -1];\nmixedUDPlus = extractGammaMatrices[1, -1/2, Private`chiralspins, 1/2, Private`antichiralspins, 0];\nmixedDUMinus = extractGammaMatrices[-1, 1/2, Private`antichiralspins, -1/2, Private`chiralspins, 0];\nmixedDUPlus = extractGammaMatrices[1, -3/2, Private`antichiralspins, -1/2, Private`chiralspins, 1];\n\ngammaPairingCheck1 = TrueQ[Simplify[pairingSA == CUD]];\ngammaPairingCheck2 = TrueQ[Simplify[pairingAS == CDU]];\ngammaSameCheck1 = And @@ Table[TrueQ[Simplify[sameChiralU[[mu]] == CGamma[mu]/Sqrt[2]]], {mu, 1, 10}];\ngammaSameCheck2 = And @@ Table[TrueQ[Simplify[sameChiralD[[mu]] == CIGamma[mu]/Sqrt[2]]], {mu, 1, 10}];\ngammaMixedCheck1 = And @@ Table[TrueQ[Simplify[mixedUDMinus[[mu]] == GammaUD[mu]/Sqrt[2]]], {mu, 1, 10}];\ngammaMixedCheck2 = And @@ Table[TrueQ[Simplify[mixedUDPlus[[mu]] == (-I/Sqrt[2]) GammaUD[mu]]], {mu, 1, 10}];\ngammaMixedCheck3 = And @@ Table[TrueQ[Simplify[mixedDUMinus[[mu]] == (I/Sqrt[2]) GammaDU[mu]]], {mu, 1, 10}];\ngammaMixedCheck4 = And @@ Table[TrueQ[Simplify[mixedDUPlus[[mu]] == GammaDU[mu]/Sqrt[2]]], {mu, 1, 10}];\n\nallGammaChecksPassed = And @@ {\n  gammaPairingCheck1,\n  gammaPairingCheck2,\n  gammaSameCheck1,\n  gammaSameCheck2,\n  gammaMixedCheck1,\n  gammaMixedCheck2,\n  gammaMixedCheck3,\n  gammaMixedCheck4\n};\n\ngammaSummary = {\n  Association[\"check\" -> \"S[-1/2] with S[-1/2]\", \"allMuPass\" -> gammaSameCheck1, \"coefficient\" -> 1/Sqrt[2]],\n  Association[\"check\" -> \"Sbar[-3/2] with Sbar[-3/2]\", \"allMuPass\" -> gammaSameCheck2, \"coefficient\" -> 1/Sqrt[2]],\n  Association[\"check\" -> \"S[-1/2] with Sbar[-3/2] pairing\", \"allMuPass\" -> gammaPairingCheck1, \"coefficient\" -> None],\n  Association[\"check\" -> \"Sbar[-3/2] with S[-1/2] pairing\", \"allMuPass\" -> gammaPairingCheck2, \"coefficient\" -> None],\n  Association[\"check\" -> \"e^{-phi} psi with S[picture=-1/2]\", \"allMuPass\" -> gammaMixedCheck1, \"coefficient\" -> 1/Sqrt[2]],\n  Association[\"check\" -> \"e^{phi} psi with S[picture=-1/2]\", \"allMuPass\" -> gammaMixedCheck2, \"coefficient\" -> -I/Sqrt[2]],\n  Association[\"check\" -> \"e^{-phi} psi with Sbar[picture=1/2]\", \"allMuPass\" -> gammaMixedCheck3, \"coefficient\" -> I/Sqrt[2]],\n  Association[\"check\" -> \"e^{phi} psi with Sbar[picture=-3/2]\", \"allMuPass\" -> gammaMixedCheck4, \"coefficient\" -> 1/Sqrt[2]]\n};\n\nPrint /@ gammaSummary;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Summary",
   "languageId": "markdown",
   "outputs": [],
