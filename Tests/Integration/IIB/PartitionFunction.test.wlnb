{
 "cells": [
  {
   "kind": 1,
   "value": "# IIB Partition Function Integration Tests\n\nPartition-function-based counting checks for TypeII FlatSpace basis generation (moved from FlatSpace basis tests).",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
