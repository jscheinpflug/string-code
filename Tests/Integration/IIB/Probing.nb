Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "The", " ", "issue", " ", "is", " ", "that", " ", "our", " ", "contour", 
    " ", "prescription", " ", "does", " ", "not", " ", "manifest", " ", "the",
     " ", "antisymmetry", " ", "when", " ", "there", " ", "are", " ", 
    "multiple", " ", "modes", " ", 
    RowBox[{"present", "!"}], " ", "The", " ", "current", " ", "code", " ", 
    "just", " ", "swaps", " ", "modes", " ", "into", " ", "some", " ", 
    "canonical", " ", "order"}], ",", " ", 
   RowBox[{
   "but", " ", "that", " ", "only", " ", "works", " ", "if", " ", "the", " ", 
    "contour", " ", "prescription", " ", "is", " ", "indeed", " ", 
    "antisymmetric", " ", "for", " ", "multiple", " ", 
    RowBox[{"modes", "!"}]}]}], "*)"}]], "Input",
