  {
   "kind": 2,
   "value": "(*** testing \\[Beta] \\[Gamma] OPE ***)\nTaylor[(OPE[\\[Beta]ghost[z],\\[Gamma]ghost[w]]//Expand)/.w->0,0,0,1]//Expand\nTaylor[(OPE[\\[Gamma]ghost[z],\\[Beta]ghost[w]]//Expand)/.w->0,0,0,1]//Expand",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*** checking BRST transformation of b and \\[Beta] ghosts ***)\nPolar[Taylor[OPE[jBRST[z],R[b[0,w]]]/.w->0//Expand,0,0,2],z,0]-1/z Ttotal[0]//Expand//replaceUniqueSymbols\nPolar[Taylor[OPE[jBRST[z],R[\\[Beta]ghost[w]]]/.w->0//Expand,0,0,2],z,0]- 1/z (-1/2  Gtotal[0])//Expand//replaceUniqueSymbols",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*** checking PCO ***)\nPolar[Taylor[(OPE[jBRST[z],R[\\[Xi][0,w]]]//Expand)/.w->0,0,0,2],z,0]-1/z PCO[0]//Expand//replaceUniqueSymbols",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*** checking BRST current is weight 1 primary ***)\npol1=Polar[Taylor[(OPE[Ttotal[z],jBRST[w]]//Expand//Contract)/.w->0,0,0,2],z,0];\npol2=Polar[Taylor[jBRST[z]/z^2,0,0,2],z,0];\n(pol1- pol2//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1}//Expand",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*** checking nilpotency of BRST charge ***)\npoltest=Polar[Taylor[(OPE[jBRST[z],jBRST[w]]//Expand//Contract)/.w->0,0,0,3],z,0]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "poltotalderiv=Polar[Taylor[-(1)/(8 z^2)2 \\[ImaginaryI] Sqrt[2] R[c[0,z],dX[\\[Mu],0,z],exp\\[Phi]f[1,z],\\[Eta][0,z],\\[Psi][\\[Mu],0,z]]-(R[b[0,z],c[0,z],exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][1,z]])/(4 z^2)+(-R[exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][2,z]])/(8 z^2)+(-3 R[d\\[Phi][0,z],exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][1,z]])/(8 z^2),0,0,2],z,0];\n((poltest-  poltotalderiv//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1})+O[z]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*** checking T T OPE ***)\n(Polar[Taylor[((OPE[Ttotal[z],Ttotal[w]]//Simplify//Contract)/.w->0)-(1/z^2 Ttotal[0]+1/z^2 Ttotal[z]),0,0,2],z,0]//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1}//Expand",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "tripgrav=OPE[Graviton[\\[Mu]1,\\[Nu]1,k1,z1,z1bar],Graviton[\\[Mu]2,\\[Nu]2,k2,z2,z2bar],RaisedGraviton[\\[Mu]3,\\[Nu]3,k3,z3,z3bar]];",
   "languageId": "wolfram",
   "outputs": [],
