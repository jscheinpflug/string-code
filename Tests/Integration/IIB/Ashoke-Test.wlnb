{
  "cells": [
    {
      "kind": 1,
      "value": "# Init",
      "languageId": "markdown"
    },
    {
      "kind": 2,
      "value": "Needs[\"StringCode`\"];\nInitStringCode[<|\"theory\" -> \"TypeII\",\"CFT\"->\"FlatSpace\", \"conventions\"-> \"TypeII-Ashoke\", \"bracket\"->\"Flat\"|>];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Quit[]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(Timing[BracketProjected[  SF[R[c[0,0], ct[0,0],  exp\\[Phi]f[-1,0],\\[Psi][\\[Mu]1,0,0], exp\\[Phi]tf[-1,0], \\[Psi]t[\\[Nu]1,0,0],expX[k1,0,0]]], SF[R[c[0,0], ct[0,0],  exp\\[Phi]f[-1,0],\\[Psi][\\[Mu]2,0,0], exp\\[Phi]tf[-1,0], \\[Psi]t[\\[Nu]2,0,0],expX[k2,0,0]]],0,0]]/.{Private`z[2,1][{}]->-z0, Private`z[2,2][{}]->z0,Private`zbar[2,1][{}]->-z0bar, Private`zbar[2,2][{}]->z0bar, dot[x___]->0})//Expand//ContractDelta//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Private`generateBasisHolo[0, {-1,-1},{1,1},{-1,0}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Private`generateBasisHolo[0, {-2,-2},{1,1},{-4,0}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Private`gradeBasisUpToWeightHolo[Private`generateNegativeModesHoloUpToWeight[2]]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[R[expX[k1,0,0],expX[k,0,0],dX[\\[Mu],0,0],dX[\\[Nu],0,0],exp\\[Phi]f[-1,0],dX[\\[Rho],0,0],dX[\\[Lambda],0,0],c[0,0],b[0,0],c[1,0],exp\\[Phi]f[-1,0],b[1,0]]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Private`symbolListToR[{ expX[k1,0,0],expX[k,0,0],dX[\\[Mu],0,0],dX[\\[Nu],0,0],exp\\[Phi]f[-1,0],dX[\\[Rho],0,0],dX[\\[Lambda],0,0],c[0,0],b[0,0],c[1,0],exp\\[Phi]f[-1,0],b[1,0]}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[R @@ Sort[{c[0,0], c[1,0],expXHolo[k1,0],expXHolo[k2,0],d\\[Phi][0,0] }]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Private`symbolListToR[{c[0,0], c[1,0],expXHolo[k1,0],expXHolo[k2,0],d\\[Phi][0,0] }]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[R @@ {c[0,0], c[1,0] ,expXHolo[k1,0],expXHolo[k2,0],d\\[Phi][0,0]  }]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Quit[]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "ClearAll[ReplaceDummyIndices];\nReplaceDummyIndices[expr_]:=Module[{dummies,replacements},(*Find all dummy index symbols like \\[Mu]$1234*)dummies=DeleteDuplicates@Cases[expr,s_Symbol/;StringMatchQ[SymbolName[s],___~~\"$\"~~NumberString],{0,Infinity}];\n(*Replace each dummy with base name plus running number:\\[Mu]$1234->\\[Mu]1*)replacements=Thread[dummies->MapIndexed[With[{base=StringReplace[SymbolName[#1],\"$\"~~__->\"\"]},ToExpression[base<>ToString[#2[[1]]]]]&,dummies]];\nexpr/. replacements];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(Timing[BracketProjected[ lambda1[\\[Mu]],lambdabar2[\\[Nu]],0,0]]/.{Private`z1[]->-z0, Private`z2[]->z0,Private`zbar1[]->-z0bar, Private`zbar2[]->z0bar, dot[x___]->0})//Expand//ContractDelta//ReplaceDummyIndices//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(Timing[BracketProjected[ lambda1[\\[Mu]],lambda2[\\[Nu]],0,0]]/.{Private`z1[]->-z0, Private`z2[]->z0,Private`zbar1[]->-z0bar, Private`zbar2[]->z0bar, dot[x___]->0})//Expand//ContractDelta//ReplaceDummyIndices//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "lambda1[\\[Mu]_]:= SF[c[0],ct[0], \\[Psi][\\[Mu],0],\\[Xi]t[1], exp\\[Phi]f[-1], exp\\[Phi]tb[-2],ProfileX[\\[Lambda]1[\\[Mu]],{}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "lambda2[\\[Mu]_]:= SF[c[0],ct[0], \\[Psi][\\[Mu],0],\\[Xi]t[1], exp\\[Phi]f[-1], exp\\[Phi]tb[-2],ProfileX[\\[Lambda]2[\\[Mu]],{}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "lambdabar1[\\[Mu]_]:=SF[c[0],ct[0],\\[Xi][1], \\[Psi]t[\\[Mu],0], exp\\[Phi]b[-2], exp\\[Phi]tf[-1], ProfileX[\\[Lambda]bar1[\\[Mu]],{}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "lambdabar2[\\[Mu]_]:=SF[c[0],ct[0],\\[Xi][1], \\[Psi]t[\\[Mu],0], exp\\[Phi]b[-2], exp\\[Phi]tf[-1], ProfileX[\\[Lambda]bar2[\\[Mu]],{}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[(Plus @@ Map[ReplaceDummyIndices,(Bracket[lambda1[\\[Mu]],lambdabar2[\\[Nu]]]//Expand//ContractDelta)/.{Plus->List}] )]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[(Plus @@ Map[ReplaceDummyIndices,(Bracket[lambda1[\\[Mu]],lambda2[\\[Nu]],1/2]//Expand//ContractDelta)/.{Plus->List}] )]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Plus @@ Map[ReplaceDummyIndices,(Bracket[SF[c[0], ct[0], exp\\[Phi]f[-1], exp\\[Phi]tf[-1],\\[Psi][\\[Mu],0], \\[Psi]t[\\[Nu],0], ProfileX[h1[\\[Mu], \\[Nu]], {}]], SF[c[0], ct[0], exp\\[Phi]f[-1], exp\\[Phi]tf[-1],\\[Psi][\\[Rho],0], \\[Psi]t[\\[Sigma],0], ProfileX[h2[\\[Rho],\\[Sigma]],{}]],3]//Expand//ContractDelta)/.{Plus->List}]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(actBRST[SF[c[0], ct[0],  exp\\[Phi]f[-1],\\[Psi][\\[Mu],0], exp\\[Phi]tb[-2], \\[Xi]t[1], ProfileX[V[\\[Mu]],{}]] + SF[c[0], ct[0],   exp\\[Phi]b[-2], \\[Xi][1], exp\\[Phi]tf[-1],\\[Psi]t[\\[Mu],0], ProfileX[V[\\[Mu]],{}]]]//ContractDelta)/.{\\[Alpha]p->1}",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "metric = 4 SF[c[0], ct[0],  exp\\[Phi]f[-1],\\[Psi][\\[Mu],0], exp\\[Phi]tf[-1], \\[Psi]t[\\[Nu],0], ProfileX[h[\\[Mu], \\[Nu]],{}]];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "ghostD = SF[c[0], ct[0],  \\[Eta][0], exp\\[Phi]tb[-2],\\[Xi]t[1], ProfileX[\\[Phi],{}]]-SF[c[0], ct[0],  exp\\[Phi]b[-2],\\[Xi][1], \\[Eta]t[0], ProfileX[\\[Phi],{}]];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "auxField = 1/2(SF[c[1],c[0],ct[0], exp\\[Phi]f[-1], \\[Psi][\\[Mu],0], exp\\[Phi]tb[-2] ,\\[Xi]t[1], ProfileX[A[\\[Mu]],{}]] + SF[c[1],c[0], ct[0], exp\\[Phi]b[-2], \\[Xi][1], exp\\[Phi]tf[-1], \\[Psi]t[\\[Mu],0], ProfileX[A[\\[Mu]],{}]] + SF[ct[1],c[0],ct[0], exp\\[Phi]f[-1], \\[Psi][\\[Mu],0], exp\\[Phi]tb[-2] ,\\[Xi]t[1], ProfileX[A[\\[Mu]],{}]] + SF[ct[1],c[0], ct[0], exp\\[Phi]b[-2], \\[Xi][1], exp\\[Phi]tf[-1], \\[Psi]t[\\[Mu],0], ProfileX[A[\\[Mu]],{}]]);",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[actBRST[metric]//Expand//ContractDelta]/.{\\[Alpha]p->1}",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[actBRST[ghostD]//Expand//ContractDelta]/.{\\[Alpha]p->1}",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[(actBRST[auxField]//Expand//ContractDelta)/.{\\[Alpha]p->1}]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[Bracket[SF[c[0],ct[0],exp\\[Phi]f[-1],\\[Psi][\\[Rho],0],exp\\[Phi]tb[-2],\\[Xi]t[1]],SF[expX[p],c[0],ct[0],exp\\[Phi]f[-1],\\[Psi][\\[Mu],0],dX[\\[Mu],0],exp\\[Phi]tf[-1],\\[Psi]t[\\[Nu],0],dXt[\\[Nu],0]]]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "actBRST[SF[c[1],c[0], ct[0], exp\\[Phi]f[-1],\\[Psi][\\[Mu],0], exp\\[Phi]tb[-2], \\[Xi]t[1]]]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Timing[1/2(actBRST[SF[c[1],c[0], ct[0], exp\\[Phi]f[-1],\\[Psi][\\[Mu],0], exp\\[Phi]tb[-2], \\[Xi]t[1]]]+ actBRST[SF[ct[1],c[0], ct[0], exp\\[Phi]f[-1],\\[Psi][\\[Mu],0], exp\\[Phi]tb[-2], \\[Xi]t[1]]] + actBRST[SF[c[1],c[0], ct[0], exp\\[Phi]b[-2], \\[Xi][1], exp\\[Phi]tf[-1],\\[Psi]t[\\[Mu],0]]] + actBRST[SF[ct[1],c[0], ct[0], exp\\[Phi]b[-2], \\[Xi][1], exp\\[Phi]tf[-1],\\[Psi]t[\\[Mu],0]]])//Expand//ContractDelta]",
      "languageId": "wolfram"
    },
    {
      "kind": 1,
      "value": "# Testing",
      "languageId": "markdown"
    },
    {
      "kind": 2,
      "value": "Gmatter[z]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** testing \\[Beta] \\[Gamma] OPE ***)\nTaylor[(OPE[\\[Beta]ghost[z],\\[Gamma]ghost[w]]//Expand)/.w->0,0,0,1]//Expand\nTaylor[(OPE[\\[Gamma]ghost[z],\\[Beta]ghost[w]]//Expand)/.w->0,0,0,1]//Expand",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** checking BRST transformation of b and \\[Beta] ghosts ***)\nPolar[Taylor[OPE[jBRST[z],R[b[0,w]]]/.w->0//Expand,0,0,2],z,0]-1/z Ttotal[0]//Expand//replaceUniqueSymbols\nPolar[Taylor[OPE[jBRST[z],R[\\[Beta]ghost[w]]]/.w->0//Expand,0,0,2],z,0]- 1/z (-1/2  Gtotal[0])//Expand//replaceUniqueSymbols",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** checking PCO ***)\nPolar[Taylor[(OPE[jBRST[z],R[\\[Xi][0,w]]]//Expand)/.w->0,0,0,2],z,0]-1/z PCO[0]//Expand//replaceUniqueSymbols",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** checking BRST current is weight 1 primary ***)\npol1=Polar[Taylor[(OPE[Ttotal[z],jBRST[w]]//Expand//Contract)/.w->0,0,0,2],z,0];\npol2=Polar[Taylor[jBRST[z]/z^2,0,0,2],z,0];\n(pol1- pol2//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1}//Expand",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** checking nilpotency of BRST charge ***)\npoltest=Polar[Taylor[(OPE[jBRST[z],jBRST[w]]//Expand//Contract)/.w->0,0,0,3],z,0]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "poltotalderiv=Polar[Taylor[-(1)/(8 z^2)2 \\[ImaginaryI] Sqrt[2] R[c[0,z],dX[\\[Mu],0,z],exp\\[Phi]f[1,z],\\[Eta][0,z],\\[Psi][\\[Mu],0,z]]-(R[b[0,z],c[0,z],exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][1,z]])/(4 z^2)+(-R[exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][2,z]])/(8 z^2)+(-3 R[d\\[Phi][0,z],exp\\[Phi]b[2,z],\\[Eta][0,z],\\[Eta][1,z]])/(8 z^2),0,0,2],z,0];\n((poltest-  poltotalderiv//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1})+O[z]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(*** checking T T OPE ***)\n(Polar[Taylor[((OPE[Ttotal[z],Ttotal[w]]//Simplify//Contract)/.w->0)-(1/z^2 Ttotal[0]+1/z^2 Ttotal[z]),0,0,2],z,0]//replaceUniqueSymbols)/.{\\[Delta][\\[Mu],\\[Mu]]->1}//Expand",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "tripgrav=OPE[Graviton[\\[Mu]1,\\[Nu]1,k1,z1,z1bar],Graviton[\\[Mu]2,\\[Nu]2,k2,z2,z2bar],RaisedGraviton[\\[Mu]3,\\[Nu]3,k3,z3,z3bar]];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Graviton[\\[Mu]_,\\[Nu]_,k_,z_,zbar_]:=R[c[0,z],ct[0,zbar],exp\\[Phi]f[-1,z],\\[Psi][\\[Mu],0,z],exp\\[Phi]tf[-1,zbar],\\[Psi]t[\\[Nu],0,zbar],expX[k,z,zbar]]\n\nPictureRaiseL[vert_,z1_,z1bar_]:=Block[{w,x},SeriesCoefficient[(Taylor[OPE[PCO[w],vert]//ContractDelta,z1,z1bar,0]/.w->z1+x)+O[x],0]]\nPictureRaiseR[vert_,z1_,z1bar_]:=Block[{w,x},SeriesCoefficient[(Taylor[OPE[PCObar[w],vert]//ContractDelta,z1,z1bar,0]/.w->z1bar+x)+O[x],0]]\nPictureRaiseLR[vert_,z1_,z1bar_]:=PictureRaiseR[PictureRaiseL[vert,z1,z1bar],z1,z1bar]",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "RaisedGraviton[\\[Mu]1_,\\[Nu]1_,k1_,z1_,z1bar_]:=PictureRaiseLR[Graviton[\\[Mu]1,\\[Nu]1,k1,z1,z1bar],z1,z1bar]//Expand\n\ntripgrav=OPE[Graviton[\\[Mu]1,\\[Nu]1,k1,z1,z1bar],Graviton[\\[Mu]2,\\[Nu]2,k2,z2,z2bar],RaisedGraviton[\\[Mu]3,\\[Nu]3,k3,z3,z3bar]];\n\n(*** graviton 3-point amplitude ***)tripgravamp=Vev[tripgrav/.{z1->x,z1bar->x,z2->1,z2bar->1,z3->0,z3bar->0}/.{dot[k1,k2]->0,dot[k1,k3]->0,dot[k2,k3]->0}]//Simplify//Expand//ContractDelta//Simplify\n\n(e1[\\[Mu]1] e1[\\[Nu]1] e2[\\[Mu]2] e2[\\[Nu]2] e3[\\[Mu]3] e3[\\[Nu]3] tripgravamp//Expand//ContractDelta)//.{(f1_[\\[Mu]_] f2_[\\[Mu]_]):>dot[f1,f2]}/.{dot[e3,k2]->-dot[e3,k1]}//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "SimpleRaisedGraviton[\\[Mu]_,\\[Nu]_,k_,z_,zbar_]:=(RaisedGraviton[\\[Mu],\\[Nu],k,z,zbar]/.{\\[Eta][a__]:>0,\\[Eta]t[a__]:>0})\nIntegratedSimpleRaisedGraviton[\\[Mu]_,\\[Nu]_,k_,z_,zbar_]:=Block[{w},(w-z) (w-zbar) OPE[R[bt[0,w],b[0,w]],SimpleRaisedGraviton[\\[Mu],\\[Nu],k,z,zbar]]/.{b[a__]:>0,bt[a__]:>0}//Simplify//Expand]\nFourGravCorr=Corr[OPE[Graviton[\\[Mu]1,\\[Nu]1,k1,z1,z1bar],Graviton[\\[Mu]2,\\[Nu]2,k2,z2,z2bar]],\nOPE[SimpleRaisedGraviton[\\[Mu]3,\\[Nu]3,k3,z3,z3bar],IntegratedSimpleRaisedGraviton[\\[Mu]4,\\[Nu]4,k4,z4,z4bar]]];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "FourGravCorr",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "VevFourGravCorr=Vev[FourGravCorr/.{z3->1/x,z3bar->1/x,z1->1,z1bar->1,z2->0,z2bar->0}/.{dot[k1,k4]->dot[k2,k3],dot[k2,k4]->dot[k1,k3],dot[k3,k4]->dot[k1,k2]}]//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "Prefactor=(-(1)/(x))^dot[k2,k3] ((-1+x)/(x))^dot[k1,k3] (1-z4)^-1+(1)/(2) dot[k2,k3] ((1)/(x)-z4)^(1)/(2) dot[k1,k2] (-z4)^-1+(1)/(2) dot[k1,k3] (1-z4bar)^-1+(1)/(2) dot[k2,k3] ((1)/(x)-z4bar)^(1)/(2) dot[k1,k2] (-z4bar)^-1+(1)/(2) dot[k1,k3]/(256 x^2 (-1+x z4)^2 (-1+x z4bar)^2) CR[c[0,0],c[1,0],c[2,0],ct[0,0],ct[1,0],ct[2,0],expX[k1,0,0],expX[k2,0,0],expX[k3,0,0],expX[k4,0,0],exp\\[Phi]b[-2,0],exp\\[Phi]tb[-2,0]];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "TwoFactors=List @@(VevFourGravCorr/Prefactor);",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "PrefactorSimplified=Assuming[x>0,(((1)/(x))^dot[k2,k3] ((1)/(x))^dot[k1,k3] (1-z4)^-1+(1)/(2) dot[k2,k3] ((1)/(x))^(1)/(2) dot[k1,k2] (z4)^-1+(1)/(2) dot[k1,k3] (1-z4bar)^-1+(1)/(2) dot[k2,k3] ((1)/(x))^(1)/(2) dot[k1,k2] (z4bar)^-1+(1)/(2) dot[k1,k3] CR[c[0,0],c[1,0],c[2,0],ct[0,0],ct[1,0],ct[2,0],expX[k1,0,0],expX[k2,0,0],expX[k3,0,0],expX[k4,0,0],exp\\[Phi]b[-2,0],exp\\[Phi]tb[-2,0]])/(256 x^2 ) /.{dot[k2,k3]->-dot[k1,k2]-dot[k1,k3]}//Simplify];",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "TwoFactorsSimplified=(((TwoFactors//Expand//ContractDelta)//.{k1[m_] k2[m_]:>dot[k1,k2],k1[m_] k3[m_]:>dot[k1,k3],k1[m_] k4[m_]:>dot[k1,k4],k2[m_] k3[m_]:>dot[k2,k3],k2[m_] k4[m_]:>dot[k2,k4],k3[m_] k4[m_]:>dot[k3,k4]}/.{dot[k1,k4]->dot[k2,k3],dot[k2,k4]->dot[k1,k3],dot[k3,k4]->dot[k1,k2]}/.{dot[k2,k3]->-dot[k1,k2]-dot[k1,k3]})+O[x]^2)/.{k4[m_]:>-k1[m]-k2[m]-k3[m]}/.{k1[\\[Mu]1]->0,k2[\\[Mu]2]->0,k3[\\[Mu]3]->0,k1[\\[Nu]1]->0,k2[\\[Nu]2]->0,k3[\\[Nu]3]->0}//Normal//Simplify;",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(-x^2) PrefactorSimplified/.{CR[c[0,0],c[1,0],c[2,0],ct[0,0],ct[1,0],ct[2,0],expX[k1,0,0],expX[k2,0,0],expX[k3,0,0],expX[k4,0,0],exp\\[Phi]b[-2,0],exp\\[Phi]tb[-2,0]]->-4}",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "(-x^2) PrefactorSimplified/.{CR[c[0,0],c[1,0],c[2,0],ct[0,0],ct[1,0],ct[2,0],expX[k1,0,0],expX[k2,0,0],expX[k3,0,0],expX[k4,0,0],exp\\[Phi]b[-2,0],exp\\[Phi]tb[-2,0]]->-4}/.{dot[k1,k2]->-1/2 s,dot[k2,k3]->-1/2 t,dot[k1,k3]->-1/2 u}/.{z4^a_ z4bar^a_ (1-z4)^b_ (1-z4bar)^b_:>2Pi Gamma[a+1] Gamma[b+1] Gamma[-1-a-b]/(Gamma[a+b+2] Gamma[-b] Gamma[-a])}//Simplify",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "TwoFactorsContracted=({e1[\\[Mu]1]  e2[\\[Mu]2] e3[\\[Mu]3] e4[\\[Mu]4]TwoFactorsSimplified[[1]]/(-x),  e1[\\[Nu]1]e2[\\[Nu]2]e3[\\[Nu]3] e4[\\[Nu]4]TwoFactorsSimplified[[2]]/x}//Expand//ContractDelta)//.{(f1_[\\[Mu]_] f2_[\\[Mu]_]):>dot[f1,f2]}/.{dot[e4,k3]->-dot[e4,k1]-dot[e4,k2]}//Expand;",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
      "value": "TwoFactorsContracted[[1]]-f1-f2-f3//Expand",
      "languageId": "wolfram"
    },
    {
      "kind": 2,
