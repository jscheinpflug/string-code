  4.004486594763674*^9}},ExpressionUUID->"1cbb91d1-ab98-4689-82f4-\
73bdf5efa2e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grav1", "=", 
   RowBox[{"bracket2n1H", "//.", "twoBracketReplRule"}]}], ";", 
  RowBox[{"aux1", "=", 
   RowBox[{"bracket2n1Aux", "//.", "twoBracketReplRule"}]}], ";", 
  RowBox[{"dil1", "=", 
   RowBox[{"bracket2n1Dil", "//.", "twoBracketReplRule"}]}], ";"}]], "Input",
