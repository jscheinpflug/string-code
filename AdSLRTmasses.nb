Cell[BoxData[{
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"$RecursionLimit", " ", "=", " ", "8000"}], "}"}], ",", 
    RowBox[{"corrL1FFL1", " ", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"inversionFactor1", "*", 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"OPEProjected", "[", 
            RowBox[{"0", ",", "0"}], "]"}], "[", 
           RowBox[{
            RowBox[{"lrt1p0", "[", 
             RowBox[{
             "U1b", ",", "m1", ",", "m2", ",", "m3", ",", "m4", ",", "z1", ",",
               "z1bar"}], "]"}], ",", 
            RowBox[{"fluxConstant", "[", 
             RowBox[{
             "F1", ",", "\[Alpha]1", ",", "\[Alpha]2", ",", "0", ",", "0"}], 
             "]"}], ",", 
            RowBox[{"LRT1", "[", 
             RowBox[{
             "U1", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", "1", ",", 
              "1"}], "]"}], ",", 
            RowBox[{"fluxConstIntegrated", "[", 
             RowBox[{
             "F2", ",", "\[Alpha]3", ",", "\[Alpha]4", ",", "w", ",", 
