Cell["Verifying diffeomorphism analysis", "Section",
 CellChangeTimes->{{4.004485667365492*^9, 
  4.004485672002717*^9}},ExpressionUUID->"b108f839-68b0-42bd-abf9-\
81b66d065a98"],

Cell[TextData[{
 "In the following, we solve the diffeomorphism constraint system (D.7) to \
determine ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "H"], TraditionalForm]],ExpressionUUID->
  "efd02a89-4718-499e-80c8-d138076e8316"],
 ". This is done via the Diffeosystem.wl script, written with ClaudeCode."
}], "Text",
 CellChangeTimes->{{4.0044856756361113`*^9, 4.004485759938952*^9}, 
   4.004488234429749*^9, {4.004527446844393*^9, 4.004527470219762*^9}, {
   4.00452753800237*^9, 4.00452754059439*^9}, {4.004528030275971*^9, 
   4.004528069703704*^9}, {4.004528182998989*^9, 
   4.004528184478735*^9}},ExpressionUUID->"2f3d76f6-0642-4140-b6bd-\
436fd5ee8454"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"pipe", ",", "\"\<Diffeosystem.wl\>\""}], "}"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comps", "=", 
    RowBox[{"DFComponents", "[", 
     RowBox[{"1", ",", "bDiff", ",", "2"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "bDiff", " ", "is", " ", "one", " ", "half", " ", "of", " ", "lambda0"}], 
    ";", 
    RowBox[{
    "Step", " ", "2", " ", "prints", " ", "the", " ", "ratio", " ", "to", " ",
      "the", " ", "draft"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"DFCompareWithDraft", "[", "comps", "]"}], ";", 
  RowBox[{"DFPrintSystem", "[", "comps", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DFSolve", "[", "comps", "]"}]}], ";", 
  RowBox[{"DFPrintSolution", "[", 
   RowBox[{"comps", ",", "sol"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.004488983628385*^9, 4.004488983628501*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"ba7aba5b-2ec9-44da-b680-6f933c5365ca"],

