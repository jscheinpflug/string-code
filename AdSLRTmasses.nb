 CellChangeTimes->{{4.004486591166169*^9, 
  4.004486594763674*^9}},ExpressionUUID->"1cbb91d1-ab98-4689-82f4-\
73bdf5efa2e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grav1", "=", 
   RowBox[{"bracket2n1H", "//.", "twoBracketReplRule"}]}], ";", 
  RowBox[{"aux1", "=", 
   RowBox[{"bracket2n1Aux", "//.", "twoBracketReplRule"}]}], ";", 
  RowBox[{"dil1", "=", 
   RowBox[{"bracket2n1Dil", "//.", "twoBracketReplRule"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.004488917578771*^9, 
  4.004488917578848*^9}},ExpressionUUID->"036d3156-ab1b-423c-9e00-\
41b8334df9ef"],

