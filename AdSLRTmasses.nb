Cell[BoxData[
 RowBox[{
  RowBox[{"intW3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"JacR3Wbar", "*", "primitiveWSV"}], ")"}], "//.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", ":>", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"r", "*", 
             RowBox[{"Exp", "[", 
