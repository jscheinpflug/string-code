Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"comps", "=", 
     RowBox[{"LRTComponents", "[", 
      RowBox[{"1", ",", "d"}], "]"}]}], ";", 
    RowBox[{"LRTPrintSystem", "[", "comps", "]"}], ";", 
    RowBox[{"LRTCompareWithDraft", "[", "comps", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sol", "=", 
     RowBox[{"LRTSolve", "[", "comps", "]"}]}], ";", 
    RowBox[{"LRTPrintSolution", "[", 
     RowBox[{"comps", ",", "sol"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"d", ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "4", ",", "3"}], "}"}]}], "}"}]}], "]"}]], "Input",
