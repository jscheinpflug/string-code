          RowBox[{"bDiffn2", ",", "2"}], "]"}]}]}], "]"}], "]"}], "]"}], 
    ",", "\"\< differ\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DFBracketVn", "[", "2", "]"}], "=", "vNative"}], ";"}], "   ", 
