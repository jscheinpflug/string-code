Cell["Computing the correlators with two flux insertions - Eq. F.1", "Text",
 CellChangeTimes->{{4.004367498736665*^9, 4.004367502421537*^9}, {
  4.004375041767272*^9, 4.004375066341435*^9}, {4.004375104689234*^9, 
