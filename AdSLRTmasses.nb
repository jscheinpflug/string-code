 RowBox[{
  RowBox[{"eq1", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "x"}], "-", 
        RowBox[{"1", "/", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "xbar"}], "-", 
        RowBox[{"1", "/", "2"}]}], ")"}]}], "//.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", ":>", 
        RowBox[{"r", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Theta]"}], "]"}]}]}], ",", 
       RowBox[{"xbar", ":>", 
        RowBox[{"r", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}]}]}], "}"}]}], "//", 
    "FullSimplify"}]}], ";"}]], "Input",
