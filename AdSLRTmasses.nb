     RowBox[{"(", 
      RowBox[{"2.5", " ", "h"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<native V_2: \>\"", ",", 
    RowBox[{"Length", "[", 
     RowBox[{"DFTerms", "[", "vNative", "]"}], "]"}], 
    ",", "\"\< monomials; vs 2 x leading-Regge half: \>\"", ",", 
    RowBox[{"Length", "[", 
