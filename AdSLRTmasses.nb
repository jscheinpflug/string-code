    RowBox[{
    "BRSTn1", " ", "+", " ", "grav1", "+", "aux1", "+", "dil1", " ", "+", " ", 
     RowBox[{"Total", "[", "QC1paper", "]"}]}], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{
  4.004470983748022*^9},ExpressionUUID->"5593cabe-9c50-4131-bf4d-\
44830d5e8935"],

