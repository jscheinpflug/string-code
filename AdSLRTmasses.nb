Cell[CellGroupData[{

Cell["Verifying E.O.M. and mass analysis", "Section",
 CellChangeTimes->{{4.004486432943928*^9, 
  4.0044864684108543`*^9}},ExpressionUUID->"761423b1-8f43-4a59-b2b2-\
45f62acec6fd"],

Cell[TextData[{
 "Now that all the relevant components have been computed above using \
string-code, we can assemble the full e.o.m. and solve the system which \
determines the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "n"], TraditionalForm]],ExpressionUUID->
  "2e0a7cb4-6e9e-46a1-8fec-4541a7d26ed1"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "n"], TraditionalForm]],ExpressionUUID->
  "9f5903b2-e2f0-4809-a429-11a72dfbfa64"],
 " for n=1,2. The ingredients are the following: NSNS brackets with the \
second-order solution, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "B"], TraditionalForm]],ExpressionUUID->
  "8f41d620-7864-4043-80c7-1330452b651f"],
 " action on the auxiliary oscillator ansatz that will determine ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "n"], TraditionalForm]],ExpressionUUID->
  "d06b7376-eab5-45d0-ae96-38cae95609da"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "B"], TraditionalForm]],ExpressionUUID->
  "401638db-be9e-4a10-89e3-56bd92d9f937"],
 " action on the linearized second-order fluctuation. Note that the latter is \
to be subsequently redefined using the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "H"], TraditionalForm]],ExpressionUUID->
  "0ae764e0-5c00-414c-a2a8-58a99b161c42"],
 " field redefinition motivated by the diffeomorphism analysis. The \
verification and solution is done via LRTsystem.wl written with ClaudeCode."
}], "Text",
 CellChangeTimes->{{4.0044688214977493`*^9, 4.0044688354844027`*^9}, {
  4.004468921937175*^9, 4.004469061953233*^9}, {4.0045270001480503`*^9, 
  4.004527011497036*^9}, {4.004527202868401*^9, 4.0045272754601107`*^9}, {
  4.004527331820405*^9, 4.00452736561896*^9}, {4.004527397851019*^9, 
  4.004527419065915*^9}, {4.004528129728476*^9, 
  4.00452814123729*^9}},ExpressionUUID->"e24e0b9e-1af8-4898-a0bd-\
7bc32a9a03da"],

Cell[CellGroupData[{

