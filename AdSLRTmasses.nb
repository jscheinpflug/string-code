Cell["Determining Jacobians", "Text",
 CellChangeTimes->{{4.0043681831838923`*^9, 
  4.004368187029765*^9}},ExpressionUUID->"358c8023-0270-4aaf-8bb1-\
de6231596c59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eq1", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "x"}], "-", 
        RowBox[{"1", "/", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "xbar"}], "-", 
        RowBox[{"1", "/", "2"}]}], ")"}]}], "//.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", ":>", 
        RowBox[{"r", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Theta]"}], "]"}]}]}], ",", 
       RowBox[{"xbar", ":>", 
        RowBox[{"r", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}]}]}], "}"}]}], "//", 
    "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9980413916486*^9, 3.998041393611822*^9}, {
   3.998041432956572*^9, 3.998041547627327*^9}, {3.9980416212220707`*^9, 
   3.998041621966895*^9}, 3.99805554056275*^9},
 CellLabel->
  "In[218]:=",ExpressionUUID->"345f0815-4623-43c3-bc6f-98118da1d10b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rule", " ", "=", " ", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"eq1", "==", 
       RowBox[{"r0", "^", "2"}]}], ",", 
      RowBox[{"{", "\[Theta]", "}"}]}], "]"}], "//", "Flatten"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998041624348814*^9, 3.99804165653249*^9}, {
   3.998042000900126*^9, 3.998042011871674*^9}, {3.99804842307653*^9, 
