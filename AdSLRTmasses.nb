             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}], ")"}]}]}]}], 
        "}"}]}], ")"}], "//.", 
     RowBox[{"{", 
      RowBox[{"r", ":>", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
         RowBox[{
          SqrtBox["2"], " ", 
          SqrtBox[
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"8", " ", 
             SuperscriptBox["r0", "2"]}], "+", 
            RowBox[{"Cos", "[", 
             RowBox[{"2", " ", "\[Theta]"}], "]"}]}]]}]}], 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["r0", "2"]}]}]]}], "}"}]}], "//", "FullSimplify"}]}],
   ";"}]], "Input",
