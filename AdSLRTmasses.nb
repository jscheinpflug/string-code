     RowBox[{"\"\<conventions\>\"", "->", "\"\<TypeII-Ashoke\>\""}], ",", 
     RowBox[{"\"\<bracket\>\"", "->", "\"\<Flat\>\""}]}], "|>"}], "]"}], 
  ";"}]}], "Input",
