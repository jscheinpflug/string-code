Cell["\<\
Above we recorded the level n=1 verification, and we proceed with n=2 below\
\>", "Text",
 CellChangeTimes->{{4.004530846948674*^9, 
  4.004530862084898*^9}},ExpressionUUID->"8200447c-32d5-4cb7-af8b-\
425bf799d74c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "pipe", ",", "\"\<helpers\>\"", 
      ",", "\"\<regge_leading_projection.wl\>\""}], "}"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bracketDiffn2Leading", "=", 
   RowBox[{"ReggeLeadingHalf", "[", 
    RowBox[{
     RowBox[{"R", "[", 
      RowBox[{
       RowBox[{"ProfileX", "[", 
        RowBox[{
         RowBox[{"V", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"{", "}"}], ",", "0", ",", "0"}], "]"}], ",", 
       RowBox[{"c", "[", 
        RowBox[{"0", ",", "0"}], "]"}], ",", 
       RowBox[{"ct", "[", 
        RowBox[{"0", ",", "0"}], "]"}], ",", 
       RowBox[{"exp\[Phi]f", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "]"}], ",", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"\[Mu]", ",", "0", ",", "0"}], "]"}], ",", 
       RowBox[{"exp\[Phi]tb", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "0"}], "]"}], ",", 
       RowBox[{"\[Xi]t", "[", 
        RowBox[{"1", ",", "0"}], "]"}]}], "]"}], ",", 
     RowBox[{"LRT2", "[", 
      RowBox[{
      "U2", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", "p5", ",", "p6", 
       ",", "0", ",", "0"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bDiffn2", "=", 
   RowBox[{"derAppend", "[", 
    RowBox[{"bracketDiffn2Leading", "//.", "twoBracketReplRule"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"comps2", "=", 
   RowBox[{"DFComponents", "[", 
    RowBox[{"2", ",", "bDiffn2", ",", "2"}], "]"}]}], ";", 
  RowBox[{"DFCompareWithDraft", "[", "comps2", "]"}], ";", 
  RowBox[{"DFPrintSystem", "[", "comps2", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol2", "=", 
   RowBox[{"DFSolve", "[", "comps2", "]"}]}], ";", 
  RowBox[{"DFPrintSolution", "[", 
   RowBox[{"comps2", ",", "sol2"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.004531113418679*^9, 4.004531113418807*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"031c1b7e-3161-4af1-b54b-45d8826d8e99"],

