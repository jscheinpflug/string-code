Cell[BoxData[
 RowBox[{
  RowBox[{"Canonicalize", "[", "RR_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fieldList", " ", "=", " ", 
