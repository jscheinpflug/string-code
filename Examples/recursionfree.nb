       RowBox[{
        RowBox[{"deleteAll", "[", "evenFields", "]"}], "[", "fieldList", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gradedFieldAssoc", " ", "=", " ", 
       RowBox[{"SepGradedFields", "[", "gradedFieldList", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", 
         RowBox[{"gradedFieldAssoc", "[", 
          RowBox[{"[", "\"\<nChir\>\"", "]"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<oddfields\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"oddBosonizedChirFields", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", 
         RowBox[{"gradedFieldAssoc", "[", 
          RowBox[{"[", "\"\<nAntiChir\>\"", "]"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<oddfields\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"oddBosonizedAntiChFields", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sgn", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<moves\>\"", "]"}], "]"}], ")"}]}], 
        RowBox[{"Signature", "[", 
