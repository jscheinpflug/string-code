Cell[BoxData[{
 RowBox[{
  RowBox[{"SepGradedFields", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nChir", "=", "0"}], ",", 
      RowBox[{"nAntiChir", " ", "=", "0"}], ",", " ", 
      RowBox[{"moves", "=", "0"}], ",", 
      RowBox[{"oddfields", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"oddFieldQ", "[", "tmp", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"moves", "+=", " ", 
           RowBox[{"nChir", " ", "+", " ", "nAntiChir"}]}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oddfields", ",", "tmp"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"oddBosChirFieldQ", "[", "tmp", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"moves", "+=", " ", "nAntiChir"}], ";", " ", 
          RowBox[{"nChir", "++"}]}], ",", "\[IndentingNewLine]", "True", ",", 
         " ", 
         RowBox[{"nAntiChir", "++"}]}], "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"tmp", ",", "list"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<moves\>\"", "->", "moves"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"number", " ", "of", " ", "parity"}], "-", 
         RowBox[{
         "odd", " ", "moves", " ", "to", " ", "group", " ", "graded", " ", 
          "fields", " ", "by", " ", "parity"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<nChir\>\"", "->", "nChir"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<nAntiChir\>\"", "->", "nAntiChir"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<oddfields\>\"", "->", "oddfields"}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"ORCanonicalize", "[", "RR_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fieldList", " ", "=", " ", 
        RowBox[{"List", "@@", "RR"}]}], ",", "gradedFieldList", ",", " ", 
       "gradedFieldAssoc", ",", " ", "sgn"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gradedFieldList", " ", "=", " ", 
       RowBox[{
        RowBox[{"deleteAll", "[", "evenFields", "]"}], "[", "fieldList", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gradedFieldAssoc", " ", "=", " ", 
       RowBox[{"SepGradedFields", "[", "gradedFieldList", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", 
         RowBox[{"gradedFieldAssoc", "[", 
          RowBox[{"[", "\"\<nChir\>\"", "]"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<oddfields\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"oddBosonizedChirFields", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", 
         RowBox[{"gradedFieldAssoc", "[", 
          RowBox[{"[", "\"\<nAntiChir\>\"", "]"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<oddfields\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"oddBosonizedAntiChFields", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sgn", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"gradedFieldAssoc", "[", 
           RowBox[{"[", "\"\<moves\>\"", "]"}], "]"}], ")"}]}], 
        RowBox[{"Signature", "[", 
         RowBox[{"gradedFieldAssoc", "[", 
          RowBox[{"[", "\"\<oddfields\>\"", "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sgn", " ", "==", "0"}], ",", " ", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sgn", " ", 
       RowBox[{"OR", " ", "@@", " ", 
        RowBox[{"Sort", "[", "fieldList", "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "[", "RR", "]"}], "==", "OR"}]}]}], "\n", 
 RowBox[{
  RowBox[{"ORCanonical", "[", "x___", "]"}], ":=", 
  RowBox[{"ORCanonicalize", "[", 
   RowBox[{"OR", "[", "x", "]"}], "]"}]}]}], "Input",
