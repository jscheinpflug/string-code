  {
   "kind": 2,
   "value": "uncanonMatter = generateBasisMatterHolo[2, \"CanonicalizeIndices\" -> False];\ncanonMatter = generateBasisMatterHolo[2, \"CanonicalizeIndices\" -> True];\nuncanonHolo = generateBasisHolo[2, 0, \"CanonicalizeIndices\" -> False];\ncanonHolo = generateBasisHolo[2, 0, \"CanonicalizeIndices\" -> True];\nuncanonFull = generateBasis[2, 0, \"LevelMatched\" -> False, \"CanonicalizeIndices\" -> False];\ncanonFull = generateBasis[2, 0, \"LevelMatched\" -> False, \"CanonicalizeIndices\" -> True];\nhasDollarQ[expr_] := !FreeQ[expr, _Symbol?(StringContainsQ[SymbolName[#], \"$\"] &)];\nnoDollarQ[expr_] := FreeQ[expr, _Symbol?(StringContainsQ[SymbolName[#], \"$\"] &)];\ntest23Result = uncanonMatter =!= {} && canonMatter =!= {} && uncanonHolo =!= {} && canonHolo =!= {} &&\n  AnyTrue[uncanonMatter, hasDollarQ] && AllTrue[canonMatter, noDollarQ] &&\n  AnyTrue[uncanonHolo, hasDollarQ] && AllTrue[canonHolo, noDollarQ] &&\n  uncanonFull =!= {} && canonFull =!= {} && Length[uncanonFull] == Length[canonFull];\nPrint[\"Test 23 (CanonicalizeIndices toggle works for bosonic APIs): \", If[test23Result, \"PASSED\", \"FAILED\"]];\ntest23Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
