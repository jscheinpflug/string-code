  {
   "kind": 2,
   "value": "h2 = generateBasisHolo[2, 0];\nmatterH2 = Sort[generateBasisMatterHolo[2]];\nmatterAH2 = Sort[generateBasisMatterAntiHolo[2]];\nexpectedMatterH2 = Sort[{R[dX[mu1, 1, 0]], R[dX[mu1, 0, 0], dX[mu2, 0, 0]]}];\nexpectedMatterAH2 = Sort[{R[dXt[mu1, 1, 0]], R[dXt[mu1, 0, 0], dXt[mu2, 0, 0]]}];\ntest1Result = Length[h2] == 5 && Count[h2, R[dX[_Symbol, 1, 0]]] == 1 && Count[h2, R[dX[_Symbol, 0, 0], dX[_Symbol, 0, 0]]] == 1 &&\n  matterH2 === expectedMatterH2 && matterAH2 === expectedMatterAH2 && Sort[generateBasisMatter[2]] === expectedMatterH2;\nPrint[\"Test 1 (matter completion + matter-only APIs): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
