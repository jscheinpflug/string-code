  {
   "kind": 2,
   "value": "fieldWeight[field_] := Module[{headName = SymbolName[Head[field]]},\n  Switch[headName,\n    \"b\", 2 + field[[1]],\n    \"c\", -1 + field[[1]],\n    \"dX\", 1 + field[[2]],\n    \"bt\", 2 + field[[1]],\n    \"ct\", -1 + field[[1]],\n    \"dXt\", 1 + field[[2]],\n    _, 0\n  ]\n];\nsectorWeights[expr_] := Module[{holoWeight, antiWeight},\n  holoWeight = Total[fieldWeight /@ Cases[\n      expr,\n      field_ /; MemberQ[{\"b\", \"c\", \"dX\"}, SymbolName[Head[field]]],\n      Infinity\n    ]];\n  antiWeight = Total[fieldWeight /@ Cases[\n      expr,\n      field_ /; MemberQ[{\"bt\", \"ct\", \"dXt\"}, SymbolName[Head[field]]],\n      Infinity\n    ]];\n  {holoWeight, antiWeight}\n];\nfull40 = generateBasis[4, 0, \"LevelMatched\" -> False];\nlevelMatched40 = generateBasis[4, 0, \"LevelMatched\" -> True];\nexpectedLevelMatched40 = Select[full40, With[{weights = sectorWeights[#]}, weights[[1]] == weights[[2]]] &];\ntest21Result = Sort[levelMatched40] === Sort[expectedLevelMatched40] && levelMatched40 =!= {} &&\n  AllTrue[levelMatched40, With[{weights = sectorWeights[#]}, weights[[1]] == weights[[2]]] &];\nPrint[\"Test 21 (level-matched subset equals filtered full basis at w=4,gh=0): \", If[test21Result, \"PASSED\", \"FAILED\"]];\ntest21Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 21 (level-matched subset equals filtered full basis at w=4,gh=0): PASSED\n</pre>",
