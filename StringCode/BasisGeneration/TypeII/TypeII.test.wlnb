  {
   "kind": 2,
   "value": "basisProjected = generateBasisHolo[2, 0, -1, \"GSOProjected\" -> True];\nbasisUnprojected = generateBasisHolo[2, 0, -1, \"GSOProjected\" -> False];\nsubsetQ[a_, b_] := Complement[a, b] === {};\nvalidHoloTupleQ[entry_] := MatchQ[entry, {-1, _List}];\nprojectedParityQ[entry_] := gsoParityConfigFn[entry[[2]], -1] === 1;\nweightMatchQ[entry_] := groundStateWeightFn[-1] + modeWeightFn[entry[[2]]] === 2;\nghostMatchQ[entry_] := modeGhostNumberFn[entry[[2]]] === 0;\ntest8Result = basisProjected =!= {} && basisUnprojected =!= {} &&\n  AllTrue[basisProjected, validHoloTupleQ] &&\n  AllTrue[basisProjected, ghostMatchQ] &&\n  AllTrue[basisProjected, weightMatchQ] &&\n  AllTrue[basisProjected, projectedParityQ] &&\n  subsetQ[basisProjected, basisUnprojected] &&\n  Length[basisUnprojected] >= Length[basisProjected];\nPrint[\"Test 8 (holo invariants + GSO option behavior): \", If[test8Result, \"PASSED\", \"FAILED\"]];\ntest8Result",
   "languageId": "wolfram",
