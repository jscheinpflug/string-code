  {
   "kind": 2,
   "value": "psiInt = generatePsiModeConfigsFn[3, -1];\npsiHalf = generatePsiModeConfigsFn[3, {-1/2, \"chiral\"}];\npsiModeNumbers[cfgs_List] := modeNumbersByHeadName[cfgs, \"\\[Psi]\"];\nintModeNumbers = psiModeNumbers[psiInt[[All, 1]]];\nhalfModeNumbers = psiModeNumbers[psiHalf[[All, 1]]];\noddHalfIntegerQ[x_] := IntegerQ[2 x] && OddQ[Numerator[Together[x]]];\ntest7Result = intModeNumbers =!= {} && halfModeNumbers =!= {} &&\n  AllTrue[intModeNumbers, oddHalfIntegerQ] && AllTrue[halfModeNumbers, IntegerQ] && !MemberQ[halfModeNumbers, 0];\nPrint[\"Test 7 (psi moding regimes; no psi[0] at half-integer picture): \", If[test7Result, \"PASSED\", \"FAILED\"]];\ntest7Result",
   "languageId": "wolfram",
