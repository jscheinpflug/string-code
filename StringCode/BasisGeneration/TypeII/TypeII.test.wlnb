  {
   "kind": 2,
   "value": "test4Result = groundStateGSOFn[-2] === 1 && groundStateGSOFn[0] === 1 && groundStateGSOFn[2] === 1 &&\n  groundStateGSOFn[-1] === -1 && groundStateGSOFn[1] === -1 &&\n  groundStateGSOFn[{-1/2, \"chiral\"}] === 1 && groundStateGSOFn[{-1/2, \"antichiral\"}] === -1 &&\n  groundStateGSOFn[{1/2, \"chiral\"}] === -1 && groundStateGSOFn[{1/2, \"antichiral\"}] === 1;\nPrint[\"Test 4 (ground-state GSO parity table): \", If[test4Result, \"PASSED\", \"FAILED\"]];\ntest4Result",
