{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII BasisGeneration Core Tests\n\nTests focused on core TypeII basis-generation helpers and API surface.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]\n\nprivateContext = \"Private`\";\nhalfIntegerPred = Symbol[privateContext <> \"halfIntegerQ\"];\ngroundStateWeightFn = Symbol[privateContext <> \"groundStateWeight\"];\ngroundStateGSOFn = Symbol[privateContext <> \"gsoParityOfGroundState\"];\ngenerateSuperghostConfigsFn = Symbol[privateContext <> \"generateSuperghostConfigs\"];\ngeneratePsiModeConfigsFn = Symbol[privateContext <> \"generatePsiModeConfigs\"];\nmodeGhostNumberFn = Symbol[privateContext <> \"modeListGhostNumber\"];\nmodeWeightFn = Symbol[privateContext <> \"modeListWeight\"];\ngsoParityConfigFn = Symbol[privateContext <> \"gsoParityOfConfig\"];\n\nsymbolNameOfHead[expr_] := SymbolName[If[AtomQ[expr], expr, Head[expr]]];\nmodeEntries[expr_] := Cases[\n  expr,\n  modeExpr_[head_, modeNumber_] /; symbolNameOfHead[modeExpr] === \"mode\" :> {head, modeNumber},\n  Infinity\n];\nmodeNumbersByHeadName[expr_, targetName_String] := Cases[\n  modeEntries[expr],\n  {head_, modeNumber_} /; symbolNameOfHead[head] === targetName :> modeNumber\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770854596761,
     "endTime": 1770854597730
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "test1Result = Context[generateBasisHolo] === \"StringCode`BasisGeneration`TypeII`\" &&\n  Context[generateBasisAntiHolo] === \"StringCode`BasisGeneration`TypeII`\" &&\n  Context[generateBasis] === \"StringCode`BasisGeneration`TypeII`\";\nPrint[\"Test 1 (public context export): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 1 (public context export): PASSED\n</pre>",
