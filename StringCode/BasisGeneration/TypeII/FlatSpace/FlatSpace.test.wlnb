  {
   "kind": 2,
   "value": "holoVac = generateBasisHoloModes[0, 0, 0];\nmatterVac = generateBasisMatterHoloModes[0, 0];\nmatterVacAnti = generateBasisMatterAntiHoloModes[0, 0];\nmatterAntiSample = generateBasisMatterAntiHoloModes[2, -1/2, \"GSOParity\" -> \"All\"];\nextractMatterStates[result_] := Which[\n  result === {},\n  {},\n  MatchQ[result, {_?((IntegerQ[#] || MatchQ[#, {_?NumericQ, _String}]) &), _List}],\n  result[[2]],\n  ListQ[result],\n  Flatten[result[[All, 2]], 1],\n  True,\n  {}\n];\nantiMatterHeads = Flatten[modeHeadNames /@ extractMatterStates[matterAntiSample]];\ntest3Result = holoVac =!= {} && MatchQ[holoVac[[1]], {0, _List}] && holoVac[[1, 2]] === {} &&\n  matterVac === {0, {{}}} && matterVacAnti === {0, {{}}} &&\n  antiMatterHeads =!= {} && AllTrue[antiMatterHeads, antiHeadNameQ];\nPrint[\"Test 3 (vacuum + matter-only APIs): \", If[test3Result, \"PASSED\", \"FAILED\"]];\ntest3Result",
   "languageId": "wolfram",
   "outputs": [
