  {
   "kind": 2,
   "value": "holoIntPic = generateBasisHolo[3, 0, -1, \"GSOProjected\" -> False];\nholoHalfPic = generateBasisHolo[3, 0, -1/2, \"GSOProjected\" -> False];\npsiModesFromBasis[basis_List] := modeNumbersByHeadName[basis, \"\\[Psi]\"];\nintPsiModes = psiModesFromBasis[holoIntPic[[All, 2]]];\nhalfPsiModes = psiModesFromBasis[holoHalfPic[[All, 2]]];\noddHalfIntegerQ[x_] := IntegerQ[2 x] && OddQ[Numerator[Together[x]]];\ntest4Result = intPsiModes =!= {} && halfPsiModes =!= {} &&\n  AllTrue[intPsiModes, oddHalfIntegerQ] && AllTrue[halfPsiModes, IntegerQ] && !MemberQ[halfPsiModes, 0];\nPrint[\"Test 4 (integer vs half-integer picture psi moding; no psi[0] at half-integer picture): \", If[test4Result, \"PASSED\", \"FAILED\"]];\ntest4Result",
   "languageId": "wolfram",
