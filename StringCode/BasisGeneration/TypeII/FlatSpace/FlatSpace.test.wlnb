  {
   "kind": 2,
   "value": "det1 = normalizeFullBasis[generateBasisModes[4, 0, {-1, -1}, \"LevelMatched\" -> False, \"GSOProjected\" -> False]];\ndet2 = normalizeFullBasis[generateBasisModes[4, 0, {-1, -1}, \"LevelMatched\" -> False, \"GSOProjected\" -> False]];\nspecialBasis = generateBasisModes[0, 2, {-1, -1}];\nleftSectorExpectedQ[state_List] :=\n  Count[modeNumbersByHeadName[holoModes[state], \"c\"], 1] >= 1 &&\n  Count[modeNumbersByHeadName[holoModes[state], \"\\[Psi]\"], -1/2] >= 1;\nrightSectorExpectedQ[state_List] :=\n  Count[modeNumbersByHeadName[antiModes[state], \"ct\"], 1] >= 1 &&\n  Count[modeNumbersByHeadName[antiModes[state], \"\\[Psi]t\"], -1/2] >= 1;\nexpectedSpecialStateQ[state_List] := leftSectorExpectedQ[state] && rightSectorExpectedQ[state];\ntest10Result = det1 === det2 && specialBasis =!= {} && specialBasis[[1]] === {-1, -1} && AnyTrue[specialBasis[[2]], expectedSpecialStateQ];\nPrint[\"Test 10 (determinism + expected (0,2,{-1,-1}) state): \", If[test10Result, \"PASSED\", \"FAILED\"]];\ntest10Result",
   "languageId": "wolfram",
