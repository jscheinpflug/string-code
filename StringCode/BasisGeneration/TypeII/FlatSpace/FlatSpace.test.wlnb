  {
   "kind": 2,
   "value": "fullExplicitLM = generateBasis[4, 0, {-1, -1}, \"LevelMatched\" -> True];\nsectorWeights[state_] := Module[{leftModes, rightModes},\n  leftModes = holoModes[state];\n  rightModes = antiModes[state];\n  {groundStateWeightFn[-1] + modeWeightFn[leftModes], groundStateWeightFn[-1] + modeWeightFn[rightModes]}\n];\nlevelMatchedQ[state_] := With[{weights = sectorWeights[state]}, weights[[1]] === weights[[2]]];\ntest7Result = normalizeFullBasis[fullDefault] === normalizeFullBasis[fullExplicitLM] && fullDefault =!= {} && AllTrue[fullDefault[[2]], levelMatchedQ];\nPrint[\"Test 7 (LevelMatched default/explicit semantics): \", If[test7Result, \"PASSED\", \"FAILED\"]];\ntest7Result",
