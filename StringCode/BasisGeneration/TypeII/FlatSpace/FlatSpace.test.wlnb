  {
   "kind": 2,
   "value": "fullProjected = generateBasisModes[4, 0, {-1, -1}, \"LevelMatched\" -> False, \"GSOProjected\" -> True];\nfullUnprojected = generateBasisModes[4, 0, {-1, -1}, \"LevelMatched\" -> False, \"GSOProjected\" -> False];\nsectorGSOEvenQ[state_] := Module[{leftModes, rightModes},\n  leftModes = holoModes[state];\n  rightModes = antiModes[state];\n  gsoParityConfigFn[leftModes, -1] === 1 && gsoParityConfigFn[rightModes, -1] === 1\n];\ntest9Result = fullProjected =!= {} && fullUnprojected =!= {} &&\n  subsetQ[fullProjected[[2]], fullUnprojected[[2]]] && AllTrue[fullProjected[[2]], sectorGSOEvenQ] && Length[fullUnprojected[[2]]] >= Length[fullProjected[[2]]];\nPrint[\"Test 9 (per-sector GSO projection in full basis): \", If[test9Result, \"PASSED\", \"FAILED\"]];\ntest9Result",
