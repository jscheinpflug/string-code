{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace BasisGeneration Tests\n\nPublic API behavior tests for TypeII FlatSpace basis generation.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]\n\nprivateContext = \"Private`\";\ngroundStateWeightFn = Symbol[privateContext <> \"groundStateWeight\"];\nmodeWeightFn = Symbol[privateContext <> \"modeListWeight\"];\nmodeGhostNumberFn = Symbol[privateContext <> \"modeListGhostNumber\"];\ngsoParityConfigFn = Symbol[privateContext <> \"gsoParityOfConfig\"];\n\nsymbolNameOfHead[expr_] := SymbolName[If[AtomQ[expr], expr, Head[expr]]];\nmodeEntries[expr_] := Cases[\n  expr,\n  modeExpr_[head_, modeNumber_] /; symbolNameOfHead[modeExpr] === \"mode\" :> {head, modeNumber},\n  Infinity\n];\nmodeHeadNames[expr_] := symbolNameOfHead /@ (modeEntries[expr][[All, 1]] /. {} -> {});\nmodeNumbersByHeadName[expr_, targetName_String] := Cases[\n  modeEntries[expr],\n  {head_, modeNumber_} /; symbolNameOfHead[head] === targetName :> modeNumber\n];\nantiHeadNameQ[name_String] := MemberQ[{\"bt\", \"ct\", \"\\[Beta]t\", \"\\[Gamma]t\", \"dXt\", \"\\[Psi]t\"}, name];\nmodeHeadNameOfMode[modeObj_] := Module[{heads = modeHeadNames[{modeObj}]}, If[heads === {}, \"\", First[heads]]];\nholoModes[state_List] := Select[state, !antiHeadNameQ[modeHeadNameOfMode[#]] &];\nantiModes[state_List] := Select[state, antiHeadNameQ[modeHeadNameOfMode[#]] &];\nnormalizeFullBasis[result_] := If[result === {}, {}, {result[[1]], Sort[result[[2]]] }];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770951232581,
     "endTime": 1770951233685
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "holo = generateBasisHolo[2, 0, -1];\nvalidHoloTupleQ[entry_] := MatchQ[entry, {-1, _List}];\ntest1Result = holo =!= {} && AllTrue[holo, validHoloTupleQ];\nPrint[\"Test 1 (basic holo shape/non-empty): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 1 (basic holo shape/non-empty): PASSED\n</pre>",
