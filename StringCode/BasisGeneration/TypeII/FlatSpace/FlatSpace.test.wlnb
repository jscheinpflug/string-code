  {
   "kind": 2,
   "value": "fullAllSplits = generateBasisModes[4, 0, {-1, -1}, \"LevelMatched\" -> False];\nnonLevelMatchedCount = Count[fullAllSplits[[2]], state_ /; !levelMatchedQ[state]];\ntest8Result = subsetQ[fullDefault[[2]], fullAllSplits[[2]]] && Length[fullAllSplits[[2]]] >= Length[fullDefault[[2]]] && nonLevelMatchedCount >= 1;\nPrint[\"Test 8 (LevelMatched false superset + non-LM states): \", If[test8Result, \"PASSED\", \"FAILED\"]];\ntest8Result",
