  {
   "kind": 2,
   "value": "holoProj = generateBasisHoloModes[3, 0, -1, \"GSOProjected\" -> True];\nholoUnproj = generateBasisHoloModes[3, 0, -1, \"GSOProjected\" -> False];\nholoEven = generateBasisHoloModes[3, 0, -1, \"GSOParity\" -> \"Even\"];\nholoOdd = generateBasisHoloModes[3, 0, -1, \"GSOParity\" -> \"Odd\"];\nholoAll = generateBasisHoloModes[3, 0, -1, \"GSOParity\" -> \"All\"];\nsubsetQ[a_, b_] := Complement[a, b] === {};\noddParityQ[entry_] := gsoParityConfigFn[entry[[2]], -1] === -1;\ntest5Result = holoProj =!= {} && holoUnproj =!= {} && subsetQ[holoProj, holoUnproj] && Length[holoUnproj] >= Length[holoProj] &&\n  Sort[holoEven] === Sort[holoProj] && Sort[holoAll] === Sort[holoUnproj] && AllTrue[holoOdd, oddParityQ];\nPrint[\"Test 5 (GSOParity + legacy option subset behavior): \", If[test5Result, \"PASSED\", \"FAILED\"]];\ntest5Result",
   "languageId": "wolfram",
