  {
   "kind": 2,
   "value": "pictureSpecQ[p_] := IntegerQ[p] || MatchQ[p, {q_ /; IntegerQ[2 q] && OddQ[Numerator[Together[q]]], \"chiral\" | \"antichiral\"}];\nvalidPicturePairQ[pair_] := MatchQ[pair, {left_, right_} /; pictureSpecQ[left] && pictureSpecQ[right]];\nstateModeListQ[state_] := ListQ[state] && AllTrue[state, symbolNameOfHead[#] === \"mode\" &];\nstateCollectionQ[states_List] := AllTrue[states, stateModeListQ];\ngroupQ[obj_] := MatchQ[obj, {pair_, states_List} /; validPicturePairQ[pair] && stateCollectionQ[states]];\nbasisGroups[result_] := Which[\n  result === {},\n  {},\n  groupQ[result],\n  {result},\n  ListQ[result] && AllTrue[result, groupQ],\n  result,\n  True,\n  {}\n];\ntotalStateCount[result_] := Module[{groups = basisGroups[result]},\n  Total[Length /@ (groups[[All, 2]] /. {} -> {})]\n];\ngroupStateCounts[result_] := Length /@ (basisGroups[result][[All, 2]] /. {} -> {});\ngroupLabels[result_] := basisGroups[result][[All, 1]] /. {} -> {};\nnormalizeGroupedBasis[result_] := SortBy[({#[[1]], Sort[#[[2]]]} &) /@ basisGroups[result], First];\nbasis021 = generateBasis[0, 2, {-1/2, -1}];\ntest11Result = totalStateCount[basis021] === 4 && Sort[groupStateCounts[basis021]] === {1, 3};\nPrint[\"Test 11 (count for (0,2,{-1/2,-1}) is 4): \", If[test11Result, \"PASSED\", \"FAILED\"]];\ntest11Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 11 (count for (0,2,{-1/2,-1}) is 4): PASSED\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"Test 11 (count for (0,2,{-1/2,-1}) is 4): PASSED\\n\"",
       "mime": "text/plain"
