  {
   "kind": 2,
   "value": "anti = generateBasisAntiHolo[2, 0, -1];\nholoHeads = Flatten[modeHeadNames /@ holo[[All, 2]]];\nantiHeads = Flatten[modeHeadNames /@ anti[[All, 2]]];\nforbiddenAntiHeads = {\"b\", \"c\", \"\\[Beta]\", \"\\[Gamma]\", \"dX\", \"\\[Psi]\"};\ntest2Result = anti =!= {} && Intersection[antiHeads, forbiddenAntiHeads] === {} &&\n  MemberQ[antiHeads, \"bt\"] && MemberQ[antiHeads, \"ct\"] && MemberQ[antiHeads, \"dXt\"] && MemberQ[antiHeads, \"\\[Psi]t\"];\nPrint[\"Test 2 (anti-holo replacement heads): \", If[test2Result, \"PASSED\", \"FAILED\"]];\ntest2Result",
   "languageId": "wolfram",
   "outputs": [
