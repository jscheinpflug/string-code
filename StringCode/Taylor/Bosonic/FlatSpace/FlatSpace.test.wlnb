 "cells": [
  {
   "kind": 1,
   "value": "# Bosonic FlatSpace Taylor Unit Tests\n\nFlatSpace-specific tests for Bosonic Taylor:\n- dX/dXt Taylor expansion\n- expX point-detection\n- derivative helpers\n- FlatSpace Taylor polynomials",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Remove[\"Global`*\"]\nNeeds[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"Bosonic\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"Bosonic-Xi\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram",
   "outputs": [
