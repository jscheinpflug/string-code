   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "exprH = R[b[0,z],c[1,w]];\nexpectedH1 = (w-z0) R[b[0,z0],c[2,z0]] + (z-z0) R[b[1,z0],c[1,z0]];\ntest1 = Simplify[TaylorAtOrderHolo[exprH, 1, z0] - expectedH1] === 0;\nPrint[\"Test 1 (TaylorAtOrderHolo order 1): \", If[test1, \"PASSED\", \"FAILED\"]];\ntest1",
   "languageId": "wolfram",
