  {
   "kind": 2,
   "value": "canonicalizeDummies[expr_] := Module[{inds, idxRules},\n  inds = DeleteDuplicates@Cases[expr, (k|der[_])[\\[Mu]_Symbol] :> \\[Mu], Infinity];\n  inds = Join[inds, DeleteDuplicates@Cases[expr, dX[\\[Mu]_Symbol, _, _] :> \\[Mu], Infinity]];\n  inds = Join[inds, DeleteDuplicates@Cases[expr, dXt[\\[Mu]_Symbol, _, _] :> \\[Mu], Infinity]];\n  inds = DeleteDuplicates[inds];\n  idxRules = Thread[inds -> Array[Symbol[\"muCanon\" <> ToString[#]] &, Length[inds]]];\n  Expand[expr /. idxRules]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770759233466,
     "endTime": 1770759233533
    },
    "executionOrder": 44,
    "success": true
   }
  },
  {
   "kind": 2,
