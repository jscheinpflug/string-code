  },
  {
   "kind": 2,
   "value": "canonicalizeDummies[expr_] := Module[{inds, idxRules},\n  inds = DeleteDuplicates@Cases[expr, (k|der[_])[\\[Mu]_Symbol] :> \\[Mu], Infinity];\n  inds = Join[inds, DeleteDuplicates@Cases[expr, dX[\\[Mu]_Symbol, _, _] :> \\[Mu], Infinity]];\n  inds = Join[inds, DeleteDuplicates@Cases[expr, dXt[\\[Mu]_Symbol, _, _] :> \\[Mu], Infinity]];\n  inds = DeleteDuplicates[inds];\n  idxRules = Thread[inds -> Array[Symbol[\"muCanon\" <> ToString[#]] &, Length[inds]]];\n  Expand[expr /. idxRules]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770589884446,
     "endTime": 1770589884517
    },
    "executionOrder": 33,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "expectedExp2 = -k[\\[Mu]1] k[\\[Mu]2] dX[\\[Mu]1,0,Private`x] dX[\\[Mu]2,0,Private`x] + I k[\\[Mu]3] dX[\\[Mu]3,1,Private`x];\nexpectedExp3 = -I k[\\[Mu]1] k[\\[Mu]2] k[\\[Mu]3] dX[\\[Mu]1,0,Private`x] dX[\\[Mu]2,0,Private`x] dX[\\[Mu]3,0,Private`x] - 3 k[\\[Mu]4] k[\\[Mu]5] dX[\\[Mu]4,0,Private`x] dX[\\[Mu]5,1,Private`x] + I k[\\[Mu]6] dX[\\[Mu]6,2,Private`x];\nexpectedProf2 = der[prof][\\[Mu]1] der[prof][\\[Mu]2] dX[\\[Mu]1,0,Private`x] dX[\\[Mu]2,0,Private`x] + der[prof][\\[Mu]3] dX[\\[Mu]3,1,Private`x];\nexpectedProf3 = der[prof][\\[Mu]1] der[prof][\\[Mu]2] der[prof][\\[Mu]3] dX[\\[Mu]1,0,Private`x] dX[\\[Mu]2,0,Private`x] dX[\\[Mu]3,0,Private`x] + 3 der[prof][\\[Mu]4] der[prof][\\[Mu]5] dX[\\[Mu]4,0,Private`x] dX[\\[Mu]5,1,Private`x] + der[prof][\\[Mu]6] dX[\\[Mu]6,2,Private`x];\nexpectedExp2T = -k[\\[Mu]1] k[\\[Mu]2] dXt[\\[Mu]1,0,Private`x] dXt[\\[Mu]2,0,Private`x] + I k[\\[Mu]3] dXt[\\[Mu]3,1,Private`x];\nexpectedProf2T = der[prof][\\[Mu]1] der[prof][\\[Mu]2] dXt[\\[Mu]1,0,Private`x] dXt[\\[Mu]2,0,Private`x] + der[prof][\\[Mu]3] dXt[\\[Mu]3,1,Private`x];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770589884518,
     "endTime": 1770589884890
    },
    "executionOrder": 34,
    "success": true
   }
