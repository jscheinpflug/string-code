   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test2 = Wick[c[0, z], b[0, w]];\nexpected2 = 1/(z - w);\ntest2Result = Simplify[test2 - expected2] === 0;\nPrint[\"Test 2 (c-b Wick): \", If[test2Result, \"PASSED\", \"FAILED\"]];\ntest2Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 2 (c-b Wick): PASSED\n</pre>",
