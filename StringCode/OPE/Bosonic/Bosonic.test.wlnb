   "value": "test18 = OPE[R[c[0, z]], R[c[0, w], b[0, w]]];\nPrint[\"Test 18 (c with R[c,b]): \", test18 // InputForm];\n(* Check that there's a singular term 1/(w-z) or 1/(z-w) *)\ntest18HasSingular = Not[FreeQ[test18, 1/(w - z)]] || Not[FreeQ[test18, 1/(z - w)]];\nPrint[\"Test 18 has singular term: \", If[test18HasSingular, \"PASSED\", \"FAILED\"]];\ntest18HasSingular",
