   }
  },
  {
   "kind": 2,
   "value": "expr1 = OPE[R[V[0, 0, z1, z1Bar]], R[V[0, 0, z2, z2Bar]]];\ntest1Result = Head[expr1] === OPE;\nPrint[\"Test 1 (OPE V-V stays symbolic): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 1 (OPE V-V stays symbolic): PASSED\n</pre>",
