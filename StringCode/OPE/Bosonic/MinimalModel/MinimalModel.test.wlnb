  {
   "kind": 1,
   "value": "# Bosonic MinimalModel OPE Tests\n\nChecks non-collapsable V-sector behavior for OPE and OPEProjection.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"Bosonic\", \"CFT\" -> \"MinimalModel\", \"conventions\" -> \"Bosonic-Xi\", \"bracket\" -> \"Flat\", \"signature\" -> \"Euclidean\"|>]",
   "languageId": "wolfram",
   "outputs": [],
