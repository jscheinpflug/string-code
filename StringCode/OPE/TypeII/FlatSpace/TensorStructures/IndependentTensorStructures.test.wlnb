{
  "cells": [
    {
      "kind": 1,
      "value": "# TypeII FlatSpace IndependentTensorStructures Tests\n\nExact selector coverage for the public API and the shared gamma-kernel engine.",
      "languageId": "markdown",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[\n  <|\n    \"theory\" -> \"TypeII\",\n    \"CFT\" -> \"FlatSpace\",\n    \"conventions\" -> \"TypeII-Xi\",\n    \"bracket\" -> \"Flat\"\n  |>\n];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`TensorStructures`IndependentTensorStructures`\"];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nbaseSelectorOptions = <|\n  \"RandomSeed\" -> 1234,\n  \"ProbeCount\" -> 5,\n  \"VerificationProbeCount\" -> 3\n|>;\n\nselectorOptionRules[overrides___Rule] := Normal @ Join[baseSelectorOptions, <|overrides|>];\nflattenCandidates[groupList_] := Flatten[groupList, 1];\nbasisSubsetQ[basisList_, candidateList_] := And @@ (MemberQ[candidateList, #] & /@ basisList);\nbasisLength[result_Association] := Length[result[\"Basis\"]];\nselectorCacheCounts[] := <|\n  \"Slice\" -> Total[Length /@ Values[Private`spinProjectionGammaKernelSliceCache]],\n  \"SelectorFamily\" -> Length[Keys[Private`spinProjectionSelectorFamilyCompileCache]],\n  \"Probe\" -> Length[Keys[Private`spinProjectionGammaKernelProbeCache]],\n  \"Pair\" -> Length[Keys[Private`spinProjectionGammaKernelPairMatrixCache]]\n|>;\nclearKernelCaches[] := (\n  Private`spinProjectionGammaKernelSliceCache = <||>;\n  Private`spinProjectionConcreteGammaEntryRulesCache = <||>;\n  Private`spinProjectionGammaKernelProbeCache = <||>;\n  Private`spinProjectionGammaKernelPairMatrixCache = <||>;\n  Private`spinProjectionSelectorFamilyCompileCache = <||>;\n  Private`findIndependentTensorStructuresCanonicalTemplateCache = <||>;\n);",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 1,
      "value": "## Public API",
      "languageId": "markdown",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "apiIncoming1 = <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>;\napiOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiGroups1 = generateTensorStructures[apiIncoming1, apiOutgoing1];\napiFlat1 = flattenCandidates[apiGroups1];\napiAssoc1 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiList1 = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiRankOne = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"TargetRank\" -> 1, \"ReturnStatistics\" -> True]];\napiNested = findIndependentTensorStructures[apiGroups1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiPlain = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[]];\napiIncoming2 = <|\"vector\" -> {}, \"spinor\" -> {{b1, \"chiral\"}, {b2, \"chiral\"}, {b3, \"antichiral\"}, {b4, \"antichiral\"}}|>;\napiOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiAssoc2 = findIndependentTensorStructures[apiIncoming2, apiOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiBadOption = Quiet[findIndependentTensorStructures[apiFlat1, \"ModulusPrimes\" -> {32009}], {findIndependentTensorStructures::badopt}];\napiBadTarget = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> -1], {findIndependentTensorStructures::badtarget}];\napiTooManyOut = Quiet[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {}, \"spinor\" -> {{d1, \"chiral\"}, {d2, \"chiral\"}}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {{d3, \"chiral\"}, {d4, \"antichiral\"}}|>\n  ],\n  {findIndependentTensorStructures::toomanyout}\n];\napiInvalidExplicit = Quiet[findIndependentTensorStructures[{GammaUDHold[muBad]}], {findIndependentTensorStructures::badarg}];\napiUnreachable = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> 20], {findIndependentTensorStructures::targetunmet}];\n\napiTest1 = testReport[\n  \"API Test 1 (scalar/chiral association-list parity)\",\n  Length[apiFlat1] == 15 &&\n    basisLength[apiAssoc1] == 2 && apiAssoc1[\"TargetRank\"] == 2 &&\n    basisLength[apiList1] == 2 && apiList1[\"TargetRank\"] == 2 &&\n    basisSubsetQ[apiAssoc1[\"Basis\"], apiFlat1] && basisSubsetQ[apiList1[\"Basis\"], apiFlat1]\n];\n\napiTest2 = testReport[\n  \"API Test 2 (explicit target rank)\",\n  basisLength[apiRankOne] == 1 && apiRankOne[\"TargetRank\"] == 1 && apiRankOne[\"VisitedCandidates\"] >= 1\n];\n\napiTest3 = testReport[\n  \"API Test 3 (nested normalization and return shape)\",\n  apiNested[\"Basis\"] === apiList1[\"Basis\"] &&\n    apiNested[\"TargetRank\"] == apiList1[\"TargetRank\"] &&\n    ListQ[apiPlain] && Sort[Keys[apiList1]] === {\"Basis\", \"TargetRank\", \"VisitedCandidates\"}\n];\n\napiTest4 = testReport[\n  \"API Test 4 (automatic target inference)\",\n  apiAssoc2[\"TargetRank\"] == 3 && basisLength[apiAssoc2] == 3\n];\n\napiTest5 = testReport[\n  \"API Test 5 (validation failures)\",\n  apiBadOption === $Failed &&\n    apiBadTarget === $Failed &&\n    apiTooManyOut === $Failed &&\n    apiInvalidExplicit === $Failed &&\n    apiUnreachable === $Failed\n];\napiSparseBasis = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnSparseBasis\" -> True]];\napiSparseBasisExprs = Lookup[apiSparseBasis, \"Expr\", {}];\napiBadSparseK = Quiet[findIndependentTensorStructures[apiFlat1, \"SparseProbeKValue\" -> 0], {findIndependentTensorStructures::badoptvalue}];\napiBadSparsePrefix = Quiet[findIndependentTensorStructures[apiFlat1, \"SparseProbePrefixCount\" -> -1], {findIndependentTensorStructures::badoptvalue}];\napiBadDenseFallback = Quiet[findIndependentTensorStructures[apiFlat1, \"DenseFallbackProbeCount\" -> -1], {findIndependentTensorStructures::badoptvalue}];\napiBadReturnSparse = Quiet[findIndependentTensorStructures[apiFlat1, \"ReturnSparseBasis\" -> 7], {findIndependentTensorStructures::badoptvalue}];\napiAntisymAuto = Quiet[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {u1, u2}, \"spinor\" -> {}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {}|>,\n    \"AntisymmetricVectorGroups\" -> {{u1, u2}}\n  ],\n  {findIndependentTensorStructures::antisymtargetauto}\n];\n\napiTest6 = testReport[\n  \"API Test 6 (sparse-basis return shape)\",\n  Length[apiSparseBasis] == basisLength[apiAssoc1] &&\n    apiSparseBasisExprs === apiAssoc1[\"Basis\"] &&\n    AllTrue[\n      apiSparseBasis,\n      Sort[Keys[#]] === {\"CanonicalToActualSpin\", \"CanonicalToActualVector\", \"Expr\", \"SelectorFamilyCache\"} &&\n        AssociationQ[#[\"CanonicalToActualSpin\"]] &&\n        AssociationQ[#[\"CanonicalToActualVector\"]] &&\n        AssociationQ[#[\"SelectorFamilyCache\"]] &\n    ]\n];\n\napiTest7 = testReport[\n  \"API Test 7 (new option validation)\",\n  apiBadSparseK === $Failed &&\n    apiBadSparsePrefix === $Failed &&\n    apiBadDenseFallback === $Failed &&\n    apiBadReturnSparse === $Failed &&\n    apiAntisymAuto === $Failed\n];\n",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 1,
      "value": "## Exact Selector Internals",
      "languageId": "markdown",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "selectorMetadata1 = Private`selectorCandidateMetadata[apiFlat1];\nselectorRuntime1 = Private`selectionRuntimeFromMetadata[\n  selectorMetadata1,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 3, \"VerificationProbeCount\" -> 2|>,\n  3\n];\nselectorAssignmentA = Private`selectorAssignmentAt[selectorRuntime1, 1];\nselectorAssignmentB = Private`selectorAssignmentAt[selectorRuntime1, 1];\nselectorPivot0 = Private`initialPivotState[];\nselectorInsert1 = Private`incrementalPivotInsert[selectorPivot0, {1, 0, 0, 0}];\nselectorInsert2 = Private`incrementalPivotInsert[selectorInsert1[\"State\"], {0, 1, 0, 0}];\nselectorInsert3 = Private`incrementalPivotInsert[selectorInsert2[\"State\"], {1, 1, 0, 0}];\nselectorCompiled1 = Private`selectorCandidates[apiFlat1];\nselectorScanParsed = Private`scanCandidateList[selectorCompiled1, Automatic, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3|>];\nselectorScanRaw = Private`scanRawCandidateList[apiFlat1, Automatic, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3|>];\nselectorZero = Private`spinProjectionNormalizeCompiledTermParts[{{0, {1, 1}, {4, 1}}, {0, {1, 1}, {4, 2}}}];\nselectorSpinorHints1 = AssociationThread[{a1, a2, a3, a4} -> ConstantArray[\"chiral\", 4]];\nselectorParsedGroups1 = Private`selectorParsedCandidateGroups[apiGroups1, selectorSpinorHints1];\nselectorAnnotatedGroups1 = selectorParsedGroups1;\nselectorUnannotatedGroups1 = (KeyDrop[#, {\"Position\", \"GroupIndex\", \"GroupMemberIndex\"}] & /@ #) & /@ selectorParsedGroups1;\nselectorNormalizedAnnotated1 = Private`selectorNormalizedParsedCandidateGroups0[selectorAnnotatedGroups1, selectorSpinorHints1];\nselectorNormalizedUnannotated1 = Private`selectorNormalizedParsedCandidateGroups0[selectorUnannotatedGroups1, selectorSpinorHints1];\nselectorNormalizedRaw1 = Private`selectorNormalizedParsedCandidateGroups0[apiGroups1, selectorSpinorHints1];\nselectorAnnotatedScan1 = Private`scanCandidateList[\n  selectorAnnotatedGroups1,\n  Automatic,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3|>\n];\nsharedSelectorIncoming = <|\"vector\" -> {}, \"spinor\" -> {{s1, \"chiral\"}, {s2, \"chiral\"}, {s3, \"chiral\"}, {s4, \"chiral\"}, {s5, \"chiral\"}}|>;\nsharedSelectorOutgoing = <|\"vector\" -> {}, \"spinor\" -> {{t1, \"chiral\"}}|>;\nsharedSelectorSearchData = <|\"Incoming\" -> sharedSelectorIncoming, \"Outgoing\" -> sharedSelectorOutgoing|>;\nsharedSelectorParsedGroups = Private`associationCandidateTemplate[sharedSelectorSearchData, {}];\nsharedSelectorRuntime = Private`selectionRuntimeWithParsedGroups[\n  sharedSelectorParsedGroups,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 4, \"VerificationProbeCount\" -> 2|>,\n  1\n];\nsharedSelectorGroupRecord = SelectFirst[\n  Values[sharedSelectorRuntime[\"GroupRecords\"]],\n  Lookup[#, \"Mode\", None] === \"SharedKernelGroup\" &,\n  Missing[\"NotFound\"]\n];\nsharedSelectorPairRefPositions = If[\n  sharedSelectorGroupRecord === Missing[\"NotFound\"],\n  {},\n  Flatten @ Position[\n    Private`spinProjectionGammaKernelPairMatrixQ[Private`spinProjectionGammaKernelRegistry[# [\"Key\"]]] & /@ sharedSelectorGroupRecord[\"Compiled\", \"GammaKernelRefs\"],\n    True\n  ]\n];\nsharedSelectorBatchRecord = If[\n  sharedSelectorGroupRecord === Missing[\"NotFound\"] || sharedSelectorPairRefPositions === {},\n  Missing[\"NotFound\"],\n  Join[\n    sharedSelectorGroupRecord,\n    <|\n      \"BatchEligible\" -> True,\n      \"Compiled\" -> Join[\n        sharedSelectorGroupRecord[\"Compiled\"],\n        <|\"GammaKernelRefs\" -> sharedSelectorGroupRecord[\"Compiled\", \"GammaKernelRefs\"][[sharedSelectorPairRefPositions]]|>\n      ],\n      \"VectorTuples\" -> sharedSelectorGroupRecord[\"VectorTuples\"][[sharedSelectorPairRefPositions]],\n      \"UniqueSpinSymbolsByRef\" -> sharedSelectorGroupRecord[\"UniqueSpinSymbolsByRef\"][[sharedSelectorPairRefPositions]],\n      \"MemberPatternIndices\" -> (Part[#, sharedSelectorPairRefPositions] & /@ sharedSelectorGroupRecord[\"MemberPatternIndices\"]),\n      \"Members\" -> Map[\n        Function[member,\n          Join[\n            member,\n            <|\n              \"SpinSymbolsByRef\" -> member[\"SpinSymbolsByRef\"][[sharedSelectorPairRefPositions]],\n              \"PatternIndicesByRef\" -> member[\"PatternIndicesByRef\"][[sharedSelectorPairRefPositions]]\n            |>\n          ]\n        ],\n        sharedSelectorGroupRecord[\"Members\"]\n      ]\n    |>\n  ]\n];\nsharedSelectorAssignments = Table[Private`selectorAssignmentAt[sharedSelectorRuntime, i], {i, 1, 3}];\nsharedSelectorSignatureBlock = If[\n  sharedSelectorBatchRecord === Missing[\"NotFound\"],\n  $Failed,\n  Private`selectorGroupSignatureBlock0[sharedSelectorBatchRecord, sharedSelectorAssignments]\n];\nsharedSelectorReferenceByAssignment = If[\n  sharedSelectorBatchRecord === Missing[\"NotFound\"],\n  $Failed,\n  Private`selectorGroupProbeValuesReference0[sharedSelectorBatchRecord, #] & /@ sharedSelectorAssignments\n];\nsharedSelectorReferenceBlock = If[\n  sharedSelectorReferenceByAssignment === $Failed,\n  $Failed,\n  AssociationThread[\n    sharedSelectorBatchRecord[\"MemberPositions\"],\n    Lookup[sharedSelectorReferenceByAssignment, #] & /@ sharedSelectorBatchRecord[\"MemberPositions\"]\n  ]\n];\n\nselectorTest1 = testReport[\n  \"Selector Test 1 (deterministic exact assignments)\",\n  selectorAssignmentA === selectorAssignmentB &&\n    selectorRuntime1[\"SpinorSymbols\"] === {a1, a2, a3, a4} &&\n    Keys[selectorAssignmentA[\"SpinorComponents\"]] === selectorRuntime1[\"SpinorSymbols\"] &&\n    selectorAssignmentA[\"VectorComponents\"] === <||> &&\n    AllTrue[Values[selectorAssignmentA[\"SpinorComponents\"]], Length[#] == 16 &]\n];\n\nselectorTest2 = testReport[\n  \"Selector Test 2 (incremental exact pivot insertion)\",\n  TrueQ[selectorInsert1[\"RankIncreased\"]] &&\n    TrueQ[selectorInsert2[\"RankIncreased\"]] &&\n    !TrueQ[selectorInsert3[\"RankIncreased\"]] &&\n    selectorInsert2[\"State\"][\"PivotColumns\"] === {1, 2}\n];\n\nselectorTest3 = testReport[\n  \"Selector Test 3 (parsed/raw scan parity)\",\n  selectorScanParsed[\"Basis\"] === selectorScanRaw[\"Basis\"] &&\n    selectorScanParsed[\"TargetRank\"] == selectorScanRaw[\"TargetRank\"] &&\n    selectorScanParsed[\"VisitedCandidates\"] == selectorScanRaw[\"VisitedCandidates\"]\n];\n\nselectorTest4 = testReport[\n  \"Selector Test 4 (contradictory vector equalities vanish)\",\n  selectorZero[\"ScalarFactor\"] == 0 && selectorZero[\"GammaParts\"] === {}\n];\nselectorRuntimeSparse = Private`selectionRuntimeFromMetadata[\n  selectorMetadata1,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 3, \"VerificationProbeCount\" -> 2, \"SparseProbeKValue\" -> 3, \"SparseProbePrefixCount\" -> Automatic, \"DenseFallbackProbeCount\" -> 4|>,\n  2\n];\nselectorSparseAssignment = Private`selectorAssignmentAt[selectorRuntimeSparse, 1];\nselectorDenseAssignment = Private`selectorAssignmentAt[selectorRuntimeSparse, selectorRuntimeSparse[\"SparseProbePrefixCount\"] + 1];\nselectorSparseValues = DeleteDuplicates @ Select[Flatten[Values[selectorSparseAssignment[\"SpinorComponents\"]]], # =!= 0 &];\nselectorScanWithAccepted = Private`scanCandidateList[\n  apiGroups1,\n  2,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3, \"SparseProbeKValue\" -> 4, \"SparseProbePrefixCount\" -> Automatic, \"DenseFallbackProbeCount\" -> 50|>\n];\n\nselectorTest5 = testReport[\n  \"Selector Test 5 (sparse-prefix runtime schedule)\",\n  selectorRuntimeSparse[\"SparseProbeKValue\"] == 3 &&\n    selectorRuntimeSparse[\"SparseProbePrefixCount\"] == 26 &&\n    selectorRuntimeSparse[\"DenseFallbackProbeCount\"] == 4 &&\n    AllTrue[Values[selectorSparseAssignment[\"SpinorComponents\"]], Count[#, _?(# =!= 0 &)] == 3 &] &&\n    AllTrue[selectorSparseValues, MemberQ[{-2, -1, 1, 2}, #] &] &&\n    AllTrue[Values[selectorDenseAssignment[\"SpinorComponents\"]], Count[#, _?(# =!= 0 &)] == 16 &]\n];\n\nselectorTest6 = testReport[\n  \"Selector Test 6 (accepted candidates track basis expressions)\",\n  selectorScanWithAccepted[\"Basis\"] === Lookup[selectorScanWithAccepted[\"AcceptedCandidates\"], \"Expression\"] &&\n    Length[selectorScanWithAccepted[\"AcceptedCandidates\"]] == Length[selectorScanWithAccepted[\"Basis\"]]\n];\n\nselectorTest7 = testReport[\n  \"Selector Test 7 (parsed-group normalization bypasses reparse and preserves positions)\",\n  selectorNormalizedAnnotated1 === selectorAnnotatedGroups1 &&\n    selectorNormalizedUnannotated1 === selectorAnnotatedGroups1 &&\n    selectorNormalizedRaw1 === selectorAnnotatedGroups1 &&\n    selectorAnnotatedScan1[\"Basis\"] === selectorScanRaw[\"Basis\"] &&\n    selectorAnnotatedScan1[\"TargetRank\"] == selectorScanRaw[\"TargetRank\"] &&\n    selectorAnnotatedScan1[\"VisitedCandidates\"] == selectorScanRaw[\"VisitedCandidates\"]\n];\n\nselectorTest8 = testReport[\n  \"Selector Test 8 (shared-kernel batch block matches scalar reference on pair-compatible refs)\",\n  sharedSelectorGroupRecord =!= Missing[\"NotFound\"] &&\n    sharedSelectorPairRefPositions =!= {} &&\n    sharedSelectorSignatureBlock === sharedSelectorReferenceBlock\n];\n\nselectorFiveSpinSeed8 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{u1, \"chiral\"}, {u2, \"chiral\"}, {u3, \"chiral\"}, {u4, \"chiral\"}, {u5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{v1, \"chiral\"}}|>,\n  \"TargetRank\" -> Automatic,\n  \"RandomSeed\" -> 8,\n  \"ProbeCount\" -> 5,\n  \"VerificationProbeCount\" -> 0\n];\n\nselectorTest9 = testReport[\n  \"Selector Test 9 (seed-8 sparse 5S -> S selector run completes)\",\n  AssociationQ[selectorFiveSpinSeed8] && selectorFiveSpinSeed8[\"TargetRank\"] == 16\n];\n",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 1,
      "value": "## Cache And Larger-Channel Smoke Tests",
      "languageId": "markdown",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "clearKernelCaches[];\ncacheBefore = selectorCacheCounts[];\ncacheResult1 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ncacheAfter1 = selectorCacheCounts[];\ncacheResult2 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ncacheAfter2 = selectorCacheCounts[];\n\ndeltaIncoming1 = <|\"vector\" -> {mu1, nu1}, \"spinor\" -> {}|>;\ndeltaOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaGroups1 = generateTensorStructures[deltaIncoming1, deltaOutgoing1];\ndeltaFlat1 = flattenCandidates[deltaGroups1];\ndeltaAssoc1 = findIndependentTensorStructures[deltaIncoming1, deltaOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ndeltaList1 = findIndependentTensorStructures[deltaFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ndeltaIncoming2 = <|\"vector\" -> {mu2, nu2, rho2, sigma2}, \"spinor\" -> {}|>;\ndeltaOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaFlat2 = flattenCandidates[generateTensorStructures[deltaIncoming2, deltaOutgoing2]];\ndeltaAssoc2 = findIndependentTensorStructures[deltaIncoming2, deltaOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ncacheTest1 = testReport[\n  \"Cache Test 1 (repeated selector run reuses family/probe caches)\",\n  cacheBefore === <|\"Slice\" -> 0, \"SelectorFamily\" -> 0, \"Probe\" -> 0, \"Pair\" -> 0|> &&\n    cacheAfter1[\"SelectorFamily\"] > 0 && cacheAfter1[\"Probe\"] > 0 && cacheAfter1[\"Pair\"] > 0 &&\n    cacheAfter2 === cacheAfter1 &&\n    cacheResult1[\"Basis\"] === cacheResult2[\"Basis\"]\n];\n\ndeltaTest1 = testReport[\n  \"Delta Test 1 (2-vector association-list parity)\",\n  deltaGroups1 === {{\\[Delta][mu1, nu1]}} &&\n    deltaAssoc1[\"Basis\"] === {\\[Delta][mu1, nu1]} && deltaAssoc1[\"TargetRank\"] == 1 &&\n    deltaList1[\"Basis\"] === {\\[Delta][mu1, nu1]} && deltaList1[\"TargetRank\"] == 1\n];\n\ndeltaTest2 = testReport[\n  \"Delta Test 2 (4-vector scalar rank)\",\n  Length[deltaFlat2] == 3 &&\n    deltaAssoc2[\"Basis\"] === deltaFlat2 && deltaAssoc2[\"TargetRank\"] == 3\n];\nPrivate`findIndependentTensorStructuresCanonicalTemplateCache = <||>;\ntemplateCacheCountBefore = Length[Keys[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateCacheRun1 = findIndependentTensorStructures[<|\"vector\" -> {tau1, tau2}, \"spinor\" -> {}|>, <|\"vector\" -> {}, \"spinor\" -> {}|>, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ntemplateCacheRecord1 = First[Values[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateRelabelCount1 = Length[Keys[templateCacheRecord1[\"RelabeledParsedCandidateGroups\"]]];\ntemplateCacheRun1Repeat = findIndependentTensorStructures[<|\"vector\" -> {tau1, tau2}, \"spinor\" -> {}|>, <|\"vector\" -> {}, \"spinor\" -> {}|>, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ntemplateCacheRecord1Repeat = First[Values[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateRelabelCount1Repeat = Length[Keys[templateCacheRecord1Repeat[\"RelabeledParsedCandidateGroups\"]]];\ntemplateCacheCountAfter1 = Length[Keys[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateCacheRun2 = findIndependentTensorStructures[<|\"vector\" -> {ups1, ups2}, \"spinor\" -> {}|>, <|\"vector\" -> {}, \"spinor\" -> {}|>, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ntemplateCacheRecord2 = First[Values[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateRelabelCount2 = Length[Keys[templateCacheRecord2[\"RelabeledParsedCandidateGroups\"]]];\ntemplateCacheRun2Repeat = findIndependentTensorStructures[<|\"vector\" -> {ups1, ups2}, \"spinor\" -> {}|>, <|\"vector\" -> {}, \"spinor\" -> {}|>, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ntemplateCacheRecord2Repeat = First[Values[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\ntemplateRelabelCount2Repeat = Length[Keys[templateCacheRecord2Repeat[\"RelabeledParsedCandidateGroups\"]]];\ntemplateCacheCountAfter2 = Length[Keys[Private`findIndependentTensorStructuresCanonicalTemplateCache]];\n\ncacheTest2 = testReport[\n  \"Cache Test 2 (canonical template cache reuses relabeled parsed groups)\",\n  templateCacheCountAfter1 == templateCacheCountBefore + 1 &&\n    templateCacheCountAfter2 == templateCacheCountAfter1 &&\n    AssociationQ[templateCacheRecord1] &&\n    KeyExistsQ[templateCacheRecord1, \"ParsedCandidateGroups\"] &&\n    KeyExistsQ[templateCacheRecord1, \"RelabeledParsedCandidateGroups\"] &&\n    AllTrue[Flatten[templateCacheRecord1[\"ParsedCandidateGroups\"], 1], AssociationQ] &&\n    templateRelabelCount1 == 1 &&\n    templateRelabelCount1Repeat == 1 &&\n    templateRelabelCount2 == 2 &&\n    templateRelabelCount2Repeat == 2 &&\n    templateCacheRun1[\"Basis\"] === {\\[Delta][tau1, tau2]} &&\n    templateCacheRun1Repeat[\"Basis\"] === templateCacheRun1[\"Basis\"] &&\n    templateCacheRun2[\"Basis\"] === {\\[Delta][ups1, ups2]} &&\n    templateCacheRun2Repeat[\"Basis\"] === templateCacheRun2[\"Basis\"]\n];\n",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "Print[\"ALL_TESTS_PASSED: \", allTestsPassed];\nallTestsPassed",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    }
  ],
  "nbformat": 4
}
