{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace TensorStructures Tests\n\nValidation of GammaAntisymmetricProductHold-based tensor structure generation.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];StringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];Needs[\"StringCode`OPE`TypeII`FlatSpace`TensorStructures`\"]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nsizeSignature[groups_] := Length /@ groups;\nfactorList[expr_] := If[Head[expr] === Times, List @@ expr, {expr}];\ngammaProducts[expr_] := Cases[factorList[expr], _GammaAntisymmetricProductHold];\nlegacyHeadFreeQ[expr_] := FreeQ[expr, CGamma | CIGamma | GammaM | Gamma11CGamma | Gamma11CIGamma | Gamma11GammaM | GammaProduct | GammaProductHold | GammaUD | GammaDU | Gamma11UU | Gamma11DD | CUD | CDU];\n\ngammaProductCTag[GammaAntisymmetricProductHold[links_List, _, _]] := If[links =!= {} && MemberQ[{CUDHold, CDUHold}, First[links]], First[links], None];\ngammaProductCTag[_] := $Failed;\n\ngammaProductLinks[GammaAntisymmetricProductHold[links_List, _, _]] := If[links =!= {} && MemberQ[{CUDHold, CDUHold}, First[links]], Rest[links], links];\ngammaProductLinks[_] := {};\n\ngammaProductShapeQ[GammaAntisymmetricProductHold[links_List, _, _]] := Module[{cCount},\n  cCount = Count[links, CUDHold | CDUHold];\n  cCount == 0 || (cCount == 1 && links =!= {} && MemberQ[{CUDHold, CDUHold}, First[links]])\n];\ngammaProductShapeQ[_] := False;\n\ngammaLinksValidQ[gp_] := Module[{links, cTag, firstHead},\n  links = gammaProductLinks[gp];\n  cTag = gammaProductCTag[gp];\n  firstHead = If[links === {}, None, Head[First[links]]];\n  And[\n    gammaProductShapeQ[gp],\n    AllTrue[links, MatchQ[#, GammaUDHold[_] | GammaDUHold[_]] &],\n    AllTrue[Cases[links, GammaUDHold[idx_] | GammaDUHold[idx_] :> idx], AtomQ],\n    If[cTag === CUDHold && links =!= {}, firstHead === GammaDUHold, True],\n    If[cTag === CDUHold && links =!= {}, firstHead === GammaUDHold, True]\n  ]\n];\n\ncontainsDirectHighRankGammaQ[groups_] := AnyTrue[\n  Flatten[groups, 1],\n  Function[expr, AnyTrue[gammaProducts[expr], Length[gammaProductLinks[#]] > 5 &]]\n];\n\nepsFreeQ[groups_] := AllTrue[Flatten[groups, 1], FreeQ[#, _Eps10] &];\ngamma11FreeQ[groups_] := AllTrue[Flatten[groups, 1], FreeQ[#, Gamma11UUHold[] | Gamma11DDHold[]] &];\n\n(* Example 1: psi^mu S^alpha -> S_beta *)\nex1 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest1 = testReport[\"Test 1 (psi S -> S)\", ex1 === {{GammaAntisymmetricProductHold[{GammaUDHold[mu]}, alpha, beta]}}];\n\n(* Example 2: S^alpha S^beta -> psi^mu (incoming same-chiral uses CUDHold) *)\nex2 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {}|>\n];\ntest2 = testReport[\"Test 2 (S S -> psi uses CUDHold)\", ex2 === {{GammaAntisymmetricProductHold[{CUDHold, GammaDUHold[mu]}, alpha, beta]}}];\n\n(* Example 3: 3S^alpha -> S_beta *)\nex3 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a4, \"antichiral\"}}|>\n];\ntest3 = testReport[\"Test 3 (3S -> Sbar counts)\", Length[ex3] == 3 && Sort[sizeSignature[ex3]] === {3, 3, 3}];\n\n(* Example 4: 5S^alpha -> S^alpha *)\nex4 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>\n];\nex4Sizes = sizeSignature[ex4];\ntest4 = testReport[\"Test 4 (5S -> S size classes)\", Length[ex4] == 25 && AllTrue[ex4Sizes, MemberQ[{15, 30}, #] &] && Count[ex4Sizes, 15] > 0 && Count[ex4Sizes, 30] > 0];\n\n(* Example 5: S^alpha S_beta -> scalar *)\nex5 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest5 = testReport[\"Test 5 (mixed to scalar)\", ex5 === {{GammaAntisymmetricProductHold[{}, alpha, beta]}}];\n\n(* Example 6: psi psi S -> Sbar, empty *)\nex6 = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest6 = testReport[\"Test 6 (psi psi S -> Sbar empty)\", ex6 === {}];\n\n(* Example 7: S^alpha S_beta S^gamma -> S_delta *)\nex7 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}, {gamma, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{delta, \"antichiral\"}}|>\n];\ntest7 = testReport[\"Test 7 (mixed 3->1 now empty)\", ex7 === {}];\n\n(* Example 8: psi^mu S^alpha S_beta -> psi^nu *)\nex8 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {}|>\n];\ntest8 = testReport[\n  \"Test 8 (vector in+out mixed)\",\n  ex8 === {\n    {GammaAntisymmetricProductHold[{}, alpha, beta] * \\[Delta][mu, nu]},\n    {GammaAntisymmetricProductHold[{GammaUDHold[mu], GammaDUHold[nu]}, alpha, beta]}\n  }\n];\n\n(* Example 9: S^alpha S^beta S_gamma S_delta -> scalar *)\nex9 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}, {gamma, \"antichiral\"}, {delta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nex9Sizes = sizeSignature[ex9];\ntest9 = testReport[\"Test 9 (4-spinor scalar groups)\", Length[ex9] == 11 && Count[ex9Sizes, 2] == 6 && Count[ex9Sizes, 1] == 5];\n\n(* Example 10: psi^mu S^alpha -> psi^nu S_beta, empty *)\nex10 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest10 = testReport[\"Test 10 (psi S -> psi Sbar empty)\", ex10 === {}];\n\n(* Example 11: psi^mu S^alpha -> psi^nu S^beta *)\nex11 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"chiral\"}}|>\n];\ntest11 = testReport[\n  \"Test 11 (psi S -> psi S)\",\n  ex11 === {\n    {GammaAntisymmetricProductHold[{}, beta, alpha] * \\[Delta][mu, nu]},\n    {GammaAntisymmetricProductHold[{GammaUDHold[mu], GammaDUHold[nu]}, beta, alpha]}\n  }\n];\n\n(* Outgoing-slot flip mapping checks for all chirality pairings *)\noutA = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\noutB = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutC = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutD = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\n\ntest12 = testReport[\n  \"Test 12 (outgoing flip mapping)\",\n  outA === {{GammaAntisymmetricProductHold[{GammaUDHold[mu]}, x, y]}} &&\n  outB === {{GammaAntisymmetricProductHold[{GammaDUHold[mu]}, x, y]}} &&\n  outC === {\n    {GammaAntisymmetricProductHold[{}, y, x] * \\[Delta][mu, nu]},\n    {GammaAntisymmetricProductHold[{GammaUDHold[mu], GammaDUHold[nu]}, y, x]}\n  } &&\n  outD === {\n    {GammaAntisymmetricProductHold[{}, y, x] * \\[Delta][mu, nu]},\n    {GammaAntisymmetricProductHold[{GammaUDHold[mu], GammaDUHold[nu]}, y, x]}\n  }\n];\n\n(* Antichiral same-chirality incoming pair uses CDUHold with flipped first link *)\nex13 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a, \"antichiral\"}, {b, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest13 = testReport[\"Test 13 (Sbar Sbar -> scalar uses CDUHold)\", ex13 === {{GammaAntisymmetricProductHold[{CDUHold, GammaUDHold[mu]}, a, b]}}];\n\nallGroups = Join[ex1, ex2, ex3, ex4, ex5, ex8, ex9, ex11, ex13];\ntest14 = testReport[\n  \"Test 14 (new gamma grammar only)\",\n  AllTrue[\n    Flatten[allGroups, 1],\n    Function[expr, legacyHeadFreeQ[expr] && AllTrue[gammaProducts[expr], gammaLinksValidQ]]\n  ]\n];\n\ntest15 = testReport[\"Test 15 (no Gamma11 in generated structures)\", gamma11FreeQ[ex4] && gamma11FreeQ[ex9]];\n\ntest16 = testReport[\n  \"Test 16 (direct high-rank gamma replaces Eps10)\",\n  epsFreeQ[ex4] && epsFreeQ[ex9] && (containsDirectHighRankGammaQ[ex4] || containsDirectHighRankGammaQ[ex9])\n];\n\n(* Feedback example check: outgoing factor untouched, incoming same-chiral factors use CUDHold and start with DU *)\nrepEx4 = Flatten[generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>,\n  \"RepresentativesOnly\" -> True\n], 1];\n\ntest17 = testReport[\n  \"Test 17 (feedback CUDHold placement)\",\n  AnyTrue[\n    repEx4,\n    Function[expr,\n      Count[factorList[expr], GammaAntisymmetricProductHold[{}, a6, a1]] >= 1 &&\n      Count[factorList[expr], GammaAntisymmetricProductHold[{CUDHold, GammaDUHold[_]}, a2, a3]] >= 1 &&\n      Count[factorList[expr], GammaAntisymmetricProductHold[{CUDHold, GammaDUHold[_]}, a4, a5]] >= 1\n    ]\n  ]\n];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Delta Tensor Structure Tests",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "deltaPure2 = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest18 = testReport[\"Test 18 (2-vector scalar delta)\", deltaPure2 === {{\\[Delta][mu, nu]}}];\n\ndeltaPure4 = generateTensorStructures[\n  <|\"vector\" -> {mu, nu, rho, sigma}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest19 = testReport[\n  \"Test 19 (4-vector scalar delta pairings)\",\n  deltaPure4 === {{\n    \\[Delta][mu, nu] * \\[Delta][rho, sigma],\n    \\[Delta][mu, rho] * \\[Delta][nu, sigma],\n    \\[Delta][mu, sigma] * \\[Delta][nu, rho]\n  }}\n];\n\ndeltaMixedScalar = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest20 = testReport[\n  \"Test 20 (mixed scalar gamma plus delta)\",\n  deltaMixedScalar === {\n    {GammaAntisymmetricProductHold[{}, alpha, beta] * \\[Delta][mu, nu]},\n    {GammaAntisymmetricProductHold[{GammaUDHold[mu], GammaDUHold[nu]}, alpha, beta]}\n  }\n];\n\ndeltaOddPure = generateTensorStructures[\n  <|\"vector\" -> {mu, nu, rho}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest21 = testReport[\"Test 21 (odd pure-vector vanishing)\", deltaOddPure === {}];\n\ndeltaPure4Rep = Flatten[generateTensorStructures[\n  <|\"vector\" -> {mu, nu, rho, sigma}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RepresentativesOnly\" -> True\n], 1];\ntest22 = testReport[\n  \"Test 22 (pure-vector representative selection)\",\n  deltaPure4Rep === {\\[Delta][mu, nu] * \\[Delta][rho, sigma]}\n];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "metadata": {
  "version": "1.0.0"
 }
}
