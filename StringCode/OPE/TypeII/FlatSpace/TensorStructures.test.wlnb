{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace TensorStructures Tests\n\nValidation of GammaProduct-based tensor structure generation.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];StringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];Needs[\"StringCode`OPE`TypeII`FlatSpace`TensorStructures`\"]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nsizeSignature[groups_] := Length /@ groups;\nfactorList[expr_] := If[Head[expr] === Times, List @@ expr, {expr}];\ngammaProducts[expr_] := Cases[factorList[expr], _GammaProduct];\nlegacyHeadFreeQ[expr_] := FreeQ[expr, CGamma | CIGamma | GammaM | Gamma11CGamma | Gamma11CIGamma | Gamma11GammaM];\n\ngammaProductCTag[GammaProduct[links_List, _, _]] := If[links =!= {} && MemberQ[{CUD, CDU}, First[links]], First[links], None];\ngammaProductCTag[_] := $Failed;\n\ngammaProductLinks[GammaProduct[links_List, _, _]] := If[links =!= {} && MemberQ[{CUD, CDU}, First[links]], Rest[links], links];\ngammaProductLinks[_] := {};\n\ngammaProductShapeQ[GammaProduct[links_List, _, _]] := Module[{cCount},\n  cCount = Count[links, CUD | CDU];\n  cCount == 0 || (cCount == 1 && links =!= {} && MemberQ[{CUD, CDU}, First[links]])\n];\ngammaProductShapeQ[_] := False;\n\ngammaLinksValidQ[gp_] := Module[{links, cTag, firstHead},\n  links = gammaProductLinks[gp];\n  cTag = gammaProductCTag[gp];\n  firstHead = If[links === {}, None, Head[First[links]]];\n  And[\n    gammaProductShapeQ[gp],\n    AllTrue[links, MatchQ[#, GammaUD[_] | GammaDU[_] | Gamma11UU[] | Gamma11DD[]] &],\n    AllTrue[Cases[links, GammaUD[idx_] | GammaDU[idx_] :> idx], AtomQ],\n    Count[links, Gamma11UU[] | Gamma11DD[]] <= 1,\n    If[MemberQ[links, Gamma11UU[] | Gamma11DD[]], MatchQ[Last[links], Gamma11UU[] | Gamma11DD[]], True],\n    If[cTag === CUD && links =!= {}, firstHead === GammaDU, True],\n    If[cTag === CDU && links =!= {}, firstHead === GammaUD, True]\n  ]\n];\n\ngammaProductLinksWithoutTail[gp_] := Module[{links = gammaProductLinks[gp]},\n  If[links === {}, {}, If[MatchQ[Last[links], Gamma11UU[] | Gamma11DD[]], Most[links], links]]\n];\n\nfinalIndexTypeFromLinks[links_List] := Module[{state},\n  state = Which[\n    links === {}, \"U\",\n    Head[First[links]] === GammaDU, \"D\",\n    Head[First[links]] === Gamma11DD, \"D\",\n    True, \"U\"\n  ];\n  Scan[(If[MatchQ[#, GammaUD[_] | GammaDU[_]], state = If[state === \"U\", \"D\", \"U\"]]) &, links];\n  state\n];\n\ngamma11TailConsistentQ[gp_] := Module[{links},\n  links = gammaProductLinks[gp];\n  If[\n    links === {},\n    True,\n    If[\n      MatchQ[Last[links], Gamma11UU[] | Gamma11DD[]],\n      If[finalIndexTypeFromLinks[Most[links]] === \"U\", Last[links] === Gamma11UU[], Last[links] === Gamma11DD[]],\n      True\n    ]\n  ]\n];\n\ncontainsEps10Q[groups_] := AnyTrue[Flatten[groups, 1], !FreeQ[#, _Eps10] &];\n\n(* Example 1: psi^mu S^alpha -> S_beta *)\nex1 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest1 = testReport[\"Test 1 (psi S -> S)\", ex1 === {{GammaProduct[{GammaUD[mu]}, alpha, beta]}}];\n\n(* Example 2: S^alpha S^beta -> psi^mu (incoming same-chiral uses CUD) *)\nex2 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {}|>\n];\ntest2 = testReport[\"Test 2 (S S -> psi uses CUD)\", ex2 === {{GammaProduct[{CUD, GammaDU[mu]}, alpha, beta]}}];\n\n(* Example 3: 3S^alpha -> S_beta *)\nex3 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a4, \"antichiral\"}}|>\n];\ntest3 = testReport[\"Test 3 (3S -> Sbar counts)\", Length[ex3] == 3 && Sort[sizeSignature[ex3]] === {3, 3, 3}];\n\n(* Example 4: 5S^alpha -> S^alpha *)\nex4 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>\n];\nex4Sizes = sizeSignature[ex4];\ntest4 = testReport[\"Test 4 (5S -> S size classes)\", Length[ex4] == 25 && AllTrue[ex4Sizes, MemberQ[{15, 30}, #] &] && Count[ex4Sizes, 15] > 0 && Count[ex4Sizes, 30] > 0];\n\n(* Example 5: S^alpha S_beta -> scalar *)\nex5 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest5 = testReport[\"Test 5 (mixed to scalar)\", ex5 === {{GammaProduct[{}, alpha, beta]}}];\n\n(* Example 6: psi psi S -> Sbar, empty *)\nex6 = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest6 = testReport[\"Test 6 (psi psi S -> Sbar empty)\", ex6 === {}];\n\n(* Example 7: S^alpha S_beta S^gamma -> S_delta *)\nex7 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}, {gamma, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{delta, \"antichiral\"}}|>\n];\ntest7 = testReport[\"Test 7 (mixed 3->1 now empty)\", ex7 === {}];\n\n(* Example 8: psi^mu S^alpha S_beta -> psi^nu *)\nex8 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {}|>\n];\ntest8 = testReport[\"Test 8 (vector in+out mixed)\", ex8 === {{GammaProduct[{GammaUD[mu], GammaDU[nu]}, alpha, beta]}}];\n\n(* Example 9: S^alpha S^beta S_gamma S_delta -> scalar *)\nex9 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}, {gamma, \"antichiral\"}, {delta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nex9Sizes = sizeSignature[ex9];\ntest9 = testReport[\"Test 9 (4-spinor scalar groups)\", Length[ex9] == 11 && Count[ex9Sizes, 2] == 6 && Count[ex9Sizes, 1] == 5];\n\n(* Example 10: psi^mu S^alpha -> psi^nu S_beta, empty *)\nex10 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest10 = testReport[\"Test 10 (psi S -> psi Sbar empty)\", ex10 === {}];\n\n(* Example 11: psi^mu S^alpha -> psi^nu S^beta *)\nex11 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"chiral\"}}|>\n];\ntest11 = testReport[\"Test 11 (psi S -> psi S)\", ex11 === {{GammaProduct[{GammaUD[mu], GammaDU[nu]}, beta, alpha]}}];\n\n(* Outgoing-slot flip mapping checks for all chirality pairings *)\noutA = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\noutB = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutC = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutD = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\n\ntest12 = testReport[\n  \"Test 12 (outgoing flip mapping)\",\n  outA === {{GammaProduct[{GammaUD[mu]}, x, y]}} &&\n  outB === {{GammaProduct[{GammaDU[mu]}, x, y]}} &&\n  outC === {{GammaProduct[{GammaUD[mu], GammaDU[nu]}, y, x]}} &&\n  outD === {{GammaProduct[{GammaUD[mu], GammaDU[nu]}, y, x]}}\n];\n\n(* Antichiral same-chirality incoming pair uses CDU with flipped first link *)\nex13 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a, \"antichiral\"}, {b, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest13 = testReport[\"Test 13 (Sbar Sbar -> scalar uses CDU)\", ex13 === {{GammaProduct[{CDU, GammaUD[mu]}, a, b]}}];\n\nallGroups = Join[ex1, ex2, ex3, ex4, ex5, ex8, ex9, ex11, ex13];\ntest14 = testReport[\n  \"Test 14 (new gamma grammar only)\",\n  AllTrue[\n    Flatten[allGroups, 1],\n    Function[expr, legacyHeadFreeQ[expr] && AllTrue[gammaProducts[expr], gammaLinksValidQ]]\n  ]\n];\n\ntest15 = testReport[\n  \"Test 15 (Gamma11 tail rule)\",\n  AllTrue[\n    Flatten[Join[ex4, ex9], 1],\n    Function[expr, AllTrue[gammaProducts[expr], gamma11TailConsistentQ]]\n  ]\n];\n\ntest16 = testReport[\"Test 16 (explicit Eps10 appears in dualized structures)\", containsEps10Q[ex4] || containsEps10Q[ex9]];\n\n(* Feedback example check: outgoing factor untouched, incoming same-chiral factors use CUD and start with DU *)\nrepEx4 = Flatten[generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>,\n  \"RepresentativesOnly\" -> True\n], 1];\n\ntest17 = testReport[\n  \"Test 17 (feedback CUD placement)\",\n  AnyTrue[\n    repEx4,\n    Function[expr,\n      Count[factorList[expr], GammaProduct[{}, a6, a1]] >= 1 &&\n      Count[factorList[expr], GammaProduct[{CUD, GammaDU[_]}, a2, a3]] >= 1 &&\n      Count[factorList[expr], GammaProduct[{CUD, GammaDU[_]}, a4, a5]] >= 1\n    ]\n  ]\n];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "metadata": {
  "version": "1.0.0"
 }
}
