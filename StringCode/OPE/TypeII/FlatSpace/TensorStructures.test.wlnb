{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace TensorStructures Tests\n\nTests for outgoing-slot flip rules, parity-by-head constraints, and explicit Eps10 dualization factors.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`TensorStructures`\"]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nsizeSignature[groups_] := Length /@ groups;\n\n$GammaHeads = {CGamma, CIGamma, GammaM, Gamma11CGamma, Gamma11CIGamma, Gamma11GammaM};\n$OddRankHeads = {CGamma, CIGamma, Gamma11CGamma, Gamma11CIGamma};\n$EvenRankHeads = {GammaM, Gamma11GammaM};\n$Gamma11Heads = {Gamma11CGamma, Gamma11CIGamma, Gamma11GammaM};\n\nfactorList[expr_] := Module[{factors},\n  factors = If[Head[expr] === Times, List @@ expr, {expr}];\n  Select[factors, MemberQ[$GammaHeads, Head[#]] &]\n];\n\ngroupHeadSet[groups_] := Sort @ DeleteDuplicates @ Flatten[(Head /@ factorList[#]) & /@ Flatten[groups, 1]];\n\nparityOKQ[expr_] := AllTrue[\n  factorList[expr],\n  Function[f,\n    If[MemberQ[$OddRankHeads, Head[f]], OddQ[Length[f[[1]]]], EvenQ[Length[f[[1]]]]]\n  ]\n];\n\ncontainsOutgoingGamma11Q[expr_, outgoingSym_] := AnyTrue[\n  factorList[expr],\n  MemberQ[$Gamma11Heads, Head[#]] && MemberQ[{#[[2]], #[[3]]}, outgoingSym] &\n];\n\ncontainsEps10Q[groups_] := AnyTrue[Flatten[groups, 1], !FreeQ[#, _Eps10] &];\n\n(* Example 1: psi^mu S^alpha -> S_beta *)\nex1 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest1 = testReport[\"Test 1 (psi S -> S)\", ex1 === {{CGamma[{mu}, alpha, beta]}}];\n\n(* Example 2: S^alpha S^beta -> psi^mu *)\nex2 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {}|>\n];\ntest2 = testReport[\"Test 2 (S S -> psi)\", ex2 === {{CGamma[{mu}, alpha, beta]}}];\n\n(* Example 3: 3S^alpha -> S_beta *)\nex3 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a4, \"antichiral\"}}|>\n];\ntest3 = testReport[\"Test 3 (3S -> Sbar counts)\", Length[ex3] == 3 && Sort[sizeSignature[ex3]] === {3, 3, 3}];\n\n(* Example 4: 5S^alpha -> S^alpha *)\nex4 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>\n];\nex4Sizes = sizeSignature[ex4];\ntest4 = testReport[\"Test 4 (5S -> S size classes)\", Length[ex4] == 25 && AllTrue[ex4Sizes, MemberQ[{15, 30}, #] &] && Count[ex4Sizes, 15] > 0 && Count[ex4Sizes, 30] > 0];\n\n(* Example 5: S^alpha S_beta -> scalar *)\nex5 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\ntest5 = testReport[\"Test 5 (mixed to scalar)\", ex5 === {{GammaM[{}, alpha, beta]}}];\n\n(* Example 6: psi psi S -> Sbar, empty *)\nex6 = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest6 = testReport[\"Test 6 (psi psi S -> Sbar empty)\", ex6 === {}];\n\n(* Example 7: S^alpha S_beta S^gamma -> S_delta *)\nex7 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}, {gamma, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{delta, \"antichiral\"}}|>\n];\ntest7 = testReport[\"Test 7 (mixed 3->1 now empty)\", ex7 === {}];\n\n(* Example 8: psi^mu S^alpha S_beta -> psi^nu *)\nex8 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {}|>\n];\ntest8 = testReport[\"Test 8 (vector in+out mixed)\", ex8 === {{GammaM[{mu, nu}, alpha, beta]}}];\n\n(* Example 9: S^alpha S^beta S_gamma S_delta -> scalar *)\nex9 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"chiral\"}, {gamma, \"antichiral\"}, {delta, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nex9Sizes = sizeSignature[ex9];\ntest9 = testReport[\"Test 9 (4-spinor scalar groups)\", Length[ex9] == 11 && Count[ex9Sizes, 2] == 6 && Count[ex9Sizes, 1] == 5];\n\n(* Example 10: psi^mu S^alpha -> psi^nu S_beta, empty *)\nex10 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"antichiral\"}}|>\n];\ntest10 = testReport[\"Test 10 (psi S -> psi Sbar empty)\", ex10 === {}];\n\n(* Example 11: psi^mu S^alpha -> psi^nu S^beta *)\nex11 = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{alpha, \"chiral\"}}|>,\n  <|\"vector\" -> {nu}, \"spinor\" -> {{beta, \"chiral\"}}|>\n];\ntest11 = testReport[\"Test 11 (psi S -> psi S)\", ex11 === {{GammaM[{mu, nu}, beta, alpha]}}];\n\n(* Outgoing-slot flip mapping checks for all chirality pairings *)\noutA = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\noutB = generateTensorStructures[\n  <|\"vector\" -> {mu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutC = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"chiral\"}}|>\n];\noutD = generateTensorStructures[\n  <|\"vector\" -> {mu, nu}, \"spinor\" -> {{x, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{y, \"antichiral\"}}|>\n];\n\ntest12 = testReport[\n  \"Test 12 (outgoing flip mapping)\",\n  outA === {{CGamma[{mu}, x, y]}} &&\n  outB === {{CIGamma[{mu}, x, y]}} &&\n  outC === {{GammaM[{mu, nu}, y, x]}} &&\n  outD === {{GammaM[{mu, nu}, y, x]}}\n];\n\nallGroups = Join[ex1, ex2, ex3, ex4, ex5, ex8, ex9, ex11];\ntest13 = testReport[\"Test 13 (global parity by emitted head)\", AllTrue[Flatten[allGroups, 1], parityOKQ]];\n\ntest14 = testReport[\n  \"Test 14 (no outgoing Gamma11 factors)\",\n  AllTrue[Flatten[ex1, 1], !containsOutgoingGamma11Q[#, beta] &] &&\n  AllTrue[Flatten[ex3, 1], !containsOutgoingGamma11Q[#, a4] &] &&\n  AllTrue[Flatten[ex4, 1], !containsOutgoingGamma11Q[#, a6] &] &&\n  AllTrue[Flatten[ex11, 1], !containsOutgoingGamma11Q[#, beta] &]\n];\n\ntest15 = testReport[\"Test 15 (explicit Eps10 appears in dualized structures)\", containsEps10Q[ex4] || containsEps10Q[ex9]];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "metadata": {
  "version": "1.0.0"
 }
}
