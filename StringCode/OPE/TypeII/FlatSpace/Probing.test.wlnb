{
  "cells": [
    {
      "kind": 1,
      "value": "# TypeII FlatSpace internal probes\n\nInternal artifact/solver contract checks for projected spin-field OPE.",
      "languageId": "markdown",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Xi\", \"bracket\" -> \"Flat\"|>];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`SpinProjection`TestSupport`\"];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[Not[TrueQ[cond]], allTestsPassed = False];\n  cond\n];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "spinProbeBasis[chirality_String] := Private`spinProjectionSpinBasisState[chirality];\n\nprobeSpinIndex[spin_List] := Module[{pos},\n  pos = FirstPosition[spinProbeBasis[\"chiral\"], spin, Missing[\"NotFound\"], {1}, Heads -> False];\n  If[pos =!= Missing[\"NotFound\"], Return[First[pos]]];\n  pos = FirstPosition[spinProbeBasis[\"antichiral\"], spin, Missing[\"NotFound\"], {1}, Heads -> False];\n  If[pos =!= Missing[\"NotFound\"], Return[First[pos]]];\n  $Failed\n];\nprobeSpinIndex[x_] := x;\n\nprobeEvaluateTensorScalars = Private`spinProjectionEvaluateTensorScalars0;\nprobeEvaluateSummedTensorScalars = Private`spinProjectionEvaluateSummedTensorScalars0;",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "mixedGammaRegression1 = Module[{actual, expected},\n  actual = Normal @ Private`spinProjectionGammaFactorMatrix[{GammaDUHold[4], GammaUDHold[7]}];\n  expected = Normal @ (1/2 (GammaDUSparse[4].GammaUDSparse[7] - GammaDUSparse[7].GammaUDSparse[4]));\n  AllTrue[Flatten[Simplify[actual - expected]], PossibleZeroQ]\n];\n\nmixedGammaRegression2 = Module[{actual, expected},\n  actual = Normal @ Private`spinProjectionGammaFactorMatrix[{GammaUDHold[4], GammaDUHold[7]}];\n  expected = Normal @ (1/2 (GammaUDSparse[4].GammaDUSparse[7] - GammaUDSparse[7].GammaDUSparse[4]));\n  AllTrue[Flatten[Simplify[actual - expected]], PossibleZeroQ]\n];\n\ntest1 = testReport[\n  \"Probe Test 1 (mixed rank-2 gamma antisymmetrization keeps U/D pattern)\",\n  mixedGammaRegression1 && mixedGammaRegression2\n];\n\nprobeTrace1 = Module[{ops, artifacts, artifact, candidate, lhsAssoc, trace},\n  ops = {\n    R[S[{a1, \"antichiral\"}, -1/2, {{mu, -1}}, 0, z1]],\n    R[exp\\[Phi]f[-1, z2], \\[Psi][nu, 0, z2]]\n  };\n  artifacts = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Compile`buildProjectedArtifacts[ops, 1, 0, 1234];\n  artifact = artifacts[\"Holo\"];\n  candidate = {Developer`ToPackedArray[{10}], Developer`ToPackedArray[{4, 7}]};\n  lhsAssoc = Private`spinProjectionOperatorAssociation @ Expand @ Private`spinProjectionSectorEvaluation[\n    \"Holo\",\n    1,\n    Bosonize /@ {\n      R[S[{{1/2, -1/2, 1/2, -1/2, -1/2}, \"antichiral\"}, -1/2, {{4, -1}}, 0, z1]],\n      R[exp\\[Phi]f[-1, z2], \\[Psi][7, 0, z2]]\n    }\n  ];\n  trace = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Solve`traceSectorArtifact[artifact, candidate, 1234];\n  <|\n    \"LHSAssoc\" -> lhsAssoc,\n    \"Trace\" -> trace[\"Trace\"],\n    \"Exhaustive\" -> trace[\"Exhaustive\"]\n  |>\n];\n\ntest2 = testReport[\n  \"Probe Test 2 ([1,0] solver trace diagnostics run)\",\n  AssociationQ[probeTrace1] &&\n    AssociationQ[probeTrace1[\"LHSAssoc\"]] &&\n    AssociationQ[probeTrace1[\"Trace\"]] &&\n    AssociationQ[probeTrace1[\"Exhaustive\"]] &&\n    Length[probeTrace1[\"Trace\", \"Families\"]] == 1\n];\n\ntest3 = testReport[\n  \"Probe Test 3 ([1,0] bad sample yields nonzero compiled rows)\",\n  probeTrace1[\"Trace\", \"Families\"][[1, \"NonzeroStateRows\"]] =!= <||> &&\n    probeTrace1[\"Exhaustive\", \"StateRows\"] =!= <||>\n];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "fiveSpinOps = {\n  R[S[{a1, \"chiral\"}, -1/2, {}, 0, z1]],\n  R[S[{a2, \"chiral\"}, -1/2, {}, 0, z2]],\n  R[S[{a3, \"chiral\"}, -1/2, {}, 0, z3]],\n  R[S[{a4, \"chiral\"}, -1/2, {}, 0, z4]],\n  R[S[{a5, \"chiral\"}, -1/2, {}, 0, z5]]\n};\n\nfiveSpinArtifacts = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Compile`buildProjectedArtifacts[fiveSpinOps, 0, 0, 1234];\nfiveSpinArtifact = fiveSpinArtifacts[\"Holo\"];\nfiveSpinSolveData = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Solve`solveSectorArtifact[fiveSpinArtifact, 1234];\nfiveSpinSolveDataAlt = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Solve`solveSectorArtifact[fiveSpinArtifact, 4321];\n\nfiveSpinTermWitnesses = {\n  <|\"Name\" -> \"W1\", \"FreeSpins\" -> {13, 1, 15, 6, 5}, \"StateSpins\" -> {{1/2, -1/2, 1/2, 1/2, -1/2}}, \"Key\" -> R[expH[{-5/2, 1/2, -1/2, 1/2, 1/2, -1/2}, 0]]|>,\n  <|\"Name\" -> \"W2\", \"FreeSpins\" -> {3, 12, 9, 6, 11}, \"StateSpins\" -> {{1/2, -1/2, 1/2, -1/2, 1/2}}, \"Key\" -> R[expH[{-5/2, 1/2, -1/2, 1/2, -1/2, 1/2}, 0]]|>,\n  <|\"Name\" -> \"W3\", \"FreeSpins\" -> {15, 13, 1, 2, 6}, \"StateSpins\" -> {{1/2, 1/2, 1/2, -1/2, -1/2}}, \"Key\" -> R[expH[{-5/2, 1/2, 1/2, 1/2, -1/2, -1/2}, 0]]|>\n};\n\nfiveSpinTermFaithfulness = spinProjectionColumnFaithfulnessCheck[fiveSpinArtifact, fiveSpinTermWitnesses];\n\nfiveSpinTermColumns = Lookup[Flatten[fiveSpinArtifact[\"Families\"][[All, \"Terms\"]], 1], \"Column\", {}];\nfiveSpinSemantic = Private`spinProjectionSemanticCaseCheck0[fiveSpinOps, 0, 0, 1234];\n\ntest9a = testReport[\"Probe Test 9a (five-spin symbolic columns match compiled columns on three fixed witnesses)\", AllTrue[fiveSpinTermFaithfulness, TrueQ[Lookup[#, \"MatchQ\", False]] &]];\n\ntest9b = testReport[\n  \"Probe Test 9b (five-spin artifact contract)\",\n  fiveSpinArtifact[\"Mode\"] === \"SpinProjection\" &&\n    fiveSpinArtifact[\"VarCount\"] === Length[fiveSpinArtifact[\"Columns\"]] &&\n    fiveSpinTermColumns =!= {} &&\n    Min[fiveSpinTermColumns] >= 1 &&\n    Max[fiveSpinTermColumns] <= fiveSpinArtifact[\"VarCount\"]\n];\n\ntest9 = testReport[\n  \"Probe Test 9 (five-spin compiled search reaches full rank)\",\n  TrueQ[fiveSpinSolveData[\"CompleteQ\"]] &&\n    fiveSpinSolveData[\"Pivots\"] === Range[fiveSpinArtifact[\"VarCount\"]]\n];\n\ntest13 = testReport[\n  \"Probe Test 13 (solveSectorArtifact result contract)\",\n  AssociationQ[fiveSpinSolveData] &&\n    KeyExistsQ[fiveSpinSolveData, \"CoeffVector\"] &&\n    KeyExistsQ[fiveSpinSolveData, \"Pivots\"] &&\n    KeyExistsQ[fiveSpinSolveData, \"VisitedCandidates\"] &&\n    KeyExistsQ[fiveSpinSolveData, \"AcceptedCandidates\"] &&\n    KeyExistsQ[fiveSpinSolveData, \"AcceptedRows\"]\n];\n\ntest13b = testReport[\n  \"Probe Test 13b (seed-invariance for artifact solve)\",\n  fiveSpinSolveData[\"Pivots\"] === fiveSpinSolveDataAlt[\"Pivots\"] &&\n    And @@ MapThread[TrueQ[Simplify[#1 == #2]] &, {fiveSpinSolveData[\"CoeffVector\"], fiveSpinSolveDataAlt[\"CoeffVector\"]}]\n];\n\ntest13c = testReport[\n  \"Probe Test 13c (five-spin semantic reconstruction)\",\n  TrueQ[Lookup[fiveSpinSemantic, \"CompleteQ\", False]]\n];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "supportOps17 = {\n  R[exp\\[Phi]f[-1, z], \\[Psi][mu, 0, z]],\n  R[S[{alpha, \"chiral\"}, -1/2, {}, 0, w]]\n};\nsupportArtifact17 = StringCode`OPE`TypeII`FlatSpace`SpinProjection`Compile`buildProjectedArtifacts[supportOps17, 1, 0, 1234][\"Holo\"];\nsupportFamily17 = First[supportArtifact17[\"Families\"]];\nsupportNext17 = Private`spinProjectionAssignmentIterator[supportArtifact17, 1234];\nsupportCandidate17 = supportNext17[];\nsupportDomain17 = Private`spinProjectionFamilyOutputSpinDomain[supportFamily17, supportCandidate17, 1234];\n\ntest17 = testReport[\n  \"Probe Test 17 (candidate spin domain pruning)\",\n  ListQ[supportDomain17] && Length[supportDomain17] < 16 && AllTrue[supportDomain17, IntegerQ]\n];\n\nsupportFamily18 = First[fiveSpinArtifact[\"Families\"]];\nsupportNext18 = Private`spinProjectionAssignmentIterator[fiveSpinArtifact, 1234];\nsupportCandidate18 = supportNext18[];\nsupportDomain18 = Private`spinProjectionFamilyOutputSpinDomain[supportFamily18, supportCandidate18, 1234];\nsupportTermSupports18 = With[\n  {lists = Select[Private`spinProjectionFactorOutputSpinSupport[#, 1, supportCandidate18[[1]], supportCandidate18[[2]]] & /@ #[\"Parts\"], ListQ]},\n  If[lists === {}, Range[16], Intersection @@ lists]\n] & /@ supportFamily18[\"Terms\"];\nsupportSingletonSupports18 = Select[supportTermSupports18, Length[#] == 1 &];\n\ntest18 = testReport[\n  \"Probe Test 18 (five-spin singleton term supports)\",\n  supportDomain18 === Automatic &&\n    supportSingletonSupports18 =!= {} &&\n    Sort[DeleteDuplicates[Flatten[supportSingletonSupports18]]] === Sort[supportCandidate18[[1]]]\n];\n\niteratorNextA = Private`spinProjectionAssignmentIterator[fiveSpinArtifact, 1234];\niteratorSeqA = Table[iteratorNextA[], {3}];\niteratorNextB = Private`spinProjectionAssignmentIterator[fiveSpinArtifact, 1234];\niteratorSeqB = Table[iteratorNextB[], {3}];\niteratorNextC = Private`spinProjectionAssignmentIterator[fiveSpinArtifact, 4321];\niteratorSeqC = Table[iteratorNextC[], {3}];\n\ntest19 = testReport[\n  \"Probe Test 19 (support iterator deterministic and unique)\",\n  iteratorSeqA === iteratorSeqB && DuplicateFreeQ[iteratorSeqA] && iteratorSeqA =!= iteratorSeqC\n];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "Needs[\"StringCode`OPE`TypeII`FlatSpace`TensorStructures`IndependentTensorStructures`\"];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`SpinProjection`Compile`\"];\n\nprobeSparseRecord0 = First @ findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{b1, \"chiral\"}}|>,\n  \"TargetRank\" -> Automatic,\n  \"RandomSeed\" -> 1234,\n  \"ReturnSparseBasis\" -> True\n];\nprobeRelabelRules = {a1 -> x1, a2 -> x2, a3 -> x3, a4 -> x4, a5 -> x5, b1 -> y1};\nprobeSparseRecord1 = Private`spinProjectionRelabelSparseBasisRecord0[probeSparseRecord0, probeRelabelRules];\nprobeSparseContext = <|\n  \"FreeSpinSlot\" -> AssociationThread[{y1, x1, x2, x3, x4, x5} -> Range[6]],\n  \"FreeSpinChirality\" -> AssociationThread[{y1, x1, x2, x3, x4, x5} -> ConstantArray[\"chiral\", 6]],\n  \"FreeVectorSlot\" -> <||>\n|>;\nprobeSparseRefs = Private`spinProjectionSelectorCachedGammaKernelRefs0[probeSparseRecord1, probeSparseContext];\nprobeSparseTerm = Private`spinProjectionCompileTensorTerm0[probeSparseRecord1, <||>, <||>, <||>, probeSparseContext, 0];\nprobeExprTerm = Private`spinProjectionCompileTensorTerm0[probeSparseRecord1[\"Expr\"], <||>, <||>, <||>, probeSparseContext, 0];\n\ntest20 = testReport[\n  \"Probe Test 20 (sparse-basis relabel keeps selector cache and updates actual maps)\",\n  probeSparseRecord1[\"SelectorFamilyCache\"] === probeSparseRecord0[\"SelectorFamilyCache\"] &&\n    Lookup[\n      probeSparseRecord1[\"CanonicalToActualSpin\"],\n      probeSparseRecord0[\"SelectorFamilyCache\", \"SpinSymbols\"]\n    ] === {y1, x1, x2, x3, x4, x5}\n];\n\ntest21 = testReport[\n  \"Probe Test 21 (sparse-basis cached refs remap onto RHS free slots)\",\n  TrueQ[Private`spinProjectionSelectorSparseBasisFastPathQ0[probeSparseRecord1, <||>, <||>]] &&\n    probeSparseRefs === probeSparseTerm[\"Term\", \"GammaKernelRefs\"]\n];\n\ntest22 = testReport[\n  \"Probe Test 22 (sparse-basis scalar compile preserves legacy term invariants)\",\n  AssociationQ[probeSparseTerm] && AssociationQ[probeExprTerm] &&\n    probeSparseTerm[\"Term\", \"ScalarFactor\"] === probeExprTerm[\"Term\", \"ScalarFactor\"] &&\n    probeSparseTerm[\"Term\", \"SpinEqualities\"] === probeExprTerm[\"Term\", \"SpinEqualities\"] &&\n    probeSparseTerm[\"Term\", \"VectorEqualities\"] === probeExprTerm[\"Term\", \"VectorEqualities\"]\n];",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    },
    {
      "kind": 2,
      "value": "allTestsPassed",
      "languageId": "wolfram",
      "outputs": [],
      "metadata": {},
      "executionSummary": {}
    }
  ],
