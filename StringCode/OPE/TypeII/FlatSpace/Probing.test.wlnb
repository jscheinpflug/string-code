   "value": "probeSample4 = probeProjectedOPESamples[\n  \"Holo\",\n  -2,\n  OPEProjected[-2, 0][R[exp\\[Phi]f[-1, z1], \\[Psi][mu, 0, z1]], R[exp\\[Phi]f[-1, z2], \\[Psi][nu, 0, z2]], R[exp\\[Phi]f[-1, z3], \\[Psi][rho, 0, z3]], R[S[{alpha, \"chiral\"}, -1/2, {}, 0, z4]]],\n  {mu, nu, rho},\n  {alpha, \"chiral\"},\n  Function[{vecs, spin}, {\n    R[exp\\[Phi]f[-1, z1], \\[Psi][vecs[[1]], 0, z1]],\n    R[exp\\[Phi]f[-1, z2], \\[Psi][vecs[[2]], 0, z2]],\n    R[exp\\[Phi]f[-1, z3], \\[Psi][vecs[[3]], 0, z3]],\n    R[S[{spin, \"chiral\"}, -1/2, {}, 0, z4]]\n  }],\n  3,\n  40,\n  20260410\n];\n\ntest4 = testReport[\"Probe Test 4 (psi-psi-psi-S concrete probes all match)\", probeSample4[\"PassQ\"]];",
