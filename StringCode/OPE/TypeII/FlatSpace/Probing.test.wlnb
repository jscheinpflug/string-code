   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "probeSample2 = probeProjectedOPESamples[\n  \"Holo\",\n  1,\n  OPEProjected[1, 0][R[S[{a1, \"antichiral\"}, -1/2, {{mu, -1}}, 0, z1]], R[exp\\[Phi]f[-1, z2], \\[Psi][nu, 0, z2]]],\n  {mu, nu},\n  {a1, \"antichiral\"},\n  Function[{vecs, spin}, {\n    R[S[{spin, \"antichiral\"}, -1/2, {{vecs[[1]], -1}}, 0, z1]],\n    R[exp\\[Phi]f[-1, z2], \\[Psi][vecs[[2]], 0, z2]]\n  }],\n  3,\n  40,\n  20260408\n];\n\ntest2 = testReport[\"Probe Test 2 (target sample at projection [1,0] produced 3 concrete probes)\", probeSample2[\"EnoughSamplesQ\"]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
