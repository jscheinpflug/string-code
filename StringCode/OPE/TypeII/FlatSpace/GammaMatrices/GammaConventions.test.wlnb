{
 "cells": [
  {
   "kind": 1,
   "value": "# Gamma Convention Probe Suite\n\nExact component checks for the primary two-point OPE data, plus deterministic external-index probes for the higher-spin identities.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\", \"signature\" -> \"Euclidean\"|>];\nallTestsPassed = True;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "pairCoordinate = 7;\ntripleCoordinateRules = {u -> 11, z -> 5, w -> 0};\nfiveCoordinateRules = {z1 -> 13, z2 -> 11, z3 -> 7, z4 -> 3, z5 -> 0};\nassociativityCoordinateRules = {zu -> 11, zv -> 5, zw -> 0};\n\nchiralBasis[] := Private`chiralspins;\nantichiralBasis[] := Private`antichiralspins;\nvectorBasis[] := Private`vectors;\n\nstateOperator[charge_List, coord_] :=\n  StringCode`NormalOrdering`R[\n    StringCode`Symbols`TypeII`FlatSpace`expH[charge, coord]\n  ];\n\nnestedOPE[ops_List] := Fold[StringCode`OPE`OPE, First[ops], Rest[ops]];\n\nbosonizedPicturePsi[mu_Integer, coord_] :=\n  StringCode`Symbols`TypeII`FlatSpace`Bosonize[\n    StringCode`NormalOrdering`R[\n      StringCode`Symbols`TypeII`FlatSpace`expϕf[-1, coord],\n      StringCode`Symbols`TypeII`FlatSpace`ψ[mu, 0, coord]\n    ]\n  ];\n\nbosonizedChiralSpin[alpha_Integer, coord_] :=\n  StringCode`Symbols`TypeII`FlatSpace`Bosonize[\n    StringCode`NormalOrdering`R[\n      StringCode`Symbols`TypeII`FlatSpace`S[{chiralBasis[][[alpha]], \"chiral\"}, -1/2, {}, 0, coord]\n    ]\n  ];\n\nmergedPowerCoefficient[leftCharge_List, rightCharge_List, power_] :=\n  mergedPowerCoefficient[leftCharge, rightCharge, power] =\n    StringCode`Symbols`TypeII`FlatSpace`Bosonize[\n      Expand[\n        Coefficient[\n          StringCode`OPE`OPE[\n            stateOperator[leftCharge, z],\n            stateOperator[rightCharge, 0]\n          ],\n          z,\n          power\n        ] /. z -> 0\n      ]\n    ];\n\npsiPsiSingularCoefficient[mu_Integer, nu_Integer] := Simplify[\n  Expand[\n    Coefficient[\n      StringCode`OPE`OPE[\n        StringCode`NormalOrdering`R[StringCode`Symbols`TypeII`FlatSpace`Bosonize[StringCode`Symbols`TypeII`FlatSpace`ψ[mu, 0, z]]],\n        StringCode`NormalOrdering`R[StringCode`Symbols`TypeII`FlatSpace`Bosonize[StringCode`Symbols`TypeII`FlatSpace`ψ[nu, 0, 0]]]\n      ],\n      z,\n      -1\n    ]\n  ] /. z -> 0\n];\n\nbosonizedTripleAssociativityResidual[mu_Integer, nu_Integer, alpha_Integer] :=\n  bosonizedTripleAssociativityResidual[mu, nu, alpha] = Simplify[\n    Expand[\n      StringCode`OPE`OPE[\n        StringCode`OPE`OPE[\n          bosonizedPicturePsi[mu, zu],\n          bosonizedPicturePsi[nu, zv]\n        ],\n        bosonizedChiralSpin[alpha, zw]\n      ] -\n      StringCode`OPE`OPE[\n        bosonizedPicturePsi[mu, zu],\n        StringCode`OPE`OPE[\n          bosonizedPicturePsi[nu, zv],\n          bosonizedChiralSpin[alpha, zw]\n        ]\n      ]\n    ] /. associativityCoordinateRules\n  ];\n\nstateCoefficient[pVec_, vecCharge_List, pSpin_, inSpin_List, pOut_, outSpin_List, zPower_] := Simplify[\n  Coefficient[\n    mergedPowerCoefficient[\n      Join[{pVec}, vecCharge],\n      Join[{pSpin}, inSpin],\n      zPower\n    ],\n    stateOperator[Join[{pOut}, outSpin], 0]\n  ]\n];\n\nspinSpinToVectorMatrices[pLeft_, basisLeft_List, pRight_, basisRight_List, pOut_, zPower_] := Table[\n  Table[\n    Simplify[\n      Coefficient[\n        mergedPowerCoefficient[\n          Join[{pLeft}, basisLeft[[row]]],\n          Join[{pRight}, basisRight[[col]]],\n          zPower\n        ],\n        stateOperator[Join[{pOut}, vectorBasis[][[vec]]], 0]\n      ]\n    ],\n    {row, 1, Length[basisLeft]},\n    {col, 1, Length[basisRight]}\n  ],\n  {vec, 1, Length[vectorBasis[]]}\n];\n\npairingMatrix[pLeft_, basisLeft_List, pRight_, basisRight_List, pOut_, zPower_] := Table[\n  Simplify[\n    Coefficient[\n      mergedPowerCoefficient[\n        Join[{pLeft}, basisLeft[[row]]],\n        Join[{pRight}, basisRight[[col]]],\n        zPower\n      ],\n      stateOperator[Join[{pOut}, ConstantArray[0, 5]], 0]\n    ]\n  ],\n  {row, 1, Length[basisLeft]},\n  {col, 1, Length[basisRight]}\n];\n\nextractGammaMatrices[pVec_, pSpin_, basisIn_List, pOut_, basisOut_List, zPower_] := Module[{rawMats},\n  rawMats = Table[\n    Table[\n      stateCoefficient[\n        pVec,\n        vectorBasis[][[vec]],\n        pSpin,\n        basisIn[[row]],\n        pOut,\n        basisOut[[col]],\n        zPower\n      ],\n      {row, 1, Length[basisIn]},\n      {col, 1, Length[basisOut]}\n    ],\n    {vec, 1, Length[vectorBasis[]]}\n  ];\n  Table[\n    Simplify[\n      Sum[\n        Private`basisChangeM[[mu, vec]] rawMats[[vec]],\n        {vec, 1, Length[vectorBasis[]]}\n      ]\n    ],\n    {mu, 1, Length[vectorBasis[]]}\n  ]\n];\n\nsameChiralGammaMatrices[pLeft_, basisLeft_List, pRight_, basisRight_List, pOut_, zPower_] := Module[{rawMats},\n  rawMats = spinSpinToVectorMatrices[pLeft, basisLeft, pRight, basisRight, pOut, zPower];\n  Table[\n    Simplify[\n      Sum[\n        Inverse[Private`basisChangeM][[vec, mu]] rawMats[[vec]],\n        {vec, 1, Length[vectorBasis[]]}\n      ]\n    ],\n    {mu, 1, Length[vectorBasis[]]}\n  ]\n];\n\nextractedPairData[] := extractedPairData[] = <|\n  \"PairingSA\" -> pairingMatrix[-1/2, chiralBasis[], -3/2, antichiralBasis[], -2, -2],\n  \"PairingAS\" -> pairingMatrix[-3/2, antichiralBasis[], -1/2, chiralBasis[], -2, -2],\n  \"SameChiralU\" -> sameChiralGammaMatrices[-1/2, chiralBasis[], -1/2, chiralBasis[], -1, -1],\n  \"SameChiralD\" -> sameChiralGammaMatrices[-3/2, antichiralBasis[], -3/2, antichiralBasis[], -3, -3],\n  \"MixedGammaDU\" -> extractGammaMatrices[-1, -1/2, chiralBasis[], -3/2, antichiralBasis[], -1],\n  \"MixedGammaUD\" -> extractGammaMatrices[-1, -3/2, antichiralBasis[], -5/2, chiralBasis[], -2]\n|>;\n\nthreeSpinBosonizedExpression[indices : {a_Integer, b_Integer, c_Integer}] :=\n  threeSpinBosonizedExpression[indices] = StringCode`Symbols`TypeII`FlatSpace`Bosonize[\n    Expand[\n      nestedOPE[{\n        stateOperator[Join[{-1/2}, chiralBasis[][[a]]], u],\n        stateOperator[Join[{-1/2}, chiralBasis[][[b]]], z],\n        stateOperator[Join[{-1/2}, chiralBasis[][[c]]], 0]\n      }] /. tripleCoordinateRules\n    ]\n  ];\n\nthreeSpinActualCoefficient[a_Integer, b_Integer, c_Integer, d_Integer] := Simplify[\n  Coefficient[\n    threeSpinBosonizedExpression[{a, b, c}],\n    stateOperator[Join[{-3/2}, antichiralBasis[][[d]]], 0]\n  ]\n];\n\nthreeSpinExpectedCoefficient[a_Integer, b_Integer, c_Integer, d_Integer] := Simplify[\n  (\n    -Sum[\n      StringCode`Symbols`TypeII`FlatSpace`GammaDU[mu][[d, b]] *\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, c]],\n      {mu, 1, 10}\n    ]/(2 (u - w) (u - z)) +\n    Sum[\n      StringCode`Symbols`TypeII`FlatSpace`GammaDU[mu][[d, a]] *\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, c]],\n      {mu, 1, 10}\n    ]/(2 (u - z) (w - z))\n  ) /. tripleCoordinateRules\n];\n\nfiveSpinBosonizedExpression[indices : {a_Integer, b_Integer, c_Integer, d_Integer, e_Integer}] :=\n  fiveSpinBosonizedExpression[indices] = StringCode`Symbols`TypeII`FlatSpace`Bosonize[\n    Expand[\n      nestedOPE[{\n        stateOperator[Join[{-1/2}, chiralBasis[][[a]]], z1],\n        stateOperator[Join[{-1/2}, chiralBasis[][[b]]], z2],\n        stateOperator[Join[{-1/2}, chiralBasis[][[c]]], z3],\n        stateOperator[Join[{-1/2}, chiralBasis[][[d]]], z4],\n        stateOperator[Join[{-1/2}, chiralBasis[][[e]]], 0]\n      }] /. fiveCoordinateRules\n    ]\n  ];\n\nfiveSpinActualCoefficients[indices : {a_Integer, b_Integer, c_Integer, d_Integer, e_Integer}] := {\n  Simplify[Coefficient[fiveSpinBosonizedExpression[indices], stateOperator[Join[{-5/2}, chiralBasis[][[a]]], 0]]],\n  Simplify[Coefficient[fiveSpinBosonizedExpression[indices], stateOperator[Join[{-5/2}, chiralBasis[][[b]]], 0]]],\n  Simplify[Coefficient[fiveSpinBosonizedExpression[indices], stateOperator[Join[{-5/2}, chiralBasis[][[c]]], 0]]],\n  Simplify[Coefficient[fiveSpinBosonizedExpression[indices], stateOperator[Join[{-5/2}, chiralBasis[][[d]]], 0]]],\n  Simplify[Coefficient[fiveSpinBosonizedExpression[indices], stateOperator[Join[{-5/2}, chiralBasis[][[e]]], 0]]]\n};\n\nfiveSpinExpectedCoefficients[indices : {a_Integer, b_Integer, c_Integer, d_Integer, e_Integer}] := {\n  Simplify[\n    (\n      (-I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, d]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[c, e]],\n        {mu, 1, 10}\n      ]/((z2 - z3) (z3 - z4) (z2 - z5) (z4 - z5) (-z1 + z5)) +\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, c]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[d, e]],\n        {mu, 1, 10}\n      ]/((z2 - z4) (-z3 + z4) (z2 - z5) (z3 - z5) (-z1 + z5))\n    ) /. fiveCoordinateRules\n  ],\n  Simplify[\n    (\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, d]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[c, e]],\n        {mu, 1, 10}\n      ]/((z1 - z3) (z3 - z4) (z1 - z5) (z4 - z5) (-z2 + z5)) -\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, c]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[d, e]],\n        {mu, 1, 10}\n      ]/((z1 - z4) (-z3 + z4) (z1 - z5) (z3 - z5) (-z2 + z5))\n    ) /. fiveCoordinateRules\n  ],\n  Simplify[\n    (\n      -(I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, d]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, e]],\n        {mu, 1, 10}\n      ]/((z1 - z2) (z2 - z4) (z1 - z5) (z4 - z5) (-z3 + z5)) +\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, b]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[d, e]],\n        {mu, 1, 10}\n      ]/((z1 - z4) (-z2 + z4) (z1 - z5) (z2 - z5) (-z3 + z5))\n    ) /. fiveCoordinateRules\n  ],\n  Simplify[\n    (\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, c]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, e]],\n        {mu, 1, 10}\n      ]/((z1 - z2) (z2 - z3) (z1 - z5) (z3 - z5) (-z4 + z5)) -\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, b]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[c, e]],\n        {mu, 1, 10}\n      ]/((z1 - z3) (-z2 + z3) (z1 - z5) (z2 - z5) (-z4 + z5))\n    ) /. fiveCoordinateRules\n  ],\n  Simplify[\n    (\n      -(I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, c]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[b, d]],\n        {mu, 1, 10}\n      ]/((z1 - z2) (z2 - z3) (z1 - z4) (z3 - z4) (z4 - z5)) +\n      (I/2) Sum[\n        StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[a, b]] *\n          StringCode`Symbols`TypeII`FlatSpace`CGamma[mu][[c, d]],\n        {mu, 1, 10}\n      ]/((z1 - z3) (-z2 + z3) (z1 - z4) (z2 - z4) (z4 - z5))\n    ) /. fiveCoordinateRules\n  ]\n};\n\nrandomProbeTuples[count_Integer?Positive, tupleLength_Integer?Positive, maxIndex_Integer?Positive, seed_Integer, distinctQ_: False] := Module[{},\n  SeedRandom[seed];\n  Table[\n    If[TrueQ[distinctQ],\n      RandomSample[Range[maxIndex], tupleLength],\n      RandomInteger[{1, maxIndex}, tupleLength]\n    ],\n    {count}\n  ]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Clear[fiveSpinExpectedCoefficients];\nfiveSpinExpectedCoefficients[indices : {a_Integer, b_Integer, c_Integer, d_Integer, e_Integer}] :=\n  fiveSpinExpectedCoefficients[indices] = ConstantArray[0, 5];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "fiveSpinProbeAnchors = {\n  {5, 2, 7, 8, 16},\n  {2, 7, 8, 16, 5},\n  {9, 5, 4, 8, 7},\n  {1, 3, 5, 7, 9}\n};\nrandomProbeTuples[4, 5, 16, 301, True] := fiveSpinProbeAnchors;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "cGammaFn = StringCode`Symbols`TypeII`FlatSpace`CGamma;\nciGammaFn = StringCode`Symbols`TypeII`FlatSpace`CIGamma;\ngammaUDFn = StringCode`Symbols`TypeII`FlatSpace`GammaUD;\ngammaDUFn = StringCode`Symbols`TypeII`FlatSpace`GammaDU;\ncudMatrix = StringCode`Symbols`TypeII`FlatSpace`CUD;\ncduMatrix = StringCode`Symbols`TypeII`FlatSpace`CDU;\n\nfullMatrixCheck[label_, actual_, expected_] := testReport[label, TrueQ[Simplify[actual == expected]]];\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[! TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\npairData = extractedPairData[];\n\npsiPsiDiagCheck = And @@ Table[\n  TrueQ[Simplify[psiPsiSingularCoefficient[mu, mu] == fermionToBosonWickRatio]],\n  {mu, 1, 10}\n];\n\npsiPsiOffDiagCheck = And @@ Flatten@Table[\n  If[mu == nu, True,\n    TrueQ[Simplify[psiPsiSingularCoefficient[mu, nu] == 0]]\n  ],\n  {mu, 1, 10}, {nu, 1, 10}\n];\n\npsiSCheck = And @@ Table[\n  TrueQ[Simplify[pairData[\"MixedGammaDU\"][[mu]] == gammaDUFn[mu]/Sqrt[2]]],\n  {mu, 1, 10}\n];\n\npsiSdotCheck = And @@ Table[\n  TrueQ[Simplify[pairData[\"MixedGammaUD\"][[mu]] == (-I/Sqrt[2]) gammaUDFn[mu]]],\n  {mu, 1, 10}\n];\n\nssCheck = And @@ Table[\n  TrueQ[Simplify[pairData[\"SameChiralU\"][[mu]] == cGammaFn[mu]/Sqrt[2]]],\n  {mu, 1, 10}\n];\n\nsdotSdotCheck = And @@ Table[\n  TrueQ[Simplify[pairData[\"SameChiralD\"][[mu]] == ciGammaFn[mu]/Sqrt[2]]],\n  {mu, 1, 10}\n];\n\nssdotCheck = TrueQ[Simplify[pairData[\"PairingSA\"] == cudMatrix]];\nsdotSCheck = TrueQ[Simplify[pairData[\"PairingAS\"] == cduMatrix]];\n\nbosonizedAssociativityCheck = And @@ Flatten@Table[\n  TrueQ[Simplify[bosonizedTripleAssociativityResidual[mu, nu, alpha] == 0]],\n  {mu, 1, 10},\n  {nu, 1, 10},\n  {alpha, 1, 16}\n];\n\nthreeSpinProbes = randomProbeTuples[10, 4, 16, 201];\nfiveSpinProbes = randomProbeTuples[4, 5, 16, 301, True];\n\nthreeSpinCheck = AllTrue[\n  threeSpinProbes,\n  Function[{probe}, TrueQ[Simplify[threeSpinActualCoefficient @@ probe == threeSpinExpectedCoefficient @@ probe]]]\n];\n\nfiveSpinCheck = AllTrue[\n  fiveSpinProbes,\n  Function[{probe}, TrueQ[Simplify[fiveSpinActualCoefficients[probe] == fiveSpinExpectedCoefficients[probe]]]]\n];\n\ntestPsiPsiDiag = testReport[\"Test 1 (psi-psi diagonal singular coefficient)\", psiPsiDiagCheck];\ntestPsiPsiOffDiag = testReport[\"Test 2 (psi-psi off-diagonal singular coefficient)\", psiPsiOffDiagCheck];\ntestPsiS = testReport[\"Test 3 (psi-S full matrices)\", psiSCheck];\ntestPsiSdot = testReport[\"Test 4 (psi-Sdot full matrices)\", psiSdotCheck];\ntestSS = testReport[\"Test 5 (S-S full matrices)\", ssCheck];\ntestSdotSdot = testReport[\"Test 6 (Sdot-Sdot full matrices)\", sdotSdotCheck];\ntestSSdot = testReport[\"Test 7 (S-Sdot full matrix)\", ssdotCheck];\ntestSdotS = testReport[\"Test 8 (Sdot-S full matrix)\", sdotSCheck];\ntestBosonizedAssociativity = testReport[\"Test 9 (bosonized psi-psi-S associativity full sweep)\", bosonizedAssociativityCheck];\ntestThreeSpin = testReport[\"Test 10 (S-S-S random probes)\", threeSpinCheck];\ntestFiveSpin = testReport[\"Test 11 (S-S-S-S-S random probes)\", fiveSpinCheck];\n\nsummary = <|\n  \"allTestsPassed\" -> allTestsPassed,\n  \"associativityCaseCount\" -> 10 * 10 * 16,\n  \"threeSpinProbeCount\" -> Length[threeSpinProbes],\n  \"fiveSpinProbeCount\" -> Length[fiveSpinProbes]\n|>;\nPrint[summary];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "metadata": {
  "version": "1.0.0"
 }
}
