{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace GammaMatrices Tests\n\nExact algebraic checks for the frozen gamma-matrix and spinor-pairing data.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`GammaMatrices`\"];\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1773006936397,
     "endTime": 1773006936822
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nzero16 = ConstantArray[0, {16, 16}];\nGamma32[mu_Integer] := ArrayFlatten[{{zero16, GammaUD[mu]}, {GammaDU[mu], zero16}}] /; 1 <= mu <= 10;\ngamma11Dirac = -I Fold[Dot, IdentityMatrix[32], Table[Gamma32[mu], {mu, 1, 10}]];\n\nCGammaList = Table[CGamma[mu], {mu, 1, 10}];\nCIGammaList = Table[CIGamma[mu], {mu, 1, 10}];\ngammaUDList = Table[GammaUD[mu], {mu, 1, 10}];\ngammaDUList = Table[GammaDU[mu], {mu, 1, 10}];\ngamma32List = Table[Gamma32[mu], {mu, 1, 10}];\nCGammaSparseList = Table[CGammaSparse[mu], {mu, 1, 10}];\nCIGammaSparseList = Table[CIGammaSparse[mu], {mu, 1, 10}];\ngammaUDSparseList = Table[GammaUDSparse[mu], {mu, 1, 10}];\ngammaDUSparseList = Table[GammaDUSparse[mu], {mu, 1, 10}];\n\ntest1 = testReport[\n  \"Test 1 (matrix dimensions)\",\n  Dimensions[CUD] === {16, 16} &&\n  Dimensions[CDU] === {16, 16} &&\n  Dimensions[Gamma11UU] === {16, 16} &&\n  Dimensions[Gamma11DD] === {16, 16} &&\n  Dimensions[gamma11Dirac] === {32, 32} &&\n  And @@ (Dimensions[#] === {16, 16} & /@ Join[CGammaList, CIGammaList, gammaUDList, gammaDUList]) &&\n  And @@ (Dimensions[#] === {32, 32} & /@ gamma32List)\n];\n\ntest2 = testReport[\n  \"Test 2 (pairing identities)\",\n  TrueQ[Simplify[CDU == -Transpose[CUD]]] &&\n  TrueQ[Simplify[CUD . CDU == IdentityMatrix[16]]] &&\n  TrueQ[Simplify[CDU . CUD == IdentityMatrix[16]]]\n];\n\ntest3 = testReport[\n  \"Test 3 (same-chirality symmetry)\",\n  And @@ Table[TrueQ[Simplify[Transpose[CGamma[mu]] == CGamma[mu]]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[Transpose[CIGamma[mu]] == CIGamma[mu]]], {mu, 1, 10}]\n];\n\ntest4 = testReport[\n  \"Test 4 (chiral sign relations)\",\n  And @@ Table[TrueQ[Simplify[CIGamma[mu] == If[mu <= 5, CGamma[mu], -CGamma[mu]]]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[GammaDU[mu] == If[mu <= 5, -GammaUD[mu], GammaUD[mu]]]], {mu, 1, 10}]\n];\n\ntest5 = testReport[\n  \"Test 5 (relations with C)\",\n  And @@ Table[TrueQ[Simplify[CGamma[mu] == GammaUD[mu] . CUD]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[CIGamma[mu] == GammaDU[mu] . CDU]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[GammaUD[mu] == CGamma[mu] . Inverse[CUD]]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[GammaDU[mu] == CIGamma[mu] . Inverse[CDU]]], {mu, 1, 10}]\n];\n\ntest6 = testReport[\n  \"Test 6 (Gamma11 blocks match Dirac construction)\",\n  TrueQ[Simplify[gamma11Dirac == ArrayFlatten[{{Gamma11UU, zero16}, {zero16, Gamma11DD}}]]]\n];\n\ntest7 = testReport[\n  \"Test 7 (Gamma11 Weyl eigenvalues)\",\n  TrueQ[Simplify[Gamma11UU == IdentityMatrix[16]]] &&\n  TrueQ[Simplify[Gamma11DD == -IdentityMatrix[16]]]\n];\n\ntest8 = testReport[\n  \"Test 8 (Gamma11 squares to one)\",\n  TrueQ[Simplify[gamma11Dirac . gamma11Dirac == IdentityMatrix[32]]]\n];\n\ntest9 = testReport[\n  \"Test 9 (Gamma11 anticommutes with Gamma32)\",\n  And @@ Table[\n    TrueQ[Simplify[gamma11Dirac . Gamma32[mu] + Gamma32[mu] . gamma11Dirac == ConstantArray[0, {32, 32}]]],\n    {mu, 1, 10}\n  ]\n];\n\ntest10 = testReport[\n  \"Test 10 (mixed transpose relation)\",\n  And @@ Table[TrueQ[Simplify[Transpose[GammaUD[mu]] == If[mu <= 5, -GammaDU[mu], GammaDU[mu]]]], {mu, 1, 10}]\n];\n\ntest11 = testReport[\n  \"Test 11 (Gamma11 flips mixed chirality)\",\n  And @@ Table[TrueQ[Simplify[Gamma11UU . GammaUD[mu] + GammaUD[mu] . Gamma11DD == ConstantArray[0, {16, 16}]]], {mu, 1, 10}] &&\n  And @@ Table[TrueQ[Simplify[Gamma11DD . GammaDU[mu] + GammaDU[mu] . Gamma11UU == ConstantArray[0, {16, 16}]]], {mu, 1, 10}]\n];\n\ntest12 = testReport[\n  \"Test 12 (Clifford UD.DU)\",\n  And @@ Flatten@Table[\n    TrueQ[Simplify[GammaUD[mu] . GammaDU[nu] + GammaUD[nu] . GammaDU[mu] == 2 KroneckerDelta[mu, nu] IdentityMatrix[16]]],\n    {mu, 1, 10},\n    {nu, 1, 10}\n  ]\n];\n\ntest13 = testReport[\n  \"Test 13 (Clifford DU.UD)\",\n  And @@ Flatten@Table[\n    TrueQ[Simplify[GammaDU[mu] . GammaUD[nu] + GammaDU[nu] . GammaUD[mu] == 2 KroneckerDelta[mu, nu] IdentityMatrix[16]]],\n    {mu, 1, 10},\n    {nu, 1, 10}\n  ]\n];\n\ntest14 = testReport[\n  \"Test 14 (sparse accessor heads)\",\n  Head[CUDSparse] === SparseArray &&\n  Head[CDUSparse] === SparseArray &&\n  Head[Gamma11UUSparse] === SparseArray &&\n  Head[Gamma11DDSparse] === SparseArray &&\n  And @@ (Head[#] === SparseArray & /@ Join[CGammaSparseList, CIGammaSparseList, gammaUDSparseList, gammaDUSparseList])\n];\n\ntest15 = testReport[\n  \"Test 15 (sparse accessors match dense)\",\n  And @@ Table[Normal[CGammaSparse[mu]] === CGamma[mu], {mu, 1, 10}] &&\n  And @@ Table[Normal[CIGammaSparse[mu]] === CIGamma[mu], {mu, 1, 10}] &&\n  And @@ Table[Normal[GammaUDSparse[mu]] === GammaUD[mu], {mu, 1, 10}] &&\n  And @@ Table[Normal[GammaDUSparse[mu]] === GammaDU[mu], {mu, 1, 10}] &&\n  Normal[CUDSparse] === CUD &&\n  Normal[CDUSparse] === CDU &&\n  Normal[Gamma11UUSparse] === Gamma11UU &&\n  Normal[Gamma11DDSparse] === Gamma11DD\n];\n\ntest16 = testReport[\n  \"Test 16 (sparse Clifford UD.DU)\",\n  And @@ Flatten@Table[\n    TrueQ[Simplify[Normal[GammaUDSparse[mu] . GammaDUSparse[nu] + GammaUDSparse[nu] . GammaDUSparse[mu]] == 2 KroneckerDelta[mu, nu] IdentityMatrix[16]]],\n    {mu, 1, 10},\n    {nu, 1, 10}\n  ]\n];\n\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 1 (matrix dimensions): PASSED\n</pre>",
       "mime": "x-application/wolfram-language-html"
