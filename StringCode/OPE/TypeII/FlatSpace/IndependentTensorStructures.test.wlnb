{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace IndependentTensorStructures Tests\n\nSubmodule coverage for API, selector, and evaluator internals, plus preserved end-to-end regressions.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[\n  <|\n    \"theory\" -> \"TypeII\",\n    \"CFT\" -> \"FlatSpace\",\n    \"conventions\" -> \"TypeII-Xi\",\n    \"bracket\" -> \"Flat\"\n  |>\n];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`IndependentTensorStructures`\"];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1773153829288,
     "endTime": 1773153829813
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nbaseSelectorOptions = <|\n  \"RandomSeed\" -> 1234,\n  \"ModulusPrimes\" -> {32009, 32057, 32089},\n  \"ProbeCount\" -> 5,\n  \"VerificationProbeCount\" -> 3\n|>;\n\nselectorOptionRules[overrides___Rule] := Normal @ Join[baseSelectorOptions, <|overrides|>];\nflattenCandidates[groupList_] := Flatten[groupList, 1];\nbasisSubsetQ[basisList_, candidateList_] := And @@ (MemberQ[candidateList, #] & /@ basisList);\nbasisLength[result_Association] := Length[result[\"Basis\"]];\nassocEntriesQ[left_Association, right_Association] := SortBy[Normal[left], First] === SortBy[Normal[right], First];\nmatrixCoeffsFromAssociation[matrixAssoc_Association, spinorLeft_List, spinorRight_List, prime_Integer] := Association @ Select[\n  KeyValueMap[(#1 -> Mod[spinorLeft . #2 . spinorRight, prime]) &, matrixAssoc],\n  Last[#] =!= 0 &\n];\n\nantisymmetrizedMatrixScratch[vectorHeads_List, basisSubset_List, primeData_Association] := Module[\n  {rank = Length[vectorHeads], permutations, sumMatrix, factors},\n  permutations = Permutations[Range[rank]];\n  sumMatrix = ConstantArray[0, {16, 16}];\n  Do[\n    factors = Table[\n      Private`gammaHeadBasisMatrix[Head[vectorHeads[[perm[[i]]]]], basisSubset[[i]], primeData],\n      {i, 1, rank}\n    ];\n    sumMatrix = Mod[\n      sumMatrix + Signature[perm] Fold[Private`matrixProductMod[#1, #2, primeData[\"Prime\"]] &, primeData[\"Identity\"], factors],\n      primeData[\"Prime\"]\n    ],\n    {perm, permutations}\n  ];\n  Mod[PowerMod[Factorial[rank], -1, primeData[\"Prime\"]] sumMatrix, primeData[\"Prime\"]]\n];\n\nmaximalBasisStats[candidateList_List, optionList_List] := Module[{best = $Failed, attempt, targetRank},\n  For[targetRank = 1, targetRank <= Length[candidateList], targetRank++,\n    attempt = Quiet @ Check[\n      findIndependentTensorStructures[\n        candidateList,\n        Sequence @@ Join[optionList, {\"TargetRank\" -> targetRank, \"ReturnStatistics\" -> True}]\n      ],\n      $Failed\n    ];\n    If[AssociationQ[attempt] && basisLength[attempt] == targetRank,\n      best = attempt,\n      Break[]\n    ];\n  ];\n  best\n];\n\nmaximalByAugmentationQ[candidateList_List, basisList_List, optionList_List] := Module[\n  {rank, nonBasisCandidates, augmentedOptions, attempt},\n  rank = Length[basisList];\n  nonBasisCandidates = Select[candidateList, !MemberQ[basisList, #] &];\n  augmentedOptions = Join[optionList, {\"TargetRank\" -> rank + 1, \"ReturnStatistics\" -> True}];\n  And @@ Table[\n    attempt = Quiet @ Check[\n      findIndependentTensorStructures[Append[basisList, nonBasisCandidates[[i]]], Sequence @@ augmentedOptions],\n      $Failed\n    ];\n    !AssociationQ[attempt],\n    {i, 1, Length[nonBasisCandidates]}\n  ]\n];\n\nSetAttributes[countParsedCandidateVisits, HoldFirst];\ncountParsedCandidateVisits[heldExpression_] := Module[{count = 0, savedDownValues, result},\n  savedDownValues = DownValues[Private`parsedCandidateAtIndex];\n  Block[{Private`parsedCandidateAtIndex},\n    Private`parsedCandidateAtIndex[listInput_, cacheInput_, indexInput_] := Module[{value},\n      count++;\n      Block[{Private`parsedCandidateAtIndex},\n        DownValues[Private`parsedCandidateAtIndex] = savedDownValues;\n        value = Private`parsedCandidateAtIndex[listInput, cacheInput, indexInput];\n      ];\n      value\n    ];\n    result = heldExpression;\n  ];\n  <|\"Result\" -> result, \"ParseCount\" -> count|>\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1773153829814,
     "endTime": 1773153830677
    },
    "executionOrder": 4,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "## API Submodule Tests",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "apiIncoming1 = <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>;\napiOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiGroups1 = generateTensorStructures[apiIncoming1, apiOutgoing1];\napiFlat1 = flattenCandidates[apiGroups1];\napiAssoc1 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiList1 = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\n(* API Test 1: Association input vs explicit list input give consistent basis/rank on a 4-chiral scalar case. *)\napiTest1 = testReport[\n  \"API Test 1 (scalar/chiral association-list parity)\",\n  Length[apiFlat1] == 15 &&\n    basisLength[apiAssoc1] == 2 && apiAssoc1[\"TargetRank\"] == 2 &&\n    basisLength[apiList1] == 2 && apiList1[\"TargetRank\"] == 2 &&\n    basisSubsetQ[apiAssoc1[\"Basis\"], apiFlat1] && basisSubsetQ[apiList1[\"Basis\"], apiFlat1]\n];\n\napiRankOne = findIndependentTensorStructures[\n  apiFlat1,\n  Sequence @@ selectorOptionRules[\"TargetRank\" -> 1, \"ReturnStatistics\" -> True]\n];\n(* API Test 2: Explicit \"TargetRank\" -> 1 returns exactly one basis element and stops early. *)\napiTest2 = testReport[\n  \"API Test 2 (explicit target rank)\",\n  basisLength[apiRankOne] == 1 && apiRankOne[\"TargetRank\"] == 1 && apiRankOne[\"VisitedCandidates\"] == 1\n];\n\napiNested = findIndependentTensorStructures[apiGroups1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n(* API Test 3: Nested grouped candidates are normalized correctly (Flatten[...,1] behavior parity). *)\napiTest3 = testReport[\n  \"API Test 3 (nested candidate normalization)\",\n  apiNested[\"Basis\"] === apiList1[\"Basis\"] && apiNested[\"TargetRank\"] == apiList1[\"TargetRank\"]\n];\n\napiPlain = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[]];\n(* API Test 4: \"ReturnStatistics\" behavior: plain list when false, association with expected keys when true. *)\napiTest4 = testReport[\n  \"API Test 4 (ReturnStatistics shape)\",\n  ListQ[apiPlain] &&\n    AssociationQ[apiList1] &&\n    Sort[Keys[apiList1]] === {\"Basis\", \"TargetRank\", \"VisitedCandidates\"}\n];\n\napiIncoming2 = <|\"vector\" -> {}, \"spinor\" -> {{b1, \"chiral\"}, {b2, \"chiral\"}, {b3, \"antichiral\"}, {b4, \"antichiral\"}}|>;\napiOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiAssoc2 = findIndependentTensorStructures[apiIncoming2, apiOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n(* API Test 5: Automatic target inference gives expected rank for 2 chiral + 2 antichiral case. *)\napiTest5 = testReport[\n  \"API Test 5 (automatic target for 2+2 chirality)\",\n  apiAssoc2[\"TargetRank\"] == 3 && basisLength[apiAssoc2] == 3\n];\n\napiIncoming3 = <|\"vector\" -> {}, \"spinor\" -> {{c1, \"chiral\"}, {c2, \"chiral\"}, {c3, \"antichiral\"}}|>;\napiOutgoing3 = <|\"vector\" -> {mu}, \"spinor\" -> {{c4, \"antichiral\"}}|>;\napiGroups3 = generateTensorStructures[apiIncoming3, apiOutgoing3];\napiFlat3 = flattenCandidates[apiGroups3];\napiAssoc3 = findIndependentTensorStructures[apiIncoming3, apiOutgoing3, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\napiMaxStats1 = maximalBasisStats[apiFlat1, selectorOptionRules[]];\n(* API Test 6: Maximality after saturation: find highest reachable rank in a fixed candidate order, then verify no non-basis candidate can raise rank by augmentation. *)\napiTest6 = testReport[\n  \"API Test 6 (maximality after target-rank saturation)\",\n  AssociationQ[apiMaxStats1] &&\n    basisLength[apiMaxStats1] >= basisLength[apiList1] &&\n    maximalByAugmentationQ[apiFlat1, apiMaxStats1[\"Basis\"], selectorOptionRules[]]\n];\n\napiFlat1Reversed = Reverse[apiFlat1];\napiMaxStats1Reversed = maximalBasisStats[apiFlat1Reversed, selectorOptionRules[]];\n(* API Test 7: Same maximality check under reversed candidate order (order-sensitive robustness). *)\napiTest7 = testReport[\n  \"API Test 7 (maximality under reversed candidate order)\",\n  AssociationQ[apiMaxStats1Reversed] &&\n    maximalByAugmentationQ[apiFlat1Reversed, apiMaxStats1Reversed[\"Basis\"], selectorOptionRules[]]\n];\n\napiBadPrime = Quiet[findIndependentTensorStructures[apiFlat1, \"ModulusPrimes\" -> {9}], {findIndependentTensorStructures::badprime}];\napiBadTarget = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> -1], {findIndependentTensorStructures::badtarget}];\napiTooManyOut = Quiet[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {}, \"spinor\" -> {{d1, \"chiral\"}, {d2, \"chiral\"}}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {{d3, \"chiral\"}, {d4, \"antichiral\"}}|>\n  ],\n  {findIndependentTensorStructures::toomanyout}\n];\napiInvalidExplicit = Quiet[findIndependentTensorStructures[{GammaUDHold[muBad]}], {findIndependentTensorStructures::badarg}];\napiUnreachable = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> 20], {findIndependentTensorStructures::targetunmet}];\n\n(* API Test 8: Validation failures: bad primes, bad target rank, invalid outgoing spinors, invalid explicit candidate, unreachable target rank. *)\napiTest8 = testReport[\n  \"API Test 8 (validation failures)\",\n  apiBadPrime === $Failed &&\n    apiBadTarget === $Failed &&\n    apiTooManyOut === $Failed &&\n    apiInvalidExplicit === $Failed &&\n    apiUnreachable === $Failed\n];",
   "languageId": "wolfram",
   "outputs": [
