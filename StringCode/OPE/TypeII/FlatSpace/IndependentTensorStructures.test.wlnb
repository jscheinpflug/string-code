  {
   "kind": 2,
   "value": "groups4 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>\n];\nflat4 = flattenCandidates[groups4];\nassoc4 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist4 = findIndependentTensorStructures[flat4, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest4 = testReport[\n  \"Test 4 (5 chiral -> 1 chiral)\",\n  Length[flat4] == 540 &&\n    Sort[Keys[assoc4]] === {\"Basis\", \"TargetRank\", \"VisitedCandidates\"} &&\n    Sort[Keys[list4]] === {\"Basis\", \"TargetRank\", \"VisitedCandidates\"} &&\n    basisLength[assoc4] == 16 && assoc4[\"TargetRank\"] == 16 && assoc4[\"VisitedCandidates\"] == 16 &&\n    basisLength[list4] == 16 && list4[\"TargetRank\"] == 16 && list4[\"VisitedCandidates\"] == 16 &&\n    assoc4[\"Basis\"] === list4[\"Basis\"]\n];",
   "languageId": "wolfram",
   "outputs": [
