  {
   "kind": 2,
   "value": "scalarGroups = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nscalarFlat = flattenCandidates[scalarGroups];\nscalarAssoc = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nscalarList = findIndependentTensorStructures[scalarFlat, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest0 = testReport[\n  \"Test 0 (scalar basis selection)\",\n  scalarGroups === {{1}} && scalarFlat === {1} &&\n    scalarAssoc[\"Basis\"] === {1} && scalarAssoc[\"TargetRank\"] == 1 && scalarAssoc[\"VisitedCandidates\"] == 1 &&\n    scalarList[\"Basis\"] === {1} && scalarList[\"TargetRank\"] == 1 && scalarList[\"VisitedCandidates\"] == 1\n];\n\ngroups1 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nflat1 = flattenCandidates[groups1];\nassoc1 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist1 = findIndependentTensorStructures[flat1, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest1 = testReport[\n  \"Test 1 (4 chiral -> scalar)\",\n  Length[flat1] == 15 &&\n    basisLength[assoc1] == 2 && assoc1[\"TargetRank\"] == 2 && assoc1[\"VisitedCandidates\"] < Length[flat1] &&\n    basisLength[list1] == 2 && list1[\"TargetRank\"] == 2 &&\n    basisSubsetQ[assoc1[\"Basis\"], flat1] && basisSubsetQ[list1[\"Basis\"], flat1]\n];\n\ngroups2 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}, {a4, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nflat2 = flattenCandidates[groups2];\nassoc2 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}, {a4, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist2 = findIndependentTensorStructures[flat2, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest2 = testReport[\n  \"Test 2 (2 chiral + 2 antichiral -> scalar)\",\n  Length[flat2] == 17 &&\n    basisLength[assoc2] == 3 && assoc2[\"TargetRank\"] == 3 &&\n    basisLength[list2] == 3 && list2[\"TargetRank\"] == 3 &&\n    basisSubsetQ[assoc2[\"Basis\"], flat2] && basisSubsetQ[list2[\"Basis\"], flat2]\n];\n\ngroups3 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a4, \"antichiral\"}}|>\n];\nflat3 = flattenCandidates[groups3];\nassoc3 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a4, \"antichiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist3 = findIndependentTensorStructures[flat3, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest3 = testReport[\n  \"Test 3 (mixed -> vector + spinor)\",\n  Length[flat3] == 17 &&\n    basisLength[assoc3] == 5 && assoc3[\"TargetRank\"] == 5 &&\n    basisLength[list3] == 5 && list3[\"TargetRank\"] == 5 &&\n    basisSubsetQ[assoc3[\"Basis\"], flat3] && basisSubsetQ[list3[\"Basis\"], flat3]\n];\n\ngroups3a = generateTensorStructures[\n  <|\"vector\" -> {mu3a, nu3a, rho3a}, \"spinor\" -> {{alpha3a, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta3a, \"antichiral\"}}|>\n];\nflat3a = flattenCandidates[groups3a];\nassoc3a = findIndependentTensorStructures[\n  <|\"vector\" -> {mu3a, nu3a, rho3a}, \"spinor\" -> {{alpha3a, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta3a, \"antichiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist3a = findIndependentTensorStructures[flat3a, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest3a = testReport[\n  \"Test 3a (3 vector + chiral -> antichiral maximal basis)\",\n  Length[flat3a] == 4 &&\n    assoc3a[\"Basis\"] === flat3a && assoc3a[\"TargetRank\"] == 4 && assoc3a[\"VisitedCandidates\"] == 4 &&\n    list3a[\"Basis\"] === flat3a && list3a[\"TargetRank\"] == 4 && list3a[\"VisitedCandidates\"] == 4 &&\n    maximalByAugmentationQ[flat3a, assoc3a[\"Basis\"], selectorOptionRules[]] &&\n    maximalByAugmentationQ[flat3a, list3a[\"Basis\"], selectorOptionRules[]]\n];\n\ngroups3b = generateTensorStructures[\n  <|\"vector\" -> {mu3b, nu3b}, \"spinor\" -> {{alpha3b, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta3b, \"chiral\"}}|>\n];\nflat3b = flattenCandidates[groups3b];\nassoc3b = findIndependentTensorStructures[\n  <|\"vector\" -> {mu3b, nu3b}, \"spinor\" -> {{alpha3b, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{beta3b, \"chiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist3b = findIndependentTensorStructures[flat3b, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest3b = testReport[\n  \"Test 3b (2 vector + chiral -> chiral maximal basis)\",\n  Length[flat3b] == 2 &&\n    assoc3b[\"Basis\"] === flat3b && assoc3b[\"TargetRank\"] == 2 && assoc3b[\"VisitedCandidates\"] == 2 &&\n    list3b[\"Basis\"] === flat3b && list3b[\"TargetRank\"] == 2 && list3b[\"VisitedCandidates\"] == 2 &&\n    maximalByAugmentationQ[flat3b, assoc3b[\"Basis\"], selectorOptionRules[]] &&\n    maximalByAugmentationQ[flat3b, list3b[\"Basis\"], selectorOptionRules[]]\n];",
   "languageId": "wolfram",
