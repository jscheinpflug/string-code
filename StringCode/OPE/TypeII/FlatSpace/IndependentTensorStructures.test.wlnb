  {
   "kind": 2,
   "value": "assoc4Repeat = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\n\ntest4c = testReport[\n  \"Test 4c (seeded determinism)\",\n  assoc4Repeat[\"Basis\"] === assoc4[\"Basis\"] &&\n    assoc4Repeat[\"TargetRank\"] == assoc4[\"TargetRank\"] &&\n    assoc4Repeat[\"VisitedCandidates\"] == assoc4[\"VisitedCandidates\"]\n];\n\nSetAttributes[countParsedCandidateVisits, HoldFirst];\ncountParsedCandidateVisits[expr_] := Module[{count = 0, savedDV, result},\n  savedDV = DownValues[Private`parsedCandidateAtIndex];\n  Block[{Private`parsedCandidateAtIndex},\n    Private`parsedCandidateAtIndex[list_, cache_, i_] := Module[{value},\n      count++;\n      Block[{Private`parsedCandidateAtIndex},\n        DownValues[Private`parsedCandidateAtIndex] = savedDV;\n        value = Private`parsedCandidateAtIndex[list, cache, i];\n      ];\n      value\n    ];\n    result = expr;\n  ];\n  <|\"Result\" -> result, \"ParseCount\" -> count|>\n];\n\ncountedList4 = countParsedCandidateVisits[\n  findIndependentTensorStructures[flat4, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True]\n];\nlazyList4 = countedList4[\"Result\"];\n\ntest4a = testReport[\n  \"Test 4a (lazy parse count explicit list)\",\n  AssociationQ[lazyList4] && countedList4[\"ParseCount\"] == lazyList4[\"VisitedCandidates\"]\n];\n\ncountedAssoc4 = countParsedCandidateVisits[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}, {a5, \"chiral\"}}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {{a6, \"chiral\"}}|>,\n    \"RandomSeed\" -> 1234,\n    \"ReturnStatistics\" -> True\n  ]\n];\nlazyAssoc4 = countedAssoc4[\"Result\"];\n\ntest4b = testReport[\n  \"Test 4b (lazy parse count association input)\",\n  AssociationQ[lazyAssoc4] && countedAssoc4[\"ParseCount\"] == lazyAssoc4[\"VisitedCandidates\"]\n];\n\nrank3Factor = Private`candidateFactors[flat4[[16]]][[2]];\nmixedFactor = SelectFirst[\n  Flatten[Private`candidateFactors /@ flat3, 1],\n  With[{parts = Private`gammaFactorPartsSelector[#]},\n    AssociationQ[parts] &&\n      Length[parts[\"VectorLinks\"]] == 1 &&\n      Head[First[parts[\"VectorLinks\"]]] === GammaUDHold &&\n      parts[\"CTag\"] === None &&\n      parts[\"TailLinks\"] === {}\n  ] &,\n  Missing[\"NotFound\"]\n];\n\nruntime4 = Private`listSelectionRuntime[flat4, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 16, \"VerificationProbeCount\" -> 3, \"ModulusPrimes\" -> {32009}|>, 16];\nprobe4 = runtime4[\"Probes\"][[1]];\nprimeData4 = runtime4[\"PrimeData\"][32009];\nrank3Parts = Private`gammaFactorPartsSelector[rank3Factor];\nrank3Spin1 = probe4[\"SpinorComponents\"][rank3Parts[\"Spinors\"][[1]]];\nrank3Spin2 = probe4[\"SpinorComponents\"][rank3Parts[\"Spinors\"][[2]]];\nrank3MatrixAssoc = Private`gammaFactorMatrixAssociation[rank3Parts, primeData4];\nrank3Scratch = matrixCoeffsFromAssociation[rank3MatrixAssoc, rank3Spin1, rank3Spin2, primeData4[\"Prime\"]];\nrank3Coeffs = Private`gammaFactorCoefficientAssociation[rank3Factor, probe4, primeData4];\n\nruntime3 = Private`listSelectionRuntime[flat3, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3, \"ModulusPrimes\" -> {32009}|>, 5];\nprobe3 = runtime3[\"Probes\"][[1]];\nprimeData3 = runtime3[\"PrimeData\"][32009];\nmixedParts = Private`gammaFactorPartsSelector[mixedFactor];\nmixedSpin1 = probe3[\"SpinorComponents\"][mixedParts[\"Spinors\"][[1]]];\nmixedSpin2 = probe3[\"SpinorComponents\"][mixedParts[\"Spinors\"][[2]]];\nmixedMatrixAssoc = Private`gammaFactorMatrixAssociation[mixedParts, primeData3];\nmixedScratch = matrixCoeffsFromAssociation[mixedMatrixAssoc, mixedSpin1, mixedSpin2, primeData3[\"Prime\"]];\nmixedCoeffs = Private`gammaFactorCoefficientAssociation[mixedFactor, probe3, primeData3];\nrank6Heads = {GammaUDHold[mu1], GammaDUHold[mu2], GammaUDHold[mu3], GammaDUHold[mu4], GammaUDHold[mu5], GammaDUHold[mu6]};\nrank6Matrix = Private`antisymmetrizedVectorMatrix[rank6Heads, Range[6], primeData4];\nrank6Scratch = antisymmetrizedMatrixScratch[rank6Heads, Range[6], primeData4];\n\ntest5 = testReport[\n  \"Test 5 (matrix coefficient path)\",\n  mixedFactor =!= Missing[\"NotFound\"] &&\n    assocEntriesQ[rank3Coeffs, rank3Scratch] &&\n    assocEntriesQ[mixedCoeffs, mixedScratch]\n];\ntest6 = testReport[\"Test 6 (rank-6 antisymmetrized matrix DP)\", rank6Matrix === rank6Scratch];",
   "languageId": "wolfram",
   "outputs": [
