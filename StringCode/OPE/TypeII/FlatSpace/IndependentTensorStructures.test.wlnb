  {
   "kind": 2,
   "value": "groups3 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a4, \"antichiral\"}}|>\n];\nflat3 = flattenCandidates[groups3];\nassoc3 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}}|>,\n  <|\"vector\" -> {mu}, \"spinor\" -> {{a4, \"antichiral\"}}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist3 = findIndependentTensorStructures[flat3, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest3 = testReport[\n  \"Test 3 (mixed -> vector + spinor)\",\n  Length[flat3] == 17 &&\n    basisLength[assoc3] == 5 && assoc3[\"TargetRank\"] == 5 &&\n    basisLength[list3] == 5 && list3[\"TargetRank\"] == 5 &&\n    basisSubsetQ[assoc3[\"Basis\"], flat3] && basisSubsetQ[list3[\"Basis\"], flat3]\n];",
