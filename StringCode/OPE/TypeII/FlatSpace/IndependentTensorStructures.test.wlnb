  {
   "kind": 2,
   "value": "evaluatorPrimeData = Private`primeEvaluationData[32009];\n(* Evaluator Test 1: Prime evaluation data has correct prime tag and gamma-table dimensions. *)\nevaluatorTest1 = testReport[\n  \"Evaluator Test 1 (prime data dimensions)\",\n  evaluatorPrimeData[\"Prime\"] == 32009 &&\n    Length[evaluatorPrimeData[\"GammaUD\"]] == 10 &&\n    Length[evaluatorPrimeData[\"GammaDU\"]] == 10 &&\n    Dimensions[evaluatorPrimeData[\"GammaUD\"][[1]]] == {16, 16}\n];\n\nevaluatorVectorFactor = SelectFirst[\n  Flatten[Private`candidateFactors /@ apiFlat3, 1],\n  With[{parts = Private`gammaFactorPartsSelector[#]},\n    AssociationQ[parts] && Length[parts[\"VectorLinks\"]] > 0\n  ] &,\n  Missing[\"NotFound\"]\n];\nevaluatorVectorParts = If[evaluatorVectorFactor === Missing[\"NotFound\"], $Failed, Private`gammaFactorPartsSelector[evaluatorVectorFactor]];\nevaluatorHead = If[evaluatorVectorParts === $Failed, $Failed, Head[evaluatorVectorParts[\"VectorLinks\"][[1]]]];\nevaluatorHeadMatrix = If[evaluatorHead === $Failed, $Failed, Private`gammaHeadBasisMatrix[evaluatorHead, 1, evaluatorPrimeData]];\n(* Evaluator Test 2: Gamma head matrix lookup returns valid 16x16 matrix for selected vector head. *)\nevaluatorTest2 = testReport[\n  \"Evaluator Test 2 (gamma head basis matrix lookup)\",\n  evaluatorVectorFactor =!= Missing[\"NotFound\"] && MatrixQ[evaluatorHeadMatrix] && Dimensions[evaluatorHeadMatrix] == {16, 16}\n];\n\nevaluatorRuntime3 = Private`listSelectionRuntime[\n  apiFlat3,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3, \"ModulusPrimes\" -> {32009}|>,\n  5\n];\nevaluatorProbe3 = evaluatorRuntime3[\"Probes\"][[1]];\nevaluatorPrimeData3 = evaluatorRuntime3[\"PrimeData\"][32009];\nevaluatorSpin1 = evaluatorProbe3[\"SpinorComponents\"][evaluatorVectorParts[\"Spinors\"][[1]]];\nevaluatorSpin2 = evaluatorProbe3[\"SpinorComponents\"][evaluatorVectorParts[\"Spinors\"][[2]]];\nevaluatorMatrixAssoc = Private`gammaFactorMatrixAssociation[evaluatorVectorParts, evaluatorPrimeData3];\nevaluatorScratch = matrixCoeffsFromAssociation[evaluatorMatrixAssoc, evaluatorSpin1, evaluatorSpin2, evaluatorPrimeData3[\"Prime\"]];\nevaluatorCoeffs = Private`gammaFactorCoefficientAssociation[evaluatorVectorFactor, evaluatorProbe3, evaluatorPrimeData3];\n(* Evaluator Test 3: Matrix-association contraction path matches direct coefficient contraction. *)\nevaluatorTest3 = testReport[\n  \"Evaluator Test 3 (matrix coefficient contraction path)\",\n  assocEntriesQ[evaluatorCoeffs, evaluatorScratch]\n];\n\nevaluatorRank6Heads = {GammaUDHold[mu1], GammaDUHold[mu2], GammaUDHold[mu3], GammaDUHold[mu4], GammaUDHold[mu5], GammaDUHold[mu6]};\nevaluatorRank6Matrix = Private`antisymmetrizedVectorMatrix[evaluatorRank6Heads, Range[6], evaluatorPrimeData3];\nevaluatorRank6Scratch = antisymmetrizedMatrixScratch[evaluatorRank6Heads, Range[6], evaluatorPrimeData3];\n(* Evaluator Test 4: Rank-6 antisymmetrized DP matrix matches brute-force antisymmetrization. *)\nevaluatorTest4 = testReport[\n  \"Evaluator Test 4 (rank-6 antisymmetrized DP)\",\n  evaluatorRank6Matrix === evaluatorRank6Scratch\n];\n\nevaluatorReduced = Private`reduceFactorCoefficientsByExternalVectors[\n  evaluatorCoeffs,\n  evaluatorVectorParts[\"VectorSymbols\"],\n  evaluatorProbe3,\n  evaluatorPrimeData3[\"Prime\"]\n];\nevaluatorAssignedCount = Count[\n  evaluatorVectorParts[\"VectorSymbols\"],\n  symbol_ /; KeyExistsQ[evaluatorProbe3[\"VectorComponents\"], symbol]\n];\n(* Evaluator Test 5: External-vector substitution bookkeeping leaves expected number of dummy symbols. *)\nevaluatorTest5 = testReport[\n  \"Evaluator Test 5 (external vector reduction bookkeeping)\",\n  Length[evaluatorReduced[\"DummySymbols\"]] == Length[evaluatorVectorParts[\"VectorSymbols\"]] - evaluatorAssignedCount\n];\n\nevaluatorTuples = Private`disjointBlockBasisTuples[{2, 1}];\n(* Evaluator Test 6: disjointBlockBasisTuples[{2,1}] returns expected count/shape/disjointness. *)\nevaluatorTest6 = testReport[\n  \"Evaluator Test 6 (disjoint block tuple enumeration)\",\n  Length[evaluatorTuples] == 360 &&\n    AllTrue[\n      evaluatorTuples,\n      Length[#] == 2 && Length[#[[1]]] == 2 && Length[#[[2]]] == 1 && DuplicateFreeQ[Flatten[#]] &\n    ]\n];\n\nevaluatorRuntime1 = Private`listSelectionRuntime[\n  apiFlat1,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 2, \"VerificationProbeCount\" -> 1, \"ModulusPrimes\" -> {32009}|>,\n  2\n];\nevaluatorProbe1 = evaluatorRuntime1[\"Probes\"][[1]];\nevaluatorPrimeData1 = evaluatorRuntime1[\"PrimeData\"][32009];\nevaluatorCandidateExpr = First[apiFlat1];\nevaluatorCandidateParsed = Private`parseCandidate[evaluatorCandidateExpr];\nevaluatorValueParsed = Private`evaluateCandidateAtProbe[evaluatorCandidateParsed, evaluatorProbe1, evaluatorPrimeData1];\nevaluatorValueRaw = Private`evaluateCandidateAtProbe[evaluatorCandidateExpr, evaluatorProbe1, evaluatorPrimeData1];\n(* Evaluator Test 7: Parsed-candidate and raw-expression evaluation at a probe are identical. *)\nevaluatorTest7 = testReport[\n  \"Evaluator Test 7 (parsed/raw candidate evaluation parity)\",\n  IntegerQ[evaluatorValueParsed] && evaluatorValueParsed == evaluatorValueRaw\n];\n\nevaluatorBrokenCandidate = <|\"Key\" -> \"broken-dummy\", \"FactorParts\" -> {<|\"VectorSymbols\" -> {evaluatorDanglingDummy}|>}|>;\nevaluatorBrokenProbe = <|\"SpinorComponents\" -> <||>, \"VectorComponents\" -> <||>|>;\n(* Evaluator Test 8: Broken dummy incidence (unpaired dummy symbol) is rejected ($Failed). *)\nevaluatorTest8 = testReport[\n  \"Evaluator Test 8 (reject unpaired dummy incidence)\",\n  Private`candidateStructureData[evaluatorBrokenCandidate, evaluatorBrokenProbe] === $Failed\n];",
   "languageId": "wolfram",
