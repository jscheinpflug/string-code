{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace IndependentTensorStructures Tests\n\nPublic regression checks for streaming modular basis selection.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[\n  <|\n    \"theory\" -> \"TypeII\",\n    \"CFT\" -> \"FlatSpace\",\n    \"conventions\" -> \"TypeII-Xi\",\n    \"bracket\" -> \"Flat\"\n  |>\n];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`IndependentTensorStructures`\"];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1773103385419,
     "endTime": 1773103386105
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nflattenCandidates[groups_] := Flatten[groups, 1];\nbasisSubsetQ[basis_, candidates_] := And @@ (MemberQ[candidates, #] & /@ basis);\nbasisLength[result_Association] := Length[result[\"Basis\"]];\nassocEntriesQ[left_Association, right_Association] := SortBy[Normal[left], First] === SortBy[Normal[right], First];\nmatrixCoeffsFromAssociation[matrixAssoc_Association, spin1_List, spin2_List, prime_Integer] := Association @ Select[\n  KeyValueMap[(#1 -> Mod[spin1 . #2 . spin2, prime]) &, matrixAssoc],\n  Last[#] =!= 0 &\n];\nantisymmetrizedMatrixScratch[vectorHeads_List, basisSubset_List, primeData_Association] := Module[\n  {rank = Length[vectorHeads], perms, sumMatrix, factors},\n  perms = Permutations[Range[rank]];\n  sumMatrix = ConstantArray[0, {16, 16}];\n  Do[\n    factors = Table[\n      Private`gammaHeadBasisMatrix[Head[vectorHeads[[perm[[i]]]]], basisSubset[[i]], primeData],\n      {i, 1, rank}\n    ];\n    sumMatrix = Mod[\n      sumMatrix + Signature[perm] Fold[Private`matrixProductMod[#1, #2, primeData[\"Prime\"]] &, primeData[\"Identity\"], factors],\n      primeData[\"Prime\"]\n    ],\n    {perm, perms}\n  ];\n  Mod[PowerMod[Factorial[rank], -1, primeData[\"Prime\"]] sumMatrix, primeData[\"Prime\"]]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1773103386105,
     "endTime": 1773103386598
    },
    "executionOrder": 4,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "## Public Regressions",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "scalarGroups = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nscalarFlat = flattenCandidates[scalarGroups];\nscalarAssoc = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nscalarList = findIndependentTensorStructures[scalarFlat, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest0 = testReport[\n  \"Test 0 (scalar basis selection)\",\n  scalarGroups === {{1}} && scalarFlat === {1} &&\n    scalarAssoc[\"Basis\"] === {1} && scalarAssoc[\"TargetRank\"] == 1 && scalarAssoc[\"VisitedCandidates\"] == 1 &&\n    scalarList[\"Basis\"] === {1} && scalarList[\"TargetRank\"] == 1 && scalarList[\"VisitedCandidates\"] == 1\n];",
   "languageId": "wolfram",
