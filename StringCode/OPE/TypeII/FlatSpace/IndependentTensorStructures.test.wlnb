  {
   "kind": 2,
   "value": "deltaIncoming1 = <|\"vector\" -> {mu, nu}, \"spinor\" -> {}|>;\ndeltaOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaGroups1 = generateTensorStructures[deltaIncoming1, deltaOutgoing1];\ndeltaFlat1 = flattenCandidates[deltaGroups1];\ndeltaAssoc1 = findIndependentTensorStructures[deltaIncoming1, deltaOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ndeltaList1 = findIndependentTensorStructures[deltaFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ndeltaTest1 = testReport[\n  \"Delta Test 1 (2-vector association-list parity)\",\n  deltaGroups1 === {{\\[Delta][mu, nu]}} &&\n    deltaFlat1 === {\\[Delta][mu, nu]} &&\n    deltaAssoc1[\"Basis\"] === {\\[Delta][mu, nu]} && deltaAssoc1[\"TargetRank\"] == 1 && deltaAssoc1[\"VisitedCandidates\"] == 1 &&\n    deltaList1[\"Basis\"] === {\\[Delta][mu, nu]} && deltaList1[\"TargetRank\"] == 1 && deltaList1[\"VisitedCandidates\"] == 1\n];\n\ndeltaIncoming2 = <|\"vector\" -> {mu, nu, rho, sigma}, \"spinor\" -> {}|>;\ndeltaOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaGroups2 = generateTensorStructures[deltaIncoming2, deltaOutgoing2];\ndeltaFlat2 = flattenCandidates[deltaGroups2];\ndeltaAssoc2 = findIndependentTensorStructures[deltaIncoming2, deltaOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ndeltaList2 = findIndependentTensorStructures[deltaFlat2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ndeltaTest2 = testReport[\n  \"Delta Test 2 (4-vector scalar rank)\",\n  Length[deltaFlat2] == 3 &&\n    deltaAssoc2[\"Basis\"] === deltaFlat2 && deltaAssoc2[\"TargetRank\"] == 3 && deltaAssoc2[\"VisitedCandidates\"] == 3 &&\n    deltaList2[\"Basis\"] === deltaFlat2 && deltaList2[\"TargetRank\"] == 3 && deltaList2[\"VisitedCandidates\"] == 3\n];\n\ndeltaIncoming3 = <|\"vector\" -> {mu, nu}, \"spinor\" -> {{alpha, \"chiral\"}, {beta, \"antichiral\"}}|>;\ndeltaOutgoing3 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaGroups3 = generateTensorStructures[deltaIncoming3, deltaOutgoing3];\ndeltaFlat3 = flattenCandidates[deltaGroups3];\ndeltaAssoc3 = findIndependentTensorStructures[deltaIncoming3, deltaOutgoing3, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ndeltaTest3 = testReport[\n  \"Delta Test 3 (mixed scalar delta compatibility)\",\n  Length[deltaFlat3] == 2 &&\n    deltaAssoc3[\"Basis\"] === deltaFlat3 && deltaAssoc3[\"TargetRank\"] == 2 && deltaAssoc3[\"VisitedCandidates\"] == 2\n];\n\ndeltaProbe = Private`buildProbeBank[{}, {mu, nu}, 32009, 1, 5678][[1]];\ndeltaPrimeData = Private`primeEvaluationData[32009];\ndeltaParsed = Private`parseCandidate[\\[Delta][mu, nu]];\ndeltaValueParsed = Private`evaluateCandidateAtProbe[deltaParsed, deltaProbe, deltaPrimeData];\ndeltaValueRaw = Private`evaluateCandidateAtProbe[\\[Delta][mu, nu], deltaProbe, deltaPrimeData];\ndeltaValueExpected = Mod[deltaProbe[\"VectorComponents\"][mu] . deltaProbe[\"VectorComponents\"][nu], deltaPrimeData[\"Prime\"]];\n\ndeltaTest4 = testReport[\n  \"Delta Test 4 (direct evaluator dot product)\",\n  IntegerQ[deltaValueParsed] && deltaValueParsed == deltaValueRaw && deltaValueParsed == deltaValueExpected\n];\n\ndeltaCounted = countParsedCandidateVisits[\n  findIndependentTensorStructures[deltaFlat2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]]\n];\ndeltaLazyResult = deltaCounted[\"Result\"];\n\ndeltaTest5 = testReport[\n  \"Delta Test 5 (lazy parse matches visited)\",\n  AssociationQ[deltaLazyResult] &&\n    deltaCounted[\"ParseCount\"] == deltaLazyResult[\"VisitedCandidates\"] &&\n    deltaLazyResult[\"VisitedCandidates\"] == 3\n];",
