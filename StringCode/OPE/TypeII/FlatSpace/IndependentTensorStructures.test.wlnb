   "kind": 2,
   "value": "badPrime1 = Quiet[findIndependentTensorStructures[flat1, \"ModulusPrimes\" -> {32011}], {findIndependentTensorStructures::badprime}];\nbadPrime2 = Quiet[findIndependentTensorStructures[flat1, \"ModulusPrimes\" -> {9}], {findIndependentTensorStructures::badprime}];\nbadTarget = Quiet[findIndependentTensorStructures[flat1, \"TargetRank\" -> -1], {findIndependentTensorStructures::badtarget}];\ntooManyOut = Quiet[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {{a3, \"chiral\"}, {a4, \"antichiral\"}}|>\n  ],\n  {findIndependentTensorStructures::toomanyout}\n];\ninvalidExplicit = Quiet[\n  findIndependentTensorStructures[{GammaUDHold[mu]}],\n  {findIndependentTensorStructures::badarg}\n];\ninvalidExplicitLate = Quiet[\n  findIndependentTensorStructures[Append[flat4, GammaUDHold[muLateBad]]],\n  {findIndependentTensorStructures::badarg}\n];\nunreachable = Quiet[\n  findIndependentTensorStructures[flat1, \"TargetRank\" -> 20],\n  {findIndependentTensorStructures::targetunmet}\n];\n\ntest8 = testReport[\n  \"Test 8 (option validation)\",\n  badPrime1 === $Failed &&\n    badPrime2 === $Failed &&\n    badTarget === $Failed &&\n    tooManyOut === $Failed &&\n    invalidExplicit === $Failed &&\n    invalidExplicitLate === $Failed &&\n    unreachable === $Failed\n];",
