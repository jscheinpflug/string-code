  {
   "kind": 2,
   "value": "mockCandidates = {\n  <|\"Expression\" -> expr1, \"Key\" -> \"c1\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>,\n  <|\"Expression\" -> expr2, \"Key\" -> \"c2\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>,\n  <|\"Expression\" -> expr3, \"Key\" -> \"c3\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>\n};\ncontrolFlowResult = Block[\n  {Private`selectorCandidates, Private`listSelectionRuntime, Private`tryAcceptCandidate, Private`verifySelectionRuntime},\n  Private`selectorCandidates[list_List] := list;\n  Private`listSelectionRuntime[___] := <|\"AcceptedCandidates\" -> {}, \"VerificationCalls\" -> 0|>;\n  Private`tryAcceptCandidate[candidate_, runtime_] := Module[{nextRuntime = runtime},\n    AssociateTo[nextRuntime, \"AcceptedCandidates\" -> Append[nextRuntime[\"AcceptedCandidates\"], candidate]];\n    <|\"Runtime\" -> nextRuntime, \"Status\" -> \"Accepted\"|>\n  ];\n  Private`verifySelectionRuntime[runtime_, _] := Module[{nextRuntime = runtime, calls},\n    calls = Lookup[nextRuntime, \"VerificationCalls\", 0] + 1;\n    AssociateTo[nextRuntime, \"VerificationCalls\" -> calls];\n    If[calls == 1,\n      AssociateTo[nextRuntime, \"AcceptedCandidates\" -> {First[nextRuntime[\"AcceptedCandidates\"]]}]\n    ];\n    nextRuntime\n  ];\n  Private`scanCandidateList[mockCandidates, 2, <||>]\n];\n\ntest7 = testReport[\n  \"Test 7 (resume scanning after verification)\",\n  controlFlowResult[\"Basis\"] === {expr1, expr3} && controlFlowResult[\"TargetRank\"] == 2 && controlFlowResult[\"VisitedCandidates\"] == 3\n];",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 7 (resume scanning after verification): PASSED\n</pre>",
