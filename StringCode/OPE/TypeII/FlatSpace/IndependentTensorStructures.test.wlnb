  {
   "kind": 2,
   "value": "groups2 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}, {a4, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nflat2 = flattenCandidates[groups2];\nassoc2 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"antichiral\"}, {a4, \"antichiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist2 = findIndependentTensorStructures[flat2, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest2 = testReport[\n  \"Test 2 (2 chiral + 2 antichiral -> scalar)\",\n  Length[flat2] == 17 &&\n    basisLength[assoc2] == 3 && assoc2[\"TargetRank\"] == 3 &&\n    basisLength[list2] == 3 && list2[\"TargetRank\"] == 3 &&\n    basisSubsetQ[assoc2[\"Basis\"], flat2] && basisSubsetQ[list2[\"Basis\"], flat2]\n];",
