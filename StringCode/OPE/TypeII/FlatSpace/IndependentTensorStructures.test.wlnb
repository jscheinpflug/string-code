  {
   "kind": 1,
   "value": "## Selector Submodule Tests",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Selector Test 1: probeModulus equals LCM of active primes. *)\nselectorTest1 = testReport[\n  \"Selector Test 1 (probe modulus)\",\n  Private`probeModulus[{32009, 32057, 32089}] == LCM[32009, 32057, 32089]\n];\n\nselectorProbeA = Private`buildProbeBank[{selAlpha, selBeta}, {selMu}, 101, 3, 987654];\nselectorProbeB = Private`buildProbeBank[{selAlpha, selBeta}, {selMu}, 101, 3, 987654];\n(* Selector Test 2: Probe bank generation is deterministic for fixed seed and has correct spinor/vector dimensions. *)\nselectorTest2 = testReport[\n  \"Selector Test 2 (deterministic probe bank)\",\n  selectorProbeA === selectorProbeB &&\n    Length[selectorProbeA] == 3 &&\n    Length[selectorProbeA[[1]][\"SpinorComponents\"][selAlpha]] == 16 &&\n    Length[selectorProbeA[[1]][\"VectorComponents\"][selMu]] == 10\n];\n\nselectorPivot0 = Private`initialPivotState[11];\nselectorInsert1 = Private`incrementalPivotInsert[selectorPivot0, {1, 0, 0, 0}];\nselectorInsert2 = Private`incrementalPivotInsert[selectorInsert1[\"State\"], {0, 1, 0, 0}];\nselectorInsert3 = Private`incrementalPivotInsert[selectorInsert2[\"State\"], {1, 1, 0, 0}];\n(* Selector Test 3: Incremental pivot insertion increases rank for independent rows and rejects dependent row. *)\nselectorTest3 = testReport[\n  \"Selector Test 3 (incremental pivot insertion)\",\n  TrueQ[selectorInsert1[\"RankIncreased\"]] &&\n    TrueQ[selectorInsert2[\"RankIncreased\"]] &&\n    !TrueQ[selectorInsert3[\"RankIncreased\"]] &&\n    Length[selectorInsert2[\"State\"][\"PivotColumns\"]] == 2\n];\n\nselectorMetadata1 = Private`selectorCandidateMetadata[apiFlat1];\nselectorRuntime1 = Private`selectionRuntimeFromMetadata[\n  selectorMetadata1,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 3, \"VerificationProbeCount\" -> 2, \"ModulusPrimes\" -> {32009, 32057}|>,\n  8\n];\n(* Selector Test 4: Runtime preallocates probe bank to requested target rank width. *)\nselectorTest4 = testReport[\n  \"Selector Test 4 (runtime probe preallocation)\",\n  Length[selectorRuntime1[\"Probes\"]] == 8 &&\n    Sort[selectorRuntime1[\"Primes\"]] === {32009, 32057}\n];\n\n(* Selector Test 5: automaticCandidateTargetRank from metadata returns expected bound. *)\nselectorTest5 = testReport[\n  \"Selector Test 5 (automatic target inference from metadata)\",\n  Private`automaticCandidateTargetRank[selectorMetadata1] == 2\n];\n\nselectorScanOpts = <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3, \"ModulusPrimes\" -> {32009, 32057, 32089}|>;\nselectorParsed1 = Private`selectorCandidates[apiFlat1];\nselectorScanParsed = Private`scanCandidateList[selectorParsed1, Automatic, selectorScanOpts];\nselectorScanRaw = Private`scanRawCandidateList[apiFlat1, Automatic, selectorScanOpts];\n(* Selector Test 6: Parsed-list scan and raw-list scan produce identical basis/target/visited results. *)\nselectorTest6 = testReport[\n  \"Selector Test 6 (parsed/raw scan parity)\",\n  selectorScanParsed[\"Basis\"] === selectorScanRaw[\"Basis\"] &&\n    selectorScanParsed[\"TargetRank\"] == selectorScanRaw[\"TargetRank\"] &&\n    selectorScanParsed[\"VisitedCandidates\"] == selectorScanRaw[\"VisitedCandidates\"]\n];\n\nselectorMockCandidates = {\n  <|\"Expression\" -> selectorExpr1, \"Key\" -> \"selector-c1\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>,\n  <|\"Expression\" -> selectorExpr2, \"Key\" -> \"selector-c2\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>,\n  <|\"Expression\" -> selectorExpr3, \"Key\" -> \"selector-c3\", \"SpinorChiralities\" -> <||>, \"ExternalVectors\" -> {}|>\n};\nselectorControlFlow = Block[\n  {Private`selectorCandidates, Private`listSelectionRuntime, Private`tryAcceptCandidate, Private`verifySelectionRuntime},\n  Private`selectorCandidates[listInput_List] := listInput;\n  Private`listSelectionRuntime[___] := <|\"AcceptedCandidates\" -> {}, \"VerificationCalls\" -> 0|>;\n  Private`tryAcceptCandidate[candidateInput_, runtimeInput_] := Module[{nextRuntime = runtimeInput},\n    AssociateTo[nextRuntime, \"AcceptedCandidates\" -> Append[nextRuntime[\"AcceptedCandidates\"], candidateInput]];\n    <|\"Runtime\" -> nextRuntime, \"Status\" -> \"Accepted\"|>\n  ];\n  Private`verifySelectionRuntime[runtimeInput_, _] := Module[{nextRuntime = runtimeInput, calls},\n    calls = Lookup[nextRuntime, \"VerificationCalls\", 0] + 1;\n    AssociateTo[nextRuntime, \"VerificationCalls\" -> calls];\n    If[calls == 1,\n      AssociateTo[nextRuntime, \"AcceptedCandidates\" -> {First[nextRuntime[\"AcceptedCandidates\"]]}]\n    ];\n    nextRuntime\n  ];\n  Private`scanCandidateList[selectorMockCandidates, 2, <||>]\n];\n(* Selector Test 7: Control-flow regression: scanner resumes after verification prunes accepted candidates. *)\nselectorTest7 = testReport[\n  \"Selector Test 7 (resume after verification)\",\n  selectorControlFlow[\"Basis\"] === {selectorExpr1, selectorExpr3} &&\n    selectorControlFlow[\"TargetRank\"] == 2 &&\n    selectorControlFlow[\"VisitedCandidates\"] == 3\n];\n\nselectorCounted = countParsedCandidateVisits[\n  findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]]\n];\nselectorLazyResult = selectorCounted[\"Result\"];\n(* Selector Test 8: Lazy parsing regression: number of parsed candidates equals reported visited candidates. *)\nselectorTest8 = testReport[\n  \"Selector Test 8 (lazy parse matches visited)\",\n  AssociationQ[selectorLazyResult] &&\n    selectorCounted[\"ParseCount\"] == selectorLazyResult[\"VisitedCandidates\"]\n];",
   "languageId": "wolfram",
   "outputs": [
