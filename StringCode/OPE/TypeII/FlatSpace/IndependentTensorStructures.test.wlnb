{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace IndependentTensorStructures Tests\n\nExact selector coverage for the public API and the shared gamma-kernel engine.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[\n  <|\n    \"theory\" -> \"TypeII\",\n    \"CFT\" -> \"FlatSpace\",\n    \"conventions\" -> \"TypeII-Xi\",\n    \"bracket\" -> \"Flat\"\n  |>\n];\nNeeds[\"StringCode`OPE`TypeII`FlatSpace`IndependentTensorStructures`\"];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];\n\nbaseSelectorOptions = <|\n  \"RandomSeed\" -> 1234,\n  \"ProbeCount\" -> 5,\n  \"VerificationProbeCount\" -> 3\n|>;\n\nselectorOptionRules[overrides___Rule] := Normal @ Join[baseSelectorOptions, <|overrides|>];\nflattenCandidates[groupList_] := Flatten[groupList, 1];\nbasisSubsetQ[basisList_, candidateList_] := And @@ (MemberQ[candidateList, #] & /@ basisList);\nbasisLength[result_Association] := Length[result[\"Basis\"]];\nselectorCacheCounts[] := <|\n  \"Slice\" -> Total[Length /@ Values[Private`spinProjectionGammaKernelSliceCache]],\n  \"SelectorFamily\" -> Length[Keys[Private`spinProjectionSelectorFamilyCompileCache]],\n  \"Probe\" -> Length[Keys[Private`spinProjectionGammaKernelProbeCache]],\n  \"Pair\" -> Length[Keys[Private`spinProjectionGammaKernelPairMatrixCache]]\n|>;\nclearKernelCaches[] := (\n  Private`spinProjectionGammaKernelSliceCache = <||>;\n  Private`spinProjectionConcreteGammaEntryRulesCache = <||>;\n  Private`spinProjectionGammaKernelProbeCache = <||>;\n  Private`spinProjectionGammaKernelPairMatrixCache = <||>;\n  Private`spinProjectionSelectorFamilyCompileCache = <||>;\n);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Public API",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "apiIncoming1 = <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>;\napiOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiGroups1 = generateTensorStructures[apiIncoming1, apiOutgoing1];\napiFlat1 = flattenCandidates[apiGroups1];\napiAssoc1 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiList1 = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiRankOne = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[\"TargetRank\" -> 1, \"ReturnStatistics\" -> True]];\napiNested = findIndependentTensorStructures[apiGroups1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiPlain = findIndependentTensorStructures[apiFlat1, Sequence @@ selectorOptionRules[]];\napiIncoming2 = <|\"vector\" -> {}, \"spinor\" -> {{b1, \"chiral\"}, {b2, \"chiral\"}, {b3, \"antichiral\"}, {b4, \"antichiral\"}}|>;\napiOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\napiAssoc2 = findIndependentTensorStructures[apiIncoming2, apiOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\napiBadOption = Quiet[findIndependentTensorStructures[apiFlat1, \"ModulusPrimes\" -> {32009}], {findIndependentTensorStructures::badopt}];\napiBadTarget = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> -1], {findIndependentTensorStructures::badtarget}];\napiTooManyOut = Quiet[\n  findIndependentTensorStructures[\n    <|\"vector\" -> {}, \"spinor\" -> {{d1, \"chiral\"}, {d2, \"chiral\"}}|>,\n    <|\"vector\" -> {}, \"spinor\" -> {{d3, \"chiral\"}, {d4, \"antichiral\"}}|>\n  ],\n  {findIndependentTensorStructures::toomanyout}\n];\napiInvalidExplicit = Quiet[findIndependentTensorStructures[{GammaUDHold[muBad]}], {findIndependentTensorStructures::badarg}];\napiUnreachable = Quiet[findIndependentTensorStructures[apiFlat1, \"TargetRank\" -> 20], {findIndependentTensorStructures::targetunmet}];\n\napiTest1 = testReport[\n  \"API Test 1 (scalar/chiral association-list parity)\",\n  Length[apiFlat1] == 15 &&\n    basisLength[apiAssoc1] == 2 && apiAssoc1[\"TargetRank\"] == 2 &&\n    basisLength[apiList1] == 2 && apiList1[\"TargetRank\"] == 2 &&\n    basisSubsetQ[apiAssoc1[\"Basis\"], apiFlat1] && basisSubsetQ[apiList1[\"Basis\"], apiFlat1]\n];\n\napiTest2 = testReport[\n  \"API Test 2 (explicit target rank)\",\n  basisLength[apiRankOne] == 1 && apiRankOne[\"TargetRank\"] == 1 && apiRankOne[\"VisitedCandidates\"] >= 1\n];\n\napiTest3 = testReport[\n  \"API Test 3 (nested normalization and return shape)\",\n  apiNested[\"Basis\"] === apiList1[\"Basis\"] &&\n    apiNested[\"TargetRank\"] == apiList1[\"TargetRank\"] &&\n    ListQ[apiPlain] && Sort[Keys[apiList1]] === {\"Basis\", \"TargetRank\", \"VisitedCandidates\"}\n];\n\napiTest4 = testReport[\n  \"API Test 4 (automatic target inference)\",\n  apiAssoc2[\"TargetRank\"] == 3 && basisLength[apiAssoc2] == 3\n];\n\napiTest5 = testReport[\n  \"API Test 5 (validation failures)\",\n  apiBadOption === $Failed &&\n    apiBadTarget === $Failed &&\n    apiTooManyOut === $Failed &&\n    apiInvalidExplicit === $Failed &&\n    apiUnreachable === $Failed\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Exact Selector Internals",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "selectorMetadata1 = Private`selectorCandidateMetadata[apiFlat1];\nselectorRuntime1 = Private`selectionRuntimeFromMetadata[\n  selectorMetadata1,\n  <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 3, \"VerificationProbeCount\" -> 2|>,\n  3\n];\nselectorAssignmentA = Private`selectorAssignmentAt[selectorRuntime1, 1];\nselectorAssignmentB = Private`selectorAssignmentAt[selectorRuntime1, 1];\nselectorPivot0 = Private`initialPivotState[];\nselectorInsert1 = Private`incrementalPivotInsert[selectorPivot0, {1, 0, 0, 0}];\nselectorInsert2 = Private`incrementalPivotInsert[selectorInsert1[\"State\"], {0, 1, 0, 0}];\nselectorInsert3 = Private`incrementalPivotInsert[selectorInsert2[\"State\"], {1, 1, 0, 0}];\nselectorCompiled1 = Private`selectorCandidates[apiFlat1];\nselectorScanParsed = Private`scanCandidateList[selectorCompiled1, Automatic, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3|>];\nselectorScanRaw = Private`scanRawCandidateList[apiFlat1, Automatic, <|\"RandomSeed\" -> 1234, \"ProbeCount\" -> 5, \"VerificationProbeCount\" -> 3|>];\nselectorZero = Private`spinProjectionNormalizeCompiledTermParts[{{0, {1, 1}, {4, 1}}, {0, {1, 1}, {4, 2}}}];\n\nselectorTest1 = testReport[\n  \"Selector Test 1 (deterministic exact assignments)\",\n  selectorAssignmentA === selectorAssignmentB &&\n    selectorRuntime1[\"SpinorSymbols\"] === {a1, a2, a3, a4} &&\n    Keys[selectorAssignmentA[\"SpinorComponents\"]] === selectorRuntime1[\"SpinorSymbols\"] &&\n    selectorAssignmentA[\"VectorComponents\"] === <||> &&\n    AllTrue[Values[selectorAssignmentA[\"SpinorComponents\"]], Length[#] == 16 &]\n];\n\nselectorTest2 = testReport[\n  \"Selector Test 2 (incremental exact pivot insertion)\",\n  TrueQ[selectorInsert1[\"RankIncreased\"]] &&\n    TrueQ[selectorInsert2[\"RankIncreased\"]] &&\n    !TrueQ[selectorInsert3[\"RankIncreased\"]] &&\n    selectorInsert2[\"State\"][\"PivotColumns\"] === {1, 2}\n];\n\nselectorTest3 = testReport[\n  \"Selector Test 3 (parsed/raw scan parity)\",\n  selectorScanParsed[\"Basis\"] === selectorScanRaw[\"Basis\"] &&\n    selectorScanParsed[\"TargetRank\"] == selectorScanRaw[\"TargetRank\"] &&\n    selectorScanParsed[\"VisitedCandidates\"] == selectorScanRaw[\"VisitedCandidates\"]\n];\n\nselectorTest4 = testReport[\n  \"Selector Test 4 (contradictory vector equalities vanish)\",\n  selectorZero[\"ScalarFactor\"] == 0 && selectorZero[\"GammaParts\"] === {}\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Cache And Larger-Channel Smoke Tests",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "clearKernelCaches[];\ncacheBefore = selectorCacheCounts[];\ncacheResult1 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ncacheAfter1 = selectorCacheCounts[];\ncacheResult2 = findIndependentTensorStructures[apiIncoming1, apiOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ncacheAfter2 = selectorCacheCounts[];\n\ndeltaIncoming1 = <|\"vector\" -> {mu1, nu1}, \"spinor\" -> {}|>;\ndeltaOutgoing1 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaGroups1 = generateTensorStructures[deltaIncoming1, deltaOutgoing1];\ndeltaFlat1 = flattenCandidates[deltaGroups1];\ndeltaAssoc1 = findIndependentTensorStructures[deltaIncoming1, deltaOutgoing1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\ndeltaList1 = findIndependentTensorStructures[deltaFlat1, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ndeltaIncoming2 = <|\"vector\" -> {mu2, nu2, rho2, sigma2}, \"spinor\" -> {}|>;\ndeltaOutgoing2 = <|\"vector\" -> {}, \"spinor\" -> {}|>;\ndeltaFlat2 = flattenCandidates[generateTensorStructures[deltaIncoming2, deltaOutgoing2]];\ndeltaAssoc2 = findIndependentTensorStructures[deltaIncoming2, deltaOutgoing2, Sequence @@ selectorOptionRules[\"ReturnStatistics\" -> True]];\n\ncacheTest1 = testReport[\n  \"Cache Test 1 (repeated selector run reuses family/probe caches)\",\n  cacheBefore === <|\"Slice\" -> 0, \"SelectorFamily\" -> 0, \"Probe\" -> 0, \"Pair\" -> 0|> &&\n    cacheAfter1[\"SelectorFamily\"] > 0 && cacheAfter1[\"Probe\"] > 0 && cacheAfter1[\"Pair\"] > 0 &&\n    cacheAfter2 === cacheAfter1 &&\n    cacheResult1[\"Basis\"] === cacheResult2[\"Basis\"]\n];\n\ndeltaTest1 = testReport[\n  \"Delta Test 1 (2-vector association-list parity)\",\n  deltaGroups1 === {{\\[Delta][mu1, nu1]}} &&\n    deltaAssoc1[\"Basis\"] === {\\[Delta][mu1, nu1]} && deltaAssoc1[\"TargetRank\"] == 1 &&\n    deltaList1[\"Basis\"] === {\\[Delta][mu1, nu1]} && deltaList1[\"TargetRank\"] == 1\n];\n\ndeltaTest2 = testReport[\n  \"Delta Test 2 (4-vector scalar rank)\",\n  Length[deltaFlat2] == 3 &&\n    deltaAssoc2[\"Basis\"] === deltaFlat2 && deltaAssoc2[\"TargetRank\"] == 3\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Print[\"ALL_TESTS_PASSED: \", allTestsPassed];\nallTestsPassed",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "nbformat": 4
}
