  {
   "kind": 2,
   "value": "groups1 = generateTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>\n];\nflat1 = flattenCandidates[groups1];\nassoc1 = findIndependentTensorStructures[\n  <|\"vector\" -> {}, \"spinor\" -> {{a1, \"chiral\"}, {a2, \"chiral\"}, {a3, \"chiral\"}, {a4, \"chiral\"}}|>,\n  <|\"vector\" -> {}, \"spinor\" -> {}|>,\n  \"RandomSeed\" -> 1234,\n  \"ReturnStatistics\" -> True\n];\nlist1 = findIndependentTensorStructures[flat1, \"RandomSeed\" -> 1234, \"ReturnStatistics\" -> True];\n\ntest1 = testReport[\n  \"Test 1 (4 chiral -> scalar)\",\n  Length[flat1] == 15 &&\n    basisLength[assoc1] == 2 && assoc1[\"TargetRank\"] == 2 && assoc1[\"VisitedCandidates\"] < Length[flat1] &&\n    basisLength[list1] == 2 && list1[\"TargetRank\"] == 2 &&\n    basisSubsetQ[assoc1[\"Basis\"], flat1] && basisSubsetQ[list1[\"Basis\"], flat1]\n];",
