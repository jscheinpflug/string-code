  {
   "kind": 1,
   "value": "## Spin Field OPE (Matter Basis + Tensor Structures)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 7: \\[Psi] \\[Times] S at weight 1 (picture -1/2, R sector output), via helper pipeline *)\ndataA = Private`getOutgoingOperatorsTensors[{R[\\[Psi][\\[Mu], 0, z]], R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, w]]}, 1, 0];\n{holoA, nA} = Which[dataA[\"holoOps\"] === {}, {1, 0}, dataA[\"holoData\"] === {}, {0, 0}, True, Private`attachCoefficients[dataA[\"holoData\"], 0]];\n{antiA, nA} = Which[dataA[\"antiOps\"] === {}, {1, nA}, dataA[\"antiData\"] === {}, {0, nA}, True, Private`attachCoefficients[dataA[\"antiData\"], nA]];\nresultA = dataA[\"sign\"] Private`combineChiral[holoA, antiA];\ntest7Result = And[\n  resultA =!= 0,\n  Not[FreeQ[resultA, R]],\n  Not[FreeQ[resultA, S]],\n  Not[FreeQ[resultA, GammaProduct]]\n];\nPrint[\"Test 7 (\\[Psi] \\[Times] S spin field symbolic pipeline): \", If[test7Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultA = \", resultA];\ntest7Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 8: S \\[Times] S at weight 1 (picture -1, NS sector output), via helper pipeline *)\ndataB = Private`getOutgoingOperatorsTensors[{R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, z]], R[S[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]]}, 1, 0];\n{holoB, nB} = Which[dataB[\"holoOps\"] === {}, {1, 0}, dataB[\"holoData\"] === {}, {0, 0}, True, Private`attachCoefficients[dataB[\"holoData\"], 0]];\n{antiB, nB} = Which[dataB[\"antiOps\"] === {}, {1, nB}, dataB[\"antiData\"] === {}, {0, nB}, True, Private`attachCoefficients[dataB[\"antiData\"], nB]];\nresultB = dataB[\"sign\"] Private`combineChiral[holoB, antiB];\ntest8Result = And[\n  resultB =!= 0,\n  Not[FreeQ[resultB, R]],\n  Not[FreeQ[resultB, GammaProduct]]\n];\nPrint[\"Test 8 (S \\[Times] S spin field symbolic pipeline): \", If[test8Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultB = \", resultB];\ntest8Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 9: Mixed holo/anti-holo Grassmann sign, via helper pipeline *)\ndataC = Private`getOutgoingOperatorsTensors[{R[\\[Psi][\\[Mu], 0, z], \\[Psi]t[\\[Nu], 0, z]], R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, w], St[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]]}, 1, 1];\n{holoC, nC} = Which[dataC[\"holoOps\"] === {}, {1, 0}, dataC[\"holoData\"] === {}, {0, 0}, True, Private`attachCoefficients[dataC[\"holoData\"], 0]];\n{antiC, nC} = Which[dataC[\"antiOps\"] === {}, {1, nC}, dataC[\"antiData\"] === {}, {0, nC}, True, Private`attachCoefficients[dataC[\"antiData\"], nC]];\nresultC = dataC[\"sign\"] Private`combineChiral[holoC, antiC];\ntest9Result = And[\n  resultC =!= 0,\n  Not[FreeQ[resultC, R]],\n  Not[FreeQ[resultC, S]],\n  Not[FreeQ[resultC, St]]\n];\nPrint[\"Test 9 (mixed holo/anti-holo symbolic pipeline): \", If[test9Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultC = \", resultC];\ntest9Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 10: Pure antiholomorphic St \\[Times] St, via helper pipeline *)\ndataD = Private`getOutgoingOperatorsTensors[{R[St[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, z]], R[St[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]]}, 0, 1];\n{holoD, nD} = Which[dataD[\"holoOps\"] === {}, {1, 0}, dataD[\"holoData\"] === {}, {0, 0}, True, Private`attachCoefficients[dataD[\"holoData\"], 0]];\n{antiD, nD} = Which[dataD[\"antiOps\"] === {}, {1, nD}, dataD[\"antiData\"] === {}, {0, nD}, True, Private`attachCoefficients[dataD[\"antiData\"], nD]];\nresultD = dataD[\"sign\"] Private`combineChiral[holoD, antiD];\ntest10Result = And[\n  resultD =!= 0,\n  Not[FreeQ[resultD, R]],\n  Not[FreeQ[resultD, \\[Psi]t]],\n  Not[FreeQ[resultD, GammaProduct]]\n];\nPrint[\"Test 10 (St \\[Times] St anti-holo symbolic pipeline): \", If[test10Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultD = \", resultD];\ntest10Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Spin Field OPE (Randomized Association API)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 11: \\[Psi] \\[Times] S Association output contract *)\nresultE = OPEProjected[1, 0][R[\\[Psi][\\[Mu], 0, z]], R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, w]], \"RandomSeed\" -> 11];\ntest11Result = And[\n  AssociationQ[resultE],\n  KeyExistsQ[resultE, \"sign\"],\n  KeyExistsQ[resultE, \"holo\"],\n  KeyExistsQ[resultE, \"anti\"],\n  KeyExistsQ[resultE, \"randomizedInputs\"],\n  MemberQ[{1, -1}, resultE[\"sign\"]],\n  Not[FreeQ[resultE[\"holo\"], _Symbol[_Integer]]],\n  Not[FreeQ[resultE[\"randomizedInputs\"], Bosonize]]\n];\nPrint[\"Test 11 (\\[Psi] \\[Times] S Association output): \", If[test11Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultE = \", resultE];\ntest11Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 12: seeded randomization is deterministic *)\nresultF1 = OPEProjected[1, 0][R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, z]], R[S[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]], \"RandomSeed\" -> 22];\nresultF2 = OPEProjected[1, 0][R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, z]], R[S[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]], \"RandomSeed\" -> 22];\ntest12Result = resultF1 === resultF2;\nPrint[\"Test 12 (seeded deterministic output): \", If[test12Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultF1 = \", resultF1];\ntest12Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 13: Mixed holo/anti-holo keeps separate sign/holo/anti fields *)\nresultG = OPEProjected[1, 1][\n  R[\\[Psi][\\[Mu], 0, z], \\[Psi]t[\\[Nu], 0, z]],\n  R[S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, w], St[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]],\n  \"RandomSeed\" -> 33\n];\ntest13Result = And[\n  AssociationQ[resultG],\n  MemberQ[{1, -1}, resultG[\"sign\"]],\n  Not[FreeQ[resultG[\"holo\"], _Symbol[_Integer]]],\n  Not[FreeQ[resultG[\"anti\"], _Symbol[_Integer]]]\n];\nPrint[\"Test 13 (mixed holo/anti-holo Association): \", If[test13Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultG = \", resultG];\ntest13Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Test 14: Pure antiholomorphic St \\[Times] St has anti contribution with coefficients *)\nresultH = OPEProjected[0, 1][R[St[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, z]], R[St[{\\[Beta], \"chiral\"}, -1/2, {}, 0, w]], \"RandomSeed\" -> 44];\ntest14Result = And[\n  AssociationQ[resultH],\n  resultH[\"holo\"] === 1,\n  Not[FreeQ[resultH[\"anti\"], _Symbol[_Integer]]],\n  Not[FreeQ[resultH[\"randomizedInputs\"], Bosonize]]\n];\nPrint[\"Test 14 (St \\[Times] St anti-holo Association): \", If[test14Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  resultH = \", resultH];\ntest14Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTests = {test1Result, test2Result, test3Result, test4Result, test5Result, test6Result, test7Result, test8Result, test9Result, test10Result, test11Result, test12Result, test13Result, test14Result};\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>\n=== SUMMARY ===\n</pre>",
       "mime": "x-application/wolfram-language-html"
