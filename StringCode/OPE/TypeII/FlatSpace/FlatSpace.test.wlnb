  {
   "kind": 2,
   "value": "lhs6 = OPEProjected[0, 0][R[\\[Psi][\\[Mu], 0, z]] + R[\\[Psi][\\[Rho], 0, z]], R[\\[Psi][\\[Nu], 0, w]]];\nrhs6 = OPEProjected[0, 0][R[\\[Psi][\\[Mu], 0, z]], R[\\[Psi][\\[Nu], 0, w]]] + OPEProjected[0, 0][R[\\[Psi][\\[Rho], 0, z]], R[\\[Psi][\\[Nu], 0, w]]];\ntest6Result = Simplify[lhs6 - rhs6] === 0;\nPrint[\"Test 6 (projection linearity): \", If[test6Result, \"PASSED\", \"FAILED\"]];\ntest6Result",
   "languageId": "wolfram",
