{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace OPE Tests\n\nDirect OPE probes, including bosonized spin-field products.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed = True;\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  If[!TrueQ[cond], allTestsPassed = False];\n  cond\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Basic OPEs",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test1 = testReport[\"Test 1 (OPE psi-psi)\", Simplify[OPE[R[\\[Psi][\\[Mu], 0, z]], R[\\[Psi][\\[Nu], 0, w]]] - (R[\\[Psi][\\[Mu], 0, z], \\[Psi][\\[Nu], 0, w]] - \\[Delta][\\[Mu], \\[Nu]]/(2 (z - w)))] === 0];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test2 = testReport[\"Test 2 (OPE psi-eta no contraction)\", Simplify[OPE[R[\\[Psi][\\[Mu], 0, z]], R[\\[Eta][0, w]]] - R[\\[Psi][\\[Mu], 0, z], \\[Eta][0, w]]] === 0];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test3 = testReport[\"Test 3 (OPE psi-dphi no contraction)\", Simplify[OPE[R[\\[Psi][\\[Mu], 0, z]], R[d\\[Phi][0, w]]] - R[\\[Psi][\\[Mu], 0, z], d\\[Phi][0, w]]] === 0];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Bosonized Spin-Field OPEs",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected4 = I*R[expH[{-1/2, 1/2, 1/2, 1/2, -1/2, -1/2}, w], expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, z]];\ntest4 = testReport[\"Test 4 (bosonized S-S OPE)\", OPE[Bosonize[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z]]], Bosonize[R[S[{{1/2, 1/2, 1/2, -1/2, -1/2}, \"chiral\"}, -1/2, {}, 0, w]]]] === expected4];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected5 = I*R[expHt[{-1/2, 1/2, 1/2, 1/2, -1/2, -1/2}, wb], expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, zb]];\ntest5 = testReport[\"Test 5 (bosonized St-St OPE)\", OPE[Bosonize[R[St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, zb]]], Bosonize[R[St[{{1/2, 1/2, 1/2, -1/2, -1/2}, \"chiral\"}, -1/2, {}, 0, wb]]]] === expected5];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected6 = R[expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, w], expH[{0, -1, 0, 0, 0, 0}, z]]/(Sqrt[2]*E^(((3*I)/4)*Pi)*Sqrt[-w + z]) + (E^(((3*I)/4)*Pi)*Sqrt[-w + z]*R[expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, w], expH[{0, 1, 0, 0, 0, 0}, z]])/Sqrt[2];\ntest6 = testReport[\"Test 6 (bosonized psi-S OPE)\", OPE[Bosonize[R[\\[Psi][1, 0, z]]], Bosonize[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, w]]]] === expected6];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected7 = R[expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, wb], expHt[{0, -1, 0, 0, 0, 0}, zb]]/(Sqrt[2]*E^(((3*I)/4)*Pi)*Sqrt[-wb + zb]) + (E^(((3*I)/4)*Pi)*Sqrt[-wb + zb]*R[expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, wb], expHt[{0, 1, 0, 0, 0, 0}, zb]])/Sqrt[2];\ntest7 = testReport[\"Test 7 (bosonized psit-St OPE)\", OPE[Bosonize[R[\\[Psi]t[1, 0, zb]]], Bosonize[R[St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, wb]]]] === expected7];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected8 = R[expH[{-1, -1, 0, 0, 0, 0}, z], expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, w]]/(Sqrt[2]*(-w + z)) + (I*R[expH[{-1, 1, 0, 0, 0, 0}, z], expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, w]])/Sqrt[2];\ntest8 = testReport[\"Test 8 (bosonized e^-phi psi with S)\", OPE[Bosonize[R[exp\\[Phi]f[-1, z], \\[Psi][1, 0, z]]], Bosonize[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, w]]]] === expected8];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expected9 = R[expHt[{-1, -1, 0, 0, 0, 0}, zb], expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, wb]]/(Sqrt[2]*(-wb + zb)) + (I*R[expHt[{-1, 1, 0, 0, 0, 0}, zb], expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, wb]])/Sqrt[2];\ntest9 = testReport[\"Test 9 (bosonized e^-phi psit with St)\", OPE[Bosonize[R[exp\\[Phi]tf[-1, zb], \\[Psi]t[1, 0, zb]]], Bosonize[R[St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, wb]]]] === expected9];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Summary",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTestsPassed",
   "languageId": "wolfram",
