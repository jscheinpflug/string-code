  {
   "kind": 2,
   "value": "expr5 = OPEProjected[0, 0][R[\\[Psi][\\[Mu], 0, z]], R[\\[Psi][\\[Nu], 0, w]]];\ntest5Result = Not[FreeQ[expr5, \\[Delta][\\[Mu], \\[Nu]]]];\nPrint[\"Test 5 (projection psi-psi contains delta): \", If[test5Result, \"PASSED\", \"FAILED\"]];\ntest5Result",
   "languageId": "wolfram",
   "outputs": [
