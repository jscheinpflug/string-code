   "kind": 2,
   "value": "projectedExcitedSpin33 = Check[\n  Canonicalize[Expand[OPEProjected[2, 0][R[S[{a1, \"antichiral\"}, -1/2, {{mu,-1}}, 0, z1]], R[exp\\[Phi]f[-1, z2], \\[Psi][nu, 0, z2]]]]],\n  $Failed,\n  Set::nosym\n];\nexpectedProjectedExcitedSpin33 = Canonicalize[Expand[((-I/4)*(z1 + 8*z2)*R[d\\[Phi][0, 0], S[{a1, \"antichiral\"}, -3/2, {}, 0, 0]]*δ[mu, nu])/(z1 - z2)^2]];\ntest33 = testReport[\"Test 33 (projected excited antichiral spin absorbs identity gamma into outgoing index)\", projectedExcitedSpin33 === expectedProjectedExcitedSpin33];\ntest33b = testReport[\"Test 33b (projected excited antichiral spin emits no zero-link gamma)\", projectedExcitedSpin33 =!= $Failed && FreeQ[projectedExcitedSpin33, GammaAntisymmetricProductHold[{}, __], Infinity]];\n\nprojectedExcitedSpin33Mirror = Check[\n  Canonicalize[Expand[OPEProjected[2, 0][R[S[{a1, \"chiral\"}, -1/2, {{mu,-1}}, 0, z1]], R[exp\\[Phi]f[-1, z2], \\[Psi][nu, 0, z2]]]]],\n  $Failed,\n  Set::nosym\n];\nexpectedProjectedExcitedSpin33Mirror = Canonicalize[Expand[((I/4)*(z1 + 8*z2)*R[d\\[Phi][0, 0], S[{a1, \"chiral\"}, -3/2, {}, 0, 0]]*δ[mu, nu])/(z1 - z2)^2]];\ntest33c = testReport[\"Test 33c (projected excited chiral spin absorbs identity gamma into outgoing index)\", projectedExcitedSpin33Mirror === expectedProjectedExcitedSpin33Mirror];\ntest33d = testReport[\"Test 33d (projected excited chiral spin emits no zero-link gamma)\", projectedExcitedSpin33Mirror =!= $Failed && FreeQ[projectedExcitedSpin33Mirror, GammaAntisymmetricProductHold[{}, __], Infinity]];\n\nprojectedFiveSpin33e = Check[\n  Canonicalize[Expand[OPEProjected[0, 0][R[S[{a1, \"chiral\"}, -1/2, {}, 0, z1]], R[S[{a2, \"chiral\"}, -1/2, {}, 0, z2]], R[S[{a3, \"chiral\"}, -1/2, {}, 0, z3]], R[S[{a4, \"chiral\"}, -1/2, {}, 0, z4]], R[S[{a5, \"chiral\"}, -1/2, {}, 0, z5]]]]],\n  $Failed,\n  Set::nosym\n];\ntest33e = testReport[\"Test 33e (projected five-spin outgoing branch emits no zero-link gamma)\", projectedFiveSpin33e =!= $Failed && FreeQ[projectedFiveSpin33e, GammaAntisymmetricProductHold[{}, __], Infinity]];\ntest33f = testReport[\"Test 33f (projected five-spin outgoing index reuses external spin labels)\", Sort[DeleteDuplicates[Cases[projectedFiveSpin33e, R[S[{idx_, \"chiral\"}, -5/2, {}, 0, 0]] :> idx, Infinity]]] === {a1, a2, a3, a4, a5}];",
