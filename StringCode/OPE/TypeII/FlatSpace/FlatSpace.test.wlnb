  {
   "kind": 1,
   "value": "## Composite Associativity",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "assocResidualNumericQ[a_, b_, c_] := TrueQ[Simplify[((OPE[OPE[a, b], c] - OPE[a, OPE[b, c]]) /. {u -> 5, ub -> 5, z -> 3, zb -> 3, w -> 1, wb -> 1}) == 0]];\nsPlus = {{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"};\nsPhase = {{1/2, 1/2, 1/2, -1/2, -1/2}, \"chiral\"};\nmixSpinSame[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], St[sPlus, -1/2, {}, 0, anti]]];\nmixSpinPhase[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], St[sPhase, -1/2, {}, 0, anti]]];\nmixPsi[coord_, anti_] := Bosonize[R[\\[Psi][1, 0, coord], \\[Psi]t[1, 0, anti]]];\nmixSpinPsi[coord_, anti_] := Bosonize[R[S[sPlus, -1/2, {}, 0, coord], \\[Psi]t[1, 0, anti]]];\nmixNS[coord_] := Bosonize[R[exp\\[Phi]f[-1, coord], \\[Psi][1, 0, coord]]];\nmixNSAnti[anti_] := Bosonize[R[exp\\[Phi]tf[-1, anti], \\[Psi]t[1, 0, anti]]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1774972182419,
     "endTime": 1774972182980
    },
    "executionOrder": 24,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "test11 = testReport[\"Test 11 (composite associativity for S-St composites)\", assocResidualNumericQ[mixSpinSame[u, ub], mixSpinPhase[z, zb], mixSpinPhase[w, wb]]];",
