{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII OPE Theory-Level Tests\n\nCFT-independent tests (superghost + linear-dilaton sectors).",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test1 = Wick[\\[Eta][0, z], \\[Xi][0, w]];\nexpected1 = 1/(z - w);\ntest1Result = Simplify[test1 - expected1] === 0;\nPrint[\"Test 1 (eta-xi Wick): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test2 = OPE[R[\\[Eta][0, z]], R[\\[Xi][0, w]]];\nexpected2 = R[\\[Eta][0, z], \\[Xi][0, w]] + 1/(z - w);\ntest2Result = Simplify[test2 - expected2] === 0;\nPrint[\"Test 2 (OPE eta-xi): \", If[test2Result, \"PASSED\", \"FAILED\"]];\ntest2Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test3 = OPE[R[d\\[Phi][0, z]], R[d\\[Phi][0, w]]];\nexpected3 = R[d\\[Phi][0, z], d\\[Phi][0, w]] - 1/(z - w)^2;\ntest3Result = Simplify[test3 - expected3] === 0;\nPrint[\"Test 3 (OPE dphi-dphi): \", If[test3Result, \"PASSED\", \"FAILED\"]];\ntest3Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test4 = OPE[R[d\\[Phi][0, z]], R[exp\\[Phi]b[a, w]]];\ntest4Result = Not[FreeQ[test4, exp\\[Phi]b]] && (Not[FreeQ[test4, 1/(z - w)]] || Not[FreeQ[test4, 1/(w - z)]]);\nPrint[\"Test 4 (OPE dphi-expPhib has pole): \", If[test4Result, \"PASSED\", \"FAILED\"]];\ntest4Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## OPEProjection API",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "lhs5 = OPEProjected[0, 0][R[d\\[Phi][0, z]] + R[\\[Eta][0, z]], R[exp\\[Phi]b[a, w]]];\nrhs5 = OPEProjected[0, 0][R[d\\[Phi][0, z]], R[exp\\[Phi]b[a, w]]] + OPEProjected[0, 0][R[\\[Eta][0, z]], R[exp\\[Phi]b[a, w]]];\ntest5Result = Simplify[lhs5 - rhs5] === 0;\nPrint[\"Test 5 (projection linearity): \", If[test5Result, \"PASSED\", \"FAILED\"]];\ntest5Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "lhs6 = OPEProjected[0, 0][2 R[d\\[Phi][0, z]], R[exp\\[Phi]b[a, w]]];\nrhs6 = 2 OPEProjected[0, 0][R[d\\[Phi][0, z]], R[exp\\[Phi]b[a, w]]];\ntest6Result = Simplify[lhs6 - rhs6] === 0;\nPrint[\"Test 6 (projection scalar extraction): \", If[test6Result, \"PASSED\", \"FAILED\"]];\ntest6Result",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTests = {test1Result, test2Result, test3Result, test4Result, test5Result, test6Result};\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ]
}
