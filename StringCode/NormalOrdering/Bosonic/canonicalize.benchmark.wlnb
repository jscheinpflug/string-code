  {
   "kind": 1,
   "value": "## Timing Comparison",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "$RecursionLimit = 10000\nsizes = {4,6,8,10,12,14,16};\nbench = Table[\n  input = makeBosonicInput[n];\n  {oldTime, oldRes} = AbsoluteTiming[R @@ input];\n  {newTime, newRes} = AbsoluteTiming[newFast @@ input];\n  oldOK = oldRes =!= $Failed;\n  newOK = newRes =!= $Failed;\n  speedup = If[oldOK && newOK && newTime > 0, oldTime/newTime, Missing[\"Unavailable\"]];\n  {n, oldTime, newTime, speedup, oldOK, newOK},\n  {n, sizes}\n];\n\nformatNumber[x_Real] := ToString[\n  NumberForm[N[x, 16], {Infinity, 8}, ExponentFunction -> (Null &)],\n  OutputForm\n];\nformatNumber[x_] := x;\n\nbenchDisplay = bench /. x_Real :> formatNumber[x];\n\nPrint[Grid[\n  Prepend[benchDisplay, {\"n\", \"R (s)\", \"CanonicalizeToR (s)\", \"speedup\", \"R OK\", \"New OK\"}],\n  Frame -> All\n]];\nbench",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><w>10000</w></div>",
       "mime": "x-application/wolfram-language-html"
      },
