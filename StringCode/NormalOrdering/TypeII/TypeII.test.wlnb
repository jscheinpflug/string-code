{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII NormalOrdering Unit Tests\n\nTypeII-specific tests for R with matter/superghost fermions and expPhi rules.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Xi\", \"bracket\" -> \"Flat\"|>];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Fermionic Sign Tests",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test1 = Simplify[R[\\[Psi][mu, 0, z], \\[Psi][nu, 0, w]] + R[\\[Psi][nu, 0, w], \\[Psi][mu, 0, z]]] === 0;\nPrint[\"Test 1 (psi anticommutation): \", If[test1, \"PASSED\", \"FAILED\"]];\ntest1",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test2 = Simplify[R[\\[Eta][0, z], \\[Xi][0, w]] + R[\\[Xi][0, w], \\[Eta][0, z]]] === 0;\nPrint[\"Test 2 (eta-xi anticommutation): \", If[test2, \"PASSED\", \"FAILED\"]];\ntest2",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test3 = Simplify[R[d\\[Phi][0, z], \\[Eta][0, w]] - R[\\[Eta][0, w], d\\[Phi][0, z]]] === 0;\nPrint[\"Test 3 (dphi with eta no sign): \", If[test3, \"PASSED\", \"FAILED\"]];\ntest3",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## TypeII expPhi Rules",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test4 = (R[exp\\[Phi]f[-1/2, z], exp\\[Phi]f[-1/2, z]] === R[exp\\[Phi]b[-1, z]]);\nPrint[\"Test 4 (expPhif bosonization rule): \", If[test4, \"PASSED\", \"FAILED\"]];\ntest4",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test5 = (R[exp\\[Phi]b[-1, z], exp\\[Phi]b[1/2, z]] === R[exp\\[Phi]b[-1/2, z]]);\nPrint[\"Test 5 (expPhib exponent addition): \", If[test5, \"PASSED\", \"FAILED\"]];\ntest5",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test6 = (R[\\[Eta][0, z], \\[Eta][0, z]] === 0);\nPrint[\"Test 6 (eta self-product vanishes): \", If[test6, \"PASSED\", \"FAILED\"]];\ntest6",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test7 = (R[\\[Psi][mu, 0, z], \\[Psi][mu, 0, z]] === 0);\nPrint[\"Test 7 (psi self-product vanishes): \", If[test7, \"PASSED\", \"FAILED\"]];\ntest7",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test8 = (R[exp\\[Phi]b[-1, z], exp\\[Phi]f[1/2, z]] === R[exp\\[Phi]f[-1/2, z]]);\nPrint[\"Test 8 (expPhib-expPhif fusion): \", If[test8, \"PASSED\", \"FAILED\"]];\ntest8",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test9 = (R[exp\\[Phi]tf[-1/2, zbar], exp\\[Phi]tf[-1/2, zbar]] === R[exp\\[Phi]tb[-1, zbar]]);\nPrint[\"Test 9 (anti-holo expPhitf bosonization): \", If[test9, \"PASSED\", \"FAILED\"]];\ntest9",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test10 = Simplify[R[S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z], S[{b,\"chiral\"},1/2,{{-1/2,nu}},0,w]] + R[S[{b,\"chiral\"},1/2,{{-1/2,nu}},0,w], S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z]]] === 0;\nPrint[\"Test 10 (spin field anticommutation): \", If[test10, \"PASSED\", \"FAILED\"]];\ntest10",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test11 = (R[S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z], S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z]] === 0);\nPrint[\"Test 11 (spin self-product vanishes): \", If[test11, \"PASSED\", \"FAILED\"]];\ntest11",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test12 = Simplify[R[S[{a,\"chiral\"},-1/2,{},0,z], St[{b,\"chiral\"},1/2,{},0,zb]] + R[St[{b,\"chiral\"},1/2,{},0,zb], S[{a,\"chiral\"},-1/2,{},0,z]]] === 0;\nPrint[\"Test 12 (S-St anticommutation): \", If[test12, \"PASSED\", \"FAILED\"]];\ntest12",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test13 = Simplify[R[S[{a,\"chiral\"},-1/2,{},0,z], dX[mu,0,w]] - R[dX[mu,0,w], S[{a,\"chiral\"},-1/2,{},0,z]]] === 0;\nPrint[\"Test 13 (spin with boson commutes in R): \", If[test13, \"PASSED\", \"FAILED\"]];\ntest13",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test14 = Simplify[R[S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z], \\[Eta][0, z]] + R[\\[Eta][0, z], S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z]]] === 0;\nPrint[\"Test 14 (spin field anticommutation): \", If[test14, \"PASSED\", \"FAILED\"]];\ntest14",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Beta-Gamma Sector",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test15 = Simplify[R[\\[Beta][0, z], \\[Gamma][0, w]] - R[\\[Gamma][0, w], \\[Beta][0, z]]] === 0;\nPrint[\"Test 15 (beta-gamma commute in R): \", If[test15, \"PASSED\", \"FAILED\"]];\ntest15",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test16 = Simplify[R[\\[Beta]t[0, zbar], \\[Gamma]t[0, wbar]] - R[\\[Gamma]t[0, wbar], \\[Beta]t[0, zbar]]] === 0;\nPrint[\"Test 16 (betat-gammat commute in R): \", If[test16, \"PASSED\", \"FAILED\"]];\ntest16",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test17 = Simplify[R[\\[Beta][0, z], \\[Eta][0, w]] - R[\\[Eta][0, w], \\[Beta][0, z]]] === 0;\nPrint[\"Test 17 (beta with eta has no fermionic sign): \", If[test17, \"PASSED\", \"FAILED\"]];\ntest17",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test18 = (R[\\[Beta][0, z], \\[Beta][0, z]] =!= 0) && (R[\\[Gamma][0, z], \\[Gamma][0, z]] =!= 0);\nPrint[\"Test 18 (beta/gamma are bosonic non-nilpotent in R): \", If[test18, \"PASSED\", \"FAILED\"]];\ntest18",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## GSO Parity",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test19 = GSOParity[R[\\[Psi][mu, 0, z], \\[Psi][nu, 0, w]]] === 1;\nPrint[\"Test 19 (two psi fields give even GSO parity): \", If[test19, \"PASSED\", \"FAILED\"]];\ntest19",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test20 = GSOParity[R[\\[Psi][mu, 0, z]]] === -1;\nPrint[\"Test 20 (single psi field gives odd GSO parity): \", If[test20, \"PASSED\", \"FAILED\"]];\ntest20",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test21 = GSOParity[R[\\[Beta][0, z], \\[Gamma][0, w]]] === 1;\nPrint[\"Test 21 (beta*gamma gives even GSO parity): \", If[test21, \"PASSED\", \"FAILED\"]];\ntest21",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test22 = GSOParity[R[S[{a,\"chiral\"},-1/2,{},0,z], \\[Psi][mu,0,w]]] === -1;\nPrint[\"Test 22 (S_{-1/2}*psi gives odd GSO parity): \", If[test22, \"PASSED\", \"FAILED\"]];\ntest22",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test23 = GSOParity[3 R[\\[Psi][mu,0,z]]] === GSOParity[R[\\[Psi][mu,0,z]]] && GSOParity[3 R[\\[Psi][mu,0,z]]] === -1;\nPrint[\"Test 23 (constant prefactor ignored in GSO parity): \", If[test23, \"PASSED\", \"FAILED\"]];\ntest23",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test24 = GSOParity[R[S[{a,\"chiral\"},-1/2,{{1/2,mu}},0,z], \\[Psi][nu,0,w]]] === 1;\nPrint[\"Test 24 (spin mode-length parity flip propagates in R): \", If[test24, \"PASSED\", \"FAILED\"]];\ntest24",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Bosonized Normal Ordering",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test25 = Bosonize[R[exp\\[Phi]f[-1/2, z], S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, 0, {}, 0, z]]] === E^((5 I Pi)/8) R[expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, z]];\nPrint[\"Test 25 (Bosonize[R[e^{-phi/2}, S]] exact same-point merge): \", If[test25, \"PASSED\", \"FAILED\"]];\ntest25",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test26 = Bosonize[R[\\[Psi][1, 0, z], S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z]]] === -((E^((3 I Pi)/4) R[expH[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, z]])/Sqrt[2]) - R[expH[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, z]]/(Sqrt[2] E^((3 I Pi)/4));\nPrint[\"Test 26 (Bosonize[R[psi, S]] exact same-point OPE basis): \", If[test26, \"PASSED\", \"FAILED\"]];\ntest26",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test27 = Bosonize[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z], S[{{1/2, 1/2, 1/2, -1/2, -1/2}, \"chiral\"}, -1/2, {}, 0, z]]] === I R[expH[{-1, 1, 1, 1, 0, 0}, z]];\nPrint[\"Test 27 (Bosonize[R[S, S]] exact same-point merge): \", If[test27, \"PASSED\", \"FAILED\"]];\ntest27",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test28 = Bosonize[R[\\[Psi]t[1, 0, zb], St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, zb]]] === -((E^((3 I Pi)/4) R[expHt[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, zb]])/Sqrt[2]) - R[expHt[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, zb]]/(Sqrt[2] E^((3 I Pi)/4));\nPrint[\"Test 28 (Bosonize[R[psit, St]] exact same-point OPE basis): \", If[test28, \"PASSED\", \"FAILED\"]];\ntest28",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Mixed-Sector Consistency",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "mixedFactorwiseBosonize[expr_] := expr /; isScalarFactorQ[expr];\nmixedFactorwiseBosonize[c_ ra_] := c mixedFactorwiseBosonize[ra] /; isScalarFactorQ[c] && Head[ra] === R;\nmixedFactorwiseBosonize[ra_] := Expand[R @@ (Bosonize /@ (List @@ ra))] /; Head[ra] === R;\nmixedBosonizeConsistencyQ[expr_] := TrueQ[Simplify[Expand[Bosonize[expr] - mixedFactorwiseBosonize[expr]] == 0]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test29 = mixedBosonizeConsistencyQ[R[\\[Psi][1, 0, z], \\[Psi]t[1, 0, zb]]];\nPrint[\"Test 29 (Bosonize[R[psi, psit]] matches factorwise bosonization): \", If[test29, \"PASSED\", \"FAILED\"]];\ntest29",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test30 = mixedBosonizeConsistencyQ[R[exp\\[Phi]f[-1/2, z], exp\\[Phi]tf[-1/2, zb]]];\nPrint[\"Test 30 (Bosonize[R[e^{-phi/2}, e^{-phit/2}]] matches factorwise bosonization): \", If[test30, \"PASSED\", \"FAILED\"]];\ntest30",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test31 = mixedBosonizeConsistencyQ[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z], St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, zb]]];\nPrint[\"Test 31 (Bosonize[R[S, St]] matches factorwise bosonization): \", If[test31, \"PASSED\", \"FAILED\"]];\ntest31",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test32 = mixedBosonizeConsistencyQ[R[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z], \\[Psi]t[1, 0, zb]]];\nPrint[\"Test 32 (Bosonize[R[S, psit]] matches factorwise bosonization): \", If[test32, \"PASSED\", \"FAILED\"]];\ntest32",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test33 = mixedBosonizeConsistencyQ[R[exp\\[Phi]f[-1/2, z], St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, zb]]];\nPrint[\"Test 33 (Bosonize[R[e^{-phi/2}, St]] matches factorwise bosonization): \", If[test33, \"PASSED\", \"FAILED\"]];\ntest33",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Direct H-Exponential Canonicalization",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test34 = R[expH[{0, 1, 0, 0, 0, 0}, z], expH[{0, 0, 1, 0, 0, 0}, z]] === R[expH[{0, 1, 1, 0, 0, 0}, z]];\nPrint[\"Test 34 (direct expH same-point merge adds charge vectors): \", If[test34, \"PASSED\", \"FAILED\"]];\ntest34",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test35 = R[expHt[{0, 1, 0, 0, 0, 0}, zb], expHt[{0, 0, 1, 0, 0, 0}, zb]] === R[expHt[{0, 1, 1, 0, 0, 0}, zb]];\nPrint[\"Test 35 (direct expHt same-point merge adds charge vectors): \", If[test35, \"PASSED\", \"FAILED\"]];\ntest35",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test36 = R[expH[{0, 1, 0, 0, 0, 0}, z], expH[{0, -1, 0, 0, 0, 0}, z]] === 1 && R[expHt[{0, 1, 0, 0, 0, 0}, zb], expHt[{0, -1, 0, 0, 0, 0}, zb]] === 1;\nPrint[\"Test 36 (opposite H-charges collapse through the zero vector): \", If[test36, \"PASSED\", \"FAILED\"]];\ntest36",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "holDifferentCoord = R[expH[{0, 1, 0, 0, 0, 0}, z], expH[{0, -1, 0, 0, 0, 0}, w]];\nmixedHFields = R[expH[{0, 1, 0, 0, 0, 0}, z], expHt[{0, -1, 0, 0, 0, 0}, zb]];\ntest37 = MatchQ[holDifferentCoord, _R] && Length[List @@ holDifferentCoord] === 2 && MatchQ[mixedHFields, _R] && Length[List @@ mixedHFields] === 2;\nPrint[\"Test 37 (different coordinates and mixed sectors do not merge): \", If[test37, \"PASSED\", \"FAILED\"]];\ntest37",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test38 = Bosonize[R[expH[{0, 1, 0, 0, 0, 0}, z]]] === R[expH[{0, 1, 0, 0, 0, 0}, z]] && Bosonize[R[expHt[{0, 1, 0, 0, 0, 0}, zb]]] === R[expHt[{0, 1, 0, 0, 0, 0}, zb]];\nPrint[\"Test 38 (single H-exponentials remain unchanged under Bosonize): \", If[test38, \"PASSED\", \"FAILED\"]];\ntest38",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## Summary",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTests = And[test1, test2, test3, test4, test5, test6, test7, test8, test9, test10, test11, test12, test13, test14, test15, test16, test17, test18, test19, test20, test21, test22, test23, test24, test25, test26, test27, test28, test29, test30, test31, test32, test33, test34, test35, test36, test37, test38];\nPrint[\"Overall result: \", If[allTests, \"ALL PASSED\", \"SOME FAILED\"]];\nallTests",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  }
 ],
 "metadata": {
  "version": "1.0.0"
 }
}
