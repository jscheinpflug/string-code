{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII Benchmark: `R` vs `CanonicalizeToR`\n\nCompares recursive old-style `R` evaluation with `CanonicalizeToR` including bosonized-exponential cases.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Xi\", \"bracket\" -> \"Flat\"|>];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1771044739705,
     "endTime": 1771044739976
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "expPhiF = ToExpression[\"StringCode`Symbols`TypeII`exp\\\\[Phi]f\"];\nexpPhiTF = ToExpression[\"StringCode`Symbols`TypeII`exp\\\\[Phi]tf\"];\n\nnewFast[args___] := Private`CanonicalizeToR[Private`U @@ {args}];\n\ndXH = ToExpression[\"StringCode`Symbols`TypeII`FlatSpace`dX\"];\ndXtA = ToExpression[\"StringCode`Symbols`TypeII`FlatSpace`dXt\"];\npsiH = ToExpression[\"StringCode`Symbols`TypeII`FlatSpace`\\[Psi]\"];\npsiA = ToExpression[\"StringCode`Symbols`TypeII`FlatSpace`\\[Psi]t\"];\n\nmakeTypeIIInput[n_Integer?Positive] := Module[{z, zb, holoFields, antiFields},\n  z = Array[Symbol[\"z\" <> ToString[#]] &, n];\n  zb = Array[Symbol[\"zb\" <> ToString[#]] &, n];\n\n  holoFields = Join[\n    Table[b[0, z[[i]]], {i, n}],\n    Table[c[0, z[[i]]], {i, n}],\n    Table[dXH[mu, 0, z[[i]]], {i, n}],\n    Table[psiH[mu, 0, z[[i]]], {i, n}],\n    Table[expPhiF[-1/2, z[[i]]], {i, n}]\n  ];\n\n  antiFields = Join[\n    Table[bt[0, zb[[i]]], {i, n}],\n    Table[ct[0, zb[[i]]], {i, n}],\n    Table[dXtA[mu, 0, zb[[i]]], {i, n}],\n    Table[psiA[mu, 0, zb[[i]]], {i, n}],\n    Table[expPhiTF[-1/2, zb[[i]]], {i, n}]\n  ];\n\n  RandomSample@Join[holoFields, antiFields]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1771044739976,
     "endTime": 1771044740460
    },
    "executionOrder": 3,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "## Correctness Checks",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "correctnessCases = {\n  {expPhiF[-1/2, z], expPhiF[-1/2, z]},\n  {expPhiTF[-1/2, zb], expPhiTF[-1/2, zb]},\n  {expPhiF[-1/2, z], expPhiF[-1/2, z], b[0, w], c[1, u]},\n  {expPhiTF[-1/2, zb], expPhiTF[-1/2, zb], bt[0, wb], ct[1, ub]},\n  makeTypeIIInput[4],\n  makeTypeIIInput[6]\n};\n\nsameQResults = Map[Check[(R @@ #) === (newFast @@ #), False] &, correctnessCases];\nsimplifyResults = Map[Check[Simplify[R @@ # - newFast @@ #] === 0, False] &, correctnessCases];\n\nPrint[\"TypeII SameQ per case: \", sameQResults];\nPrint[\"TypeII Simplify-equality per case: \", simplifyResults];\nPrint[\"newFast over correctnessCases:\"];\nallCorrect = And @@ simplifyResults;\nPrint[\"TypeII all-cases correctness: \", If[allCorrect, \"PASSED\", \"FAILED\"]];\nallCorrect",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>TypeII SameQ per case: {True, True, True, True, True, True}\n</pre>",
