  {
   "kind": 1,
   "value": "## Timing Comparison",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "$RecursionLimit = 10000;\nsizes = {4, 6, 8, 10, 12, 14, 16};\nbench = Table[\n  input = makeTypeIIInput[n];\n  {oldTime, oldRes} = AbsoluteTiming[R @@ input];\n  {newTime, newRes} = AbsoluteTiming[newFast @@ input];\n  oldOK = oldRes =!= $Failed;\n  newOK = newRes =!= $Failed;\n  speedup = If[oldOK && newOK && newTime > 0, oldTime/newTime, Missing[\"Unavailable\"]];\n  {n, oldTime, newTime, speedup, oldOK, newOK},\n  {n, sizes}\n];\n\nformatNumber[x_Real] := ToString[\n  NumberForm[N[x, 20], {Infinity, 8}, ExponentFunction -> (Null &)],\n  OutputForm\n];\nformatNumber[x_] := x;\n\nbenchDisplay = bench /. x_Real :> formatNumber[x];\n\nPrint[Grid[\n  Prepend[benchDisplay, {\"n\", \"R (s)\", \"CanonicalizeToR (s)\", \"speedup\", \"R OK\", \"New OK\"}],\n  Frame -> All\n]];\nbench",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>n    R (s)        CanonicalizeToR (s)   speedup        R OK   New OK\n\n4    0.23497500   0.01611200            14.58385055    True   True\n\n6    0.57651700   0.01978500            29.13909527    True   True\n\n8    0.87429000   0.02905300            30.09293360    True   True\n\n10   2.28462100   0.02840300            80.43590466    True   True\n\n12   4.21859100   0.04065700            103.76050865   True   True\n\n14   6.00635900   0.05283400            113.68359390   True   True\n\n16   7.27804600   0.06351000            114.59685089   True   True\n</pre>",
       "mime": "x-application/wolfram-language-html"
