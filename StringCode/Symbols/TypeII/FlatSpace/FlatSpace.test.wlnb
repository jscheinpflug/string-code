   "kind": 2,
   "value": "dXWeightHoloMeta = Private`fieldProperty[dX, \"WeightHolo\"];\ndXtWeightAntiMeta = Private`fieldProperty[dXt, \"WeightAntiHolo\"];\npsiWeightHoloMeta = Private`fieldProperty[\\[Psi], \"WeightHolo\"];\npsitWeightAntiMeta = Private`fieldProperty[\\[Psi]t, \"WeightAntiHolo\"];\ntest19 = MatchQ[dXWeightHoloMeta, _Function] && MatchQ[dXtWeightAntiMeta, _Function] && MatchQ[psiWeightHoloMeta, _Function] && MatchQ[psitWeightAntiMeta, _Function] && dXWeightHoloMeta[dX[\\[Mu],3,z]] === 4 && dXtWeightAntiMeta[dXt[\\[Nu],1,zb]] === 2 && psiWeightHoloMeta[\\[Psi][\\[Mu],2,z]] === 5/2 && psitWeightAntiMeta[\\[Psi]t[\\[Nu],1,zb]] === 3/2 && Private`fieldProperty[dX, \"WeightAntiHolo\"] === 0 && Private`fieldProperty[dXt, \"WeightHolo\"] === 0 && Private`fieldProperty[\\[Psi], \"WeightAntiHolo\"] === 0 && Private`fieldProperty[\\[Psi]t, \"WeightHolo\"] === 0;\nPrint[\"Test 19 (DefineField weight metadata is explicit): \", If[test19, \"PASSED\", \"FAILED\"]];\ntest19",
