  {
   "kind": 2,
   "value": "sMinus = {{-1/2, -1/2, -1/2, -1/2, -1/2}, \"antichiral\"};\nspinModeBosonizationStepHolo[currentState_, spinMode_] := Module[{u = Unique[\"u\"], eps = Unique[\"eps\"]},\n  Expand @ Simplify[\n    Private`projectScaledExpressionAtHoloPower[\n      OPE[Bosonize[R[\\[Psi][spinMode[[1]], 0, eps u]]], currentState],\n      spinMode[[2]] - 1/2,\n      eps\n    ] /. u -> 1\n  ]\n];\nspinModeBosonizationStepAnti[currentState_, spinMode_] := Module[{ub = Unique[\"ub\"], eps = Unique[\"eps\"]},\n  Expand @ Simplify[\n    Private`projectScaledExpressionAtAntiHoloPower[\n      OPE[Bosonize[R[\\[Psi]t[spinMode[[1]], 0, eps ub]]], currentState],\n      spinMode[[2]] - 1/2,\n      eps\n    ] /. ub -> 1\n  ]\n];\nrestoreBosonizedSpinStateHolo[expr_, coord_] := Expand[(expr /. R[a___] :> Times[a]) /. {dH[i_, n_, 0] :> dH[i, n, coord], expH[charges_, 0] :> expH[charges, coord]}];\nrestoreBosonizedSpinStateAnti[expr_, coord_] := Expand[(expr /. R[a___] :> Times[a]) /. {dHt[i_, n_, 0] :> dHt[i, n, coord], expHt[charges_, 0] :> expHt[charges, coord]}];\nspinDescendantOracleHoloGrouped[spinSpec_, modes_List, coord_] := Module[{state, remainingModes = modes},\n  state = Bosonize[R[S[spinSpec, -1/2, {}, 0, 0]]];\n  If[OddQ[Length[remainingModes]],\n    state = spinModeBosonizationStepHolo[state, First[remainingModes]];\n    remainingModes = Rest[remainingModes];\n  ];\n  state = Fold[Function[{currentState, pair}, Fold[spinModeBosonizationStepHolo, currentState, pair]], state, Partition[remainingModes, 2]];\n  restoreBosonizedSpinStateHolo[state, coord]\n];\nspinDescendantOracleAntiGrouped[spinSpec_, modes_List, coord_] := Module[{state, remainingModes = modes},\n  state = Bosonize[R[St[spinSpec, -1/2, {}, 0, 0]]];\n  If[OddQ[Length[remainingModes]],\n    state = spinModeBosonizationStepAnti[state, First[remainingModes]];\n    remainingModes = Rest[remainingModes];\n  ];\n  state = Fold[Function[{currentState, pair}, Fold[spinModeBosonizationStepAnti, currentState, pair]], state, Partition[remainingModes, 2]];\n  restoreBosonizedSpinStateAnti[state, coord]\n];\ntest30 = Simplify[Bosonize[S[sPlus, -1/2, {{1, 1}, {2, 1}}, 0, z]] - spinDescendantOracleHoloGrouped[sPlus, {{1, 1}, {2, 1}}, z]] === 0 && Simplify[Bosonize[St[sPlus, -1/2, {{1, 1}, {2, 1}}, 0, zb]] - spinDescendantOracleAntiGrouped[sPlus, {{1, 1}, {2, 1}}, zb]] === 0 && Simplify[Bosonize[S[sPlus, -1/2, {{1, 0}, {2, 0}, {1, 1}, {2, 1}}, 0, z]] - spinDescendantOracleHoloGrouped[sPlus, {{1, 0}, {2, 0}, {1, 1}, {2, 1}}, z]] === 0 && Simplify[Bosonize[St[sPlus, -1/2, {{1, 0}, {2, 0}, {1, 1}, {2, 1}}, 0, zb]] - spinDescendantOracleAntiGrouped[sPlus, {{1, 0}, {2, 0}, {1, 1}, {2, 1}}, zb]] === 0;\nPrint[\"Test 30 (even GSO ground matches grouped pair application): \", If[test30, \"PASSED\", \"FAILED\"]];\ntest30",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
