  {
   "kind": 1,
   "value": "## Bosonization",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "dHWeightHoloMeta = Private`fieldProperty[dH, \"WeightHolo\"];\ndHtWeightAntiMeta = Private`fieldProperty[dHt, \"WeightAntiHolo\"];\nexpHWeightHoloMeta = Private`fieldProperty[expH, \"WeightHolo\"];\nexpHtWeightAntiMeta = Private`fieldProperty[expHt, \"WeightAntiHolo\"];\ntest21 = isField[dH] && isField[dHt] && isField[expH] && isField[expHt] && isBoson[dH] && isBoson[dHt] && isBoson[expH] && isBoson[expHt] && isSimple[dH] && isSimple[dHt] && isComposite[expH] && isComposite[expHt] && isCollapsable[dH] && isCollapsable[dHt] && isCollapsable[expH] && isCollapsable[expHt] && MatchQ[dHWeightHoloMeta, _Function] && MatchQ[dHtWeightAntiMeta, _Function] && MatchQ[expHWeightHoloMeta, _Function] && MatchQ[expHtWeightAntiMeta, _Function] && dHWeightHoloMeta[dH[3, 2, z]] === 3 && dHtWeightAntiMeta[dHt[4, 1, zb]] === 2 && expHWeightHoloMeta[expH[{1, 1, 0, 0, 0, 0}, z]] === -1 && expHtWeightAntiMeta[expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, zb]] === 1 && expH[{0, 0, 0, 0, 0, 0}, z] === 1 && expHt[{0, 0, 0, 0, 0, 0}, zb] === 1 && Private`fieldProperty[dH, \"WeightAntiHolo\"] === 0 && Private`fieldProperty[dHt, \"WeightHolo\"] === 0 && Private`fieldProperty[expH, \"WeightAntiHolo\"] === 0 && Private`fieldProperty[expHt, \"WeightHolo\"] === 0;\nPrint[\"Test 21 (bosonized head registration and weights): \", If[test21, \"PASSED\", \"FAILED\"]];\ntest21",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test22 = Length[Private`chiralspins] === 16 && Length[Private`antichiralspins] === 16 && Length[Private`vectors] === 10 && AllTrue[Private`chiralspins, Private`spinVectorChiralityQ[#, \"chiral\"] &] && AllTrue[Private`antichiralspins, Private`spinVectorChiralityQ[#, \"antichiral\"] &] && Dimensions[Private`basisChangeM] === {10, 10} && Max[Abs[Chop[N[Private`basisChangeM . ConjugateTranspose[Private`basisChangeM] - IdentityMatrix[10]]]]] == 0;\nPrint[\"Test 22 (spin basis data is complete and unitary): \", If[test22, \"PASSED\", \"FAILED\"]];\ntest22",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test23 = Bosonize[exp\\[Phi]f[-1/2, z]] === expH[{-1/2, 0, 0, 0, 0, 0}, z] && Bosonize[exp\\[Phi]tf[-1/2, zb]] === expHt[{-1/2, 0, 0, 0, 0, 0}, zb] && Bosonize[S[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, z]] === expH[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, z] && Bosonize[St[{{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"}, -1/2, {}, 0, zb]] === expHt[{-1/2, 1/2, 1/2, 1/2, 1/2, 1/2}, zb];\nPrint[\"Test 23 (single-field bosonization for picture and spin fields): \", If[test23, \"PASSED\", \"FAILED\"]];\ntest23",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "psiBosonized0 = (expH[{0, -1, 0, 0, 0, 0}, z] + expH[{0, 1, 0, 0, 0, 0}, z])/Sqrt[2];\npsitBosonized0 = (expHt[{0, -1, 0, 0, 0, 0}, zb] + expHt[{0, 1, 0, 0, 0, 0}, zb])/Sqrt[2];\npsiBosonized1 = -((dH[2, 0, z] expH[{0, -1, 0, 0, 0, 0}, z])/Sqrt[2]) + (dH[2, 0, z] expH[{0, 1, 0, 0, 0, 0}, z])/Sqrt[2];\ntest24 = Simplify[Bosonize[\\[Psi][1, 0, z]] - psiBosonized0] === 0 && Simplify[Bosonize[\\[Psi]t[1, 0, zb]] - psitBosonized0] === 0 && Simplify[Bosonize[\\[Psi][1, 1, z]] - psiBosonized1] === 0;\nPrint[\"Test 24 (psi/psit bosonization matches the six-boson basis): \", If[test24, \"PASSED\", \"FAILED\"]];\ntest24",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "sPlus = {{1/2, 1/2, 1/2, 1/2, 1/2}, \"chiral\"};\nspinDescendantOracleHolo[modes_List] := Module[{state},\n  state = Bosonize[R[S[sPlus, -1/2, {}, 0, 0]]];\n  state = Fold[\n    Function[{currentState, spinMode},\n      Module[{u = Unique[\"u\"], eps = Unique[\"eps\"]},\n        Expand @ Simplify[\n          Private`projectScaledExpressionAtHoloPower[\n            OPE[Bosonize[R[\\[Psi][spinMode[[1]], 0, eps u]]], currentState],\n            spinMode[[2]] - 1/2,\n            eps\n          ] /. u -> 1\n        ]\n      ]\n    ],\n    state,\n    modes\n  ];\n  Expand[(state /. R[a___] :> Times[a]) /. {dH[i_, n_, 0] :> dH[i, n, z], expH[charges_, 0] :> expH[charges, z]}]\n];\nspinDescendantOracleAnti[modes_List] := Module[{state},\n  state = Bosonize[R[St[sPlus, -1/2, {}, 0, 0]]];\n  state = Fold[\n    Function[{currentState, spinMode},\n      Module[{ub = Unique[\"ub\"], eps = Unique[\"eps\"]},\n        Expand @ Simplify[\n          Private`projectScaledExpressionAtAntiHoloPower[\n            OPE[Bosonize[R[\\[Psi]t[spinMode[[1]], 0, eps ub]]], currentState],\n            spinMode[[2]] - 1/2,\n            eps\n          ] /. ub -> 1\n        ]\n      ]\n    ],\n    state,\n    modes\n  ];\n  Expand[(state /. R[a___] :> Times[a]) /. {dHt[i_, n_, 0] :> dHt[i, n, zb], expHt[charges_, 0] :> expHt[charges, zb]}]\n];\ntest25 = Simplify[Bosonize[S[sPlus, -1/2, {{1, 1}}, 0, z]] - spinDescendantOracleHolo[{{1, 1}}]] === 0 && Simplify[Bosonize[St[sPlus, -1/2, {{1, 1}}, 0, zb]] - spinDescendantOracleAnti[{{1, 1}}]] === 0;\nPrint[\"Test 25 (one-mode spin-field bosonization matches contour extraction): \", If[test25, \"PASSED\", \"FAILED\"]];\ntest25",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test26 = Simplify[Bosonize[S[sPlus, -1/2, {{1, 1}, {2, 1}}, 0, z]] - spinDescendantOracleHolo[{{1, 1}, {2, 1}}]] === 0 && Simplify[Bosonize[St[sPlus, -1/2, {{1, 1}, {2, 1}}, 0, zb]] - spinDescendantOracleAnti[{{1, 1}, {2, 1}}]] === 0 && Head[Bosonize[S[sPlus, -1/2, {{mu, 1}}, 0, z]]] === Bosonize;\nPrint[\"Test 26 (multi-mode spin-field bosonization and guard behavior): \", If[test26, \"PASSED\", \"FAILED\"]];\ntest26",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expectedSpinMode0 = (-1/2 - I/2) R[expH[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, z]];\nexpectedSpinMode1 = (-1/2 + I/2) R[expH[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, z]] + (1/2 + I/2) R[dH[2, 0, z], expH[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, z]];\nexpectedSpinMode0Anti = (-1/2 - I/2) R[expHt[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, zb]];\nexpectedSpinMode1Anti = (-1/2 + I/2) R[expHt[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, zb]] + (1/2 + I/2) R[dHt[2, 0, zb], expHt[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, zb]];\ntest27 = Bosonize[S[sPlus, -1/2, {{1, 0}}, 0, z]] === expectedSpinMode0 && Bosonize[S[sPlus, -1/2, {{1, 1}}, 0, z]] === expectedSpinMode1 && Bosonize[St[sPlus, -1/2, {{1, 0}}, 0, zb]] === expectedSpinMode0Anti && Bosonize[St[sPlus, -1/2, {{1, 1}}, 0, zb]] === expectedSpinMode1Anti;\nPrint[\"Test 27 (exact zero-mode and first excited spin descendants): \", If[test27, \"PASSED\", \"FAILED\"]];\ntest27",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expectedSpinMode2 = (-1/2 + I/2) R[dH[2, 0, z], expH[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, z]] + (1/4 + I/4) R[dH[2, 1, z], expH[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, z]] - (1/4 + I/4) R[dH[2, 0, z], dH[2, 0, z], expH[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, z]];\nexpectedSpinMode2Anti = (-1/2 + I/2) R[dHt[2, 0, zb], expHt[{-1/2, 3/2, 1/2, 1/2, 1/2, 1/2}, zb]] + (1/4 + I/4) R[dHt[2, 1, zb], expHt[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, zb]] - (1/4 + I/4) R[dHt[2, 0, zb], dHt[2, 0, zb], expHt[{-1/2, -1/2, 1/2, 1/2, 1/2, 1/2}, zb]];\ntest28 = Bosonize[S[sPlus, -1/2, {{1, 2}}, 0, z]] === expectedSpinMode2 && Bosonize[St[sPlus, -1/2, {{1, 2}}, 0, zb]] === expectedSpinMode2Anti;\nPrint[\"Test 28 (exact second excited spin descendants): \", If[test28, \"PASSED\", \"FAILED\"]];\ntest28",
   "languageId": "wolfram",
   "outputs": [],
