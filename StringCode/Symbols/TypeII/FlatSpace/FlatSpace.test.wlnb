   "value": "test31 = Simplify[Bosonize[S[sMinus, -1/2, {{1, 1}, {2, 1}, {3, 1}}, 0, z]] - spinDescendantOracleHoloGrouped[sMinus, {{1, 1}, {2, 1}, {3, 1}}, z]] === 0 && Simplify[Bosonize[St[sMinus, -1/2, {{1, 1}, {2, 1}, {3, 1}}, 0, zb]] - spinDescendantOracleAntiGrouped[sMinus, {{1, 1}, {2, 1}, {3, 1}}, zb]] === 0 && {GSOParity[S[sPlus, -1/2, {}, 0, z]], GSOParity[S[sPlus, -1/2, {{1, 1}}, 0, z]], GSOParity[S[sPlus, -1/2, {{1, 1}, {2, 1}}, 0, z]]} === {1, -1, 1} && {GSOParity[S[sMinus, -1/2, {}, 0, z]], GSOParity[S[sMinus, -1/2, {{1, 1}}, 0, z]], GSOParity[S[sMinus, -1/2, {{1, 1}, {2, 1}, {3, 1}}, 0, z]]} === {-1, 1, 1};\nPrint[\"Test 31 (odd GSO ground and parity flips stay consistent): \", If[test31, \"PASSED\", \"FAILED\"]];\ntest31",
