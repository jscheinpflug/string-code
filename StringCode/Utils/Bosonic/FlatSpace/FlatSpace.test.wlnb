{
 "cells": [
  {
   "kind": 1,
   "value": "# Bosonic FlatSpace Utils Unit Tests\n\nCoverage:\n- ContractDelta availability in Utils\n- Index relabeling in operator coefficient extraction\n- Profile-derivative absorption into ProfileX derivative lists\n- Dummy-index canonicalization and collision avoidance",
   "languageId": "markdown"
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"Bosonic\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"Bosonic-Xi\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram"
  },
  {
   "kind": 2,
   "value": "testReport[name_, cond_] := Module[{}, Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]]; TrueQ[cond]];\nabsorbedExpr = AbsorbProfileDerivatives[\n  der[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2]][a] der[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2]][b]\n    R[ProfileX[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2], {}, 0, 0], dX[\\[Mu], 0, 0]]\n];\nexpectedAbsorbedExpr = R[dX[\\[Mu], 0, 0], ProfileX[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2], {a, b}, 0, 0]];\ncanonExpr1 = CanonicalizeDummyIndices[R[dX[\\[Mu]1, 0, 0], ProfileX[Kon[\\[Rho]], {dummyA, dummyB}, 0, 0]]];\ncanonExpr2 = CanonicalizeDummyIndices[R[dX[\\[Mu]1, 0, 0], ProfileX[Kon[\\[Rho]], {dummyX, dummyY}, 0, 0]]];\nexpectedCanonExpr = R[dX[\\[Mu]1, 0, 0], ProfileX[Kon[\\[Rho]], {\\[Mu]2, \\[Mu]3}, 0, 0]];\nprotectedExpr = R[dX[r, 0, 0], ProfileX[Kon[r], {r}, 0, 0]];\n\ntest1 = testReport[\"Test 1 (ContractDelta moved into Utils)\", ContractDelta[\\[Delta][\\[Mu], \\[Nu]] dX[\\[Mu], 0, 0]] === dX[\\[Nu], 0, 0]];\ntest2 = testReport[\"Test 2 (index relabeling coefficient)\", OperatorCoefficient[\\[Delta][\\[Mu], \\[Nu]] R[dX[\\[Mu], 0, 0], dX[\\[Nu], 0, 0]], R[dX[a, 0, 0], dX[b, 0, 0]]] === \\[Delta][a, b]];\ntest3 = testReport[\"Test 3 (profile absorption into coefficient)\", OperatorCoefficient[R[ProfileX[f, {}, 0, 0], dX[\\[Mu], 0, 0], dX[\\[Nu], 0, 0]], R[dX[a, 0, 0], dX[b, 0, 0]]] === ProfileX[f, {}, 0, 0]];\ntest4 = testReport[\"Test 4 (profile derivative absorption)\", absorbedExpr === expectedAbsorbedExpr];\ntest5 = testReport[\"Test 5 (dummy canonicalization collapse)\", canonExpr1 === canonExpr2 === expectedCanonExpr];\ntest6 = testReport[\"Test 6 (protected symbols stay fixed)\", CanonicalizeDummyIndices[protectedExpr] === protectedExpr];\n\nallTests = {test1, test2, test3, test4, test5, test6};\nallPassed = And @@ allTests;\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", Count[allTests, True], \"/\", Length[allTests]];\nIf[allPassed, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\nallPassed",
   "languageId": "wolfram"
  }
 ]
}
