{
 "cells": [
  {
   "kind": 1,
   "value": "# Bosonic FlatSpace Utils Unit Tests\n\nCoverage:\n- ContractDelta availability in Utils\n- Index relabeling in operator coefficient extraction\n- Profile absorption into extracted coefficients",
   "languageId": "markdown"
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"Bosonic\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"Bosonic-Xi\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram"
  },
  {
   "kind": 2,
   "value": "testReport[name_, cond_] := Module[{}, Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]]; TrueQ[cond]];\n\ntest1 = testReport[\"Test 1 (ContractDelta moved into Utils)\", ContractDelta[\\[Delta][\\[Mu], \\[Nu]] dX[\\[Mu], 0, 0]] === dX[\\[Nu], 0, 0]];\ntest2 = testReport[\"Test 2 (index relabeling coefficient)\", OperatorCoefficient[\\[Delta][\\[Mu], \\[Nu]] R[dX[\\[Mu], 0, 0], dX[\\[Nu], 0, 0]], R[dX[a, 0, 0], dX[b, 0, 0]]] === \\[Delta][a, b]];\ntest3 = testReport[\"Test 3 (profile absorption)\", OperatorCoefficient[R[ProfileX[f, {}, 0, 0], dX[\\[Mu], 0, 0], dX[\\[Nu], 0, 0]], R[dX[a, 0, 0], dX[b, 0, 0]]] === ProfileX[f, {}, 0, 0]];\ntest4 = testReport[\"Test 4 (profile-preserving template)\", OperatorCoefficient[R[ProfileX[f, {}, 0, 0], dX[\\[Mu], 0, 0], dX[\\[Nu], 0, 0]], R[ProfileX[f, {}, 0, 0], dX[a, 0, 0], dX[b, 0, 0]]] === 1];\n\nallTests = {test1, test2, test3, test4};\nallPassed = And @@ allTests;\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", Count[allTests, True], \"/\", Length[allTests]];\nIf[allPassed, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\nallPassed",
   "languageId": "wolfram"
  }
 ]
}
