{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace Utils Unit Tests\n\nCoverage:\n- Spin-field mode relabeling in operator coefficient extraction\n- Profile-argument relabeling alongside spinor/vector coefficient tensors\n- Common-coefficient extraction for sums of operators\n- Profile-derivative absorption and dummy-index canonicalization",
   "languageId": "markdown"
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]",
   "languageId": "wolfram"
  },
  {
   "kind": 2,
   "value": "testReport[name_, cond_] := Module[{}, Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]]; TrueQ[cond]];\nexpr1 = GammaAntisymmetricProductHold[{GammaDUHold[\\[Sigma]]}, \\[Alpha], \\[Beta]] R[S[{\\[Alpha], \"chiral\"}, -1/2, {{\\[Sigma], -1}}, 0, 0], St[{\\[Beta], \"antichiral\"}, -1/2, {}, 0, 0]];\nexpr2 = GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]]}, \\[Alpha], \\[Beta]] R[ProfileX[Kon[\\[Rho]], {}, 0, 0], dX[\\[Rho], 0, 0], S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, 0], St[{\\[Beta], \"antichiral\"}, -1/2, {}, 0, 0]];\nexpr3 = x (R[S[{a1, \"chiral\"}, -1/2, {}, 0, 0]] + R[St[{a2, \"antichiral\"}, -1/2, {}, 0, 0]]);\nabsorbedExpr = AbsorbProfileDerivatives[\n  der[Kon[\\[Rho], \\[Sigma]]][dummyA]\n    R[ProfileX[Kon[\\[Rho], \\[Sigma]], {}, 0, 0], dX[\\[Mu], 0, 0], S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, 0], St[{\\[Beta], \"antichiral\"}, -1/2, {}, 0, 0]]\n];\nexpectedAbsorbedExpr = R[dX[\\[Mu], 0, 0], ProfileX[Kon[\\[Rho], \\[Sigma]], {dummyA}, 0, 0], S[{\\[Alpha], \"chiral\"}, -1/2, {}, 0, 0], St[{\\[Beta], \"antichiral\"}, -1/2, {}, 0, 0]];\ncoefficientLikeExpr = (x GammaAntisymmetricProductHold[{GammaUDHold[dummyA]}, \\[Alpha]3, \\[Alpha]2] GammaAntisymmetricProductHold[{GammaUDHold[dummyB]}, \\[Alpha]t2, \\[Alpha]t1] ProfileX[Kon[\\[Rho], \\[Sigma]], {}, 0, 0] der[Kon[\\[Rho], \\[Sigma]]][dummyA] der[Kon[\\[Rho], \\[Sigma]]][dummyB]);\nexpectedCoefficientLikeExpr = x GammaAntisymmetricProductHold[{GammaUDHold[dummyA]}, \\[Alpha]3, \\[Alpha]2] GammaAntisymmetricProductHold[{GammaUDHold[dummyB]}, \\[Alpha]t2, \\[Alpha]t1] ProfileX[Kon[\\[Rho], \\[Sigma]], {dummyA, dummyB}, 0, 0];\ncanonExpr1 = CanonicalizeDummyIndices[R[dX[\\[Mu]1, 0, 0], S[{alphaFree, \"chiral\"}, -1/2, {{modeFree, -1}}, 0, 0], ProfileX[Kon[\\[Rho]], {dummyA, dummyB}, 0, 0]]];\ncanonExpr2 = CanonicalizeDummyIndices[R[dX[\\[Mu]1, 0, 0], S[{alphaFree, \"chiral\"}, -1/2, {{modeFree, -1}}, 0, 0], ProfileX[Kon[\\[Rho]], {dummyX, dummyY}, 0, 0]]];\nexpectedCanonExpr = R[dX[\\[Mu]1, 0, 0], S[{alphaFree, \"chiral\"}, -1/2, {{modeFree, -1}}, 0, 0], ProfileX[Kon[\\[Rho]], {\\[Mu]2, \\[Mu]3}, 0, 0]];\ngammaDummyExpr1 = 1/64 r0^4 \\[Alpha]p GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]1]}, \\[Alpha]5, \\[Alpha]1] GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]2]}, \\[Alpha]t1, \\[Beta]1] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]1]}, \\[Alpha]3, \\[Alpha]5] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]2]}, \\[Alpha]t2, \\[Alpha]t1] ProfileX[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2], {\\[Mu]1, \\[Mu]2}, 0, 0];\ngammaDummyExpr2 = 1/64 r0^4 \\[Alpha]p GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]1]}, \\[Alpha]2, \\[Alpha]1] GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]2]}, \\[Alpha]t1, \\[Beta]1] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]1]}, \\[Alpha]3, \\[Alpha]2] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]2]}, \\[Alpha]t2, \\[Alpha]t1] ProfileX[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2], {\\[Mu]1, \\[Mu]2}, 0, 0];\nexpectedGammaDummyCanonExpr = 1/64 r0^4 \\[Alpha]p GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]1]}, \\[Alpha]4, \\[Alpha]1] GammaAntisymmetricProductHold[{GammaDUHold[\\[Rho]2]}, \\[Alpha]5, \\[Beta]1] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]1]}, \\[Alpha]3, \\[Alpha]4] GammaAntisymmetricProductHold[{GammaUDHold[\\[Mu]2]}, \\[Alpha]t2, \\[Alpha]5] ProfileX[Kon[\\[Rho]1, \\[Sigma]1, \\[Rho]2, \\[Sigma]2], {\\[Mu]1, \\[Mu]2}, 0, 0];\nprotectedExpr = R[S[{alphaFree, \"chiral\"}, -1/2, {}, 0, 0], ProfileX[Kon[alphaFree], {alphaFree}, 0, 0]];\n\ntest1 = testReport[\"Test 1 (spin-mode relabeling)\", OperatorCoefficient[expr1, R[S[{a, \"chiral\"}, -1/2, {{b, -1}}, 0, 0], St[{c, \"antichiral\"}, -1/2, {}, 0, 0]]] === GammaAntisymmetricProductHold[{GammaDUHold[b]}, a, c]];\ntest2 = testReport[\"Test 2 (profile-argument relabeling)\", OperatorCoefficient[expr2, R[dX[r, 0, 0], S[{a, \"chiral\"}, -1/2, {}, 0, 0], St[{c, \"antichiral\"}, -1/2, {}, 0, 0]]] === GammaAntisymmetricProductHold[{GammaDUHold[r]}, a, c] ProfileX[Kon[r], {}, 0, 0]];\ntest3 = testReport[\"Test 3 (common coefficient on summed operators)\", OperatorCoefficient[expr3, R[S[{a1, \"chiral\"}, -1/2, {}, 0, 0]] + R[St[{a2, \"antichiral\"}, -1/2, {}, 0, 0]]] === x];\ntest4 = testReport[\"Test 4 (profile derivative absorption inside R)\", absorbedExpr === expectedAbsorbedExpr];\ntest5 = testReport[\"Test 5 (profile derivative absorption in coefficient)\", AbsorbProfileDerivatives[coefficientLikeExpr] === expectedCoefficientLikeExpr];\ntest6 = testReport[\"Test 6 (profile-derivative dummy canonicalization collapse)\", canonExpr1 === canonExpr2 === expectedCanonExpr];\ntest7 = testReport[\"Test 7 (gamma spinor dummy canonicalization collapse)\", CanonicalizeDummyIndices[gammaDummyExpr1] === CanonicalizeDummyIndices[gammaDummyExpr2] === expectedGammaDummyCanonExpr];\ntest8 = testReport[\"Test 8 (protected symbols stay fixed)\", CanonicalizeDummyIndices[protectedExpr] === protectedExpr];\n\nallTests = {test1, test2, test3, test4, test5, test6, test7, test8};\nallPassed = And @@ allTests;\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", Count[allTests, True], \"/\", Length[allTests]];\nIf[allPassed, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\nallPassed",
   "languageId": "wolfram"
  }
 ]
}
