  {
   "kind": 2,
   "value": "br9 = MultiOp[R[dX[mu, 0, z1]], R[ProfileX[h, {}, z2, z2bar]]];\nres9 = Private`BracketProjection[br9, 1, 0];\n{br9Holo, br9AntiHolo, pref9} = Private`factorizeMultiOp[br9];\nholoOps9 = Select[List @@ br9Holo, Private`RTest];\nantiOps9 = Select[List @@ br9AntiHolo, Private`RTest];\nproj9H = If[holoOps9 === {}, 0, OPEProjectedHolo[1] @@ holoOps9];\nproj9A = If[antiOps9 === {}, 1, OPEProjectedAntiHolo[0] @@ antiOps9];\nman9 = pref9 Which[proj9H === 0 || proj9A === 0, 0, proj9H === 1, proj9A, proj9A === 1, proj9H, True, R[proj9H, proj9A]];\ntest9Result = res9 =!= 0 && Simplify[res9 - man9] === 0;\nPrint[\"Test 9 (factorized chiral recombination consistency): \", If[test9Result, \"PASSED\", \"FAILED\"]];\ntest9Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>R[Private`TaylorAtOrderAntiHolo[R[ProfileXAntiHolo[h, {}, z2bar]], 0, 0], \n \n&gt;    Private`TaylorAtOrderHolo[R[dX[mu, 0, z1], ProfileXHolo[h, {}, z2]], 0, \n \n&gt;     0]] + R[Private`TaylorAtOrderAntiHolo[R[ProfileXAntiHolo[h, {}, \n \n                                                    1\n&gt;       z2bar]], 0, 0], Private`TaylorAtOrderHolo[-(-) \n                                                    2\n \n       Î±p R[ProfileXHolo[h, {}, z2]] der[h][mu]\n&gt;      -----------------------------------------, 0, 0]]\n                        z1 - z2\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"R[Private`TaylorAtOrderAntiHolo[R[ProfileXAntiHolo[h, {}, z2bar]], 0, 0], \\n \\n>    Private`TaylorAtOrderHolo[R[dX[mu, 0, z1], ProfileXHolo[h, {}, z2]], 0, \\n \\n>     0]] + R[Private`TaylorAtOrderAntiHolo[R[ProfileXAntiHolo[h, {}, \\n \\n                                                    1\\n>       z2bar]], 0, 0], Private`TaylorAtOrderHolo[-(-) \\n                                                    2\\n \\n       Î±p R[ProfileXHolo[h, {}, z2]] der[h][mu]\\n>      -----------------------------------------, 0, 0]]\\n                        z1 - z2\\n\"",
       "mime": "text/plain"
