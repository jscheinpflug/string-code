  {
   "kind": 2,
   "value": "res7 = Private`BracketProjection[MultiOp[R[dX[mu, 0, z1]], R[dX[nu, 0, z2]]], 2, 0];\nexp7 = OPEProjected[2, 0][R[dX[mu, 0, z1]], R[dX[nu, 0, z2]]];\nPrint[res7]\ntest7Result = Simplify[res7 - exp7] === 0 && MatchQ[res7, _R];\nPrint[\"Test 7 (dX-dX projected regular structure): \", If[test7Result, \"PASSED\", \"FAILED\"]];\ntest7Result",
