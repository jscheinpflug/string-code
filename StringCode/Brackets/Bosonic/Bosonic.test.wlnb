   "kind": 2,
   "value": "br1 = MultiOp[R[b[0, z1]], R[c[0, z2]]];\nres1 = Private`BracketProjection[br1, 1, 0];\nexp1 = OPEProjected[1, 0][R[b[0, z1]], R[c[0, z2]]];\ntest1Result = Simplify[res1 - exp1] === 0;\nPrint[\"Test 1 (single-term projection consistency): \", If[test1Result, \"PASSED\", \"FAILED\"]];\ntest1Result",
