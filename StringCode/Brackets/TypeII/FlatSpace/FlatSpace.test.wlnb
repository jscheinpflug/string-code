{
 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace BRST Nilpotency Tests\n\nChecks that `actBRST` is nilpotent (`Q^2 = 0`) on at least 10 sample `R[...]` operators at integer closed-string picture `{-1,-1}`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Remove[\"Global`*\"];\nNeeds[\"StringCode`\"];\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\" -> \"TypeII-Ashoke\", \"bracket\" -> \"Flat\"|>]\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre><span class=\"wl-message\">Remove::rmnsm</span>: There are no symbols matching \"Global`*\".</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Remove::rmnsm: There are no symbols matching \"Global`*\".",
       "mime": "text/plain"
      }
     ],
     "id": "75d85242-d767-4fc4-ad83-d4d08b5d2b3a",
     "metadata": {
      "cellLabel": "",
      "isBoxData": false
     }
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1772476675014,
     "endTime": 1772476676519
    },
    "executionOrder": 1,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "replaceGeneratedSymbols[expr_] := expr /. s_Symbol /; StringContainsQ[SymbolName[s], \"$\"] :> Symbol[StringReplace[SymbolName[s], \"$\" -> \"dol\"]];\n\ncanon[expr_] := Module[{e = expr},\n  e = Expand[e /. {\\[Alpha]p -> 1}];\n  e = replaceGeneratedSymbols[e];\n  e = Expand[ContractDelta[e]];\n  Expand[e]\n];\n\nzeroQ[expr_] := TrueQ[expr === 0] || TrueQ[Simplify[expr] === 0] || TrueQ[FullSimplify[expr] === 0];\n\nnilpotentQ[op_] := Module[{res = Expand[actBRST[actBRST[op]]], c},\n  c = canon[res];\n  zeroQ[res] || zeroQ[c]\n];\n\ntestReport[name_, cond_] := Module[{},\n  Print[name, \": \", If[TrueQ[cond], \"PASSED\", \"FAILED\"]];\n  cond\n];\n\nuniqueOps[ops_List] := DeleteDuplicatesBy[ops, ToString[InputForm[#]] &];\n\ncuratedOps = {\n  R[c[0, 0], exp\\[Phi]f[-1, 0], \\[Psi][\\[Mu], 0, 0]],\n  R[ct[0, 0], exp\\[Phi]tf[-1, 0], \\[Psi]t[\\[Nu], 0, 0]],\n  R[c[0, 0], exp\\[Phi]b[-2, 0], \\[Xi][1, 0]],\n  R[ct[0, 0], exp\\[Phi]tb[-2, 0], \\[Xi]t[1, 0]],\n  R[\\[Eta][0, 0], \\[Eta]t[0, 0]]\n};\n\nautoOps = uniqueOps[generateBasis[0, 3, {-1, -1}]];\n\nsamples = Take[uniqueOps@Join[curatedOps, autoOps], UpTo[10]];\nsampleCountTest = testReport[\"Test 0 (at least 10 samples)\", Length[samples] >= 10];\n\nresults = If[\n  sampleCountTest,\n  MapIndexed[\n    Function[{op, idx},\n      Module[{ok, resid},\n        ok = nilpotentQ[op];\n        Print[\"Test \", idx[[1]], \" (Q^2=0): \", If[ok, \"PASSED\", \"FAILED\"]];\n        If[!ok,\n          resid = canon[Expand[actBRST[actBRST[op]]]];\n          Print[\"  Operator: \", op];\n          Print[\"  Canonical residual: \", resid];\n        ];\n        ok\n      ]\n    ],\n    samples\n  ],\n  {}\n];\n\nallTests = Prepend[results, sampleCountTest];\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total\n",
   "languageId": "wolfram",
   "outputs": [
