   "value": "allTests = {test1Result, test2Result, test3Result, test4Result, test5Result, test6Result,\n            test7Result, test8Result, test9Result, test10Result, test11Result, test12Result,\n            test13Result, test14Result, test15Result, test16Result, test17Result, test18Result,\n            test19Result, test20Result, test21Result, test22Result, test23Result, test24Result,\n            test25Result, test26Result, test27Result, test28Result, test29Result};\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total",
