  {
   "kind": 1,
   "value": "# EffectiveBracketHold Unit Tests\n\nUnit tests for the combinatorial structure of EffectiveBracketHold, which computes sums over tree-level diagrams built from brackets connected by propagators.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"Bosonic\", \"conventions\" -> \"Bosonic-Xi\", \"CFT\" -> \"FlatSpace\", \"bracket\"->\"Flat\"|>]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
