   "value": "allTests = {test1Result, test2Result, test3Result, test4Result, test5Result, test6Result,\n            test7Result, test8Result, test9Result, test10Result, test11Result, test12Result,\n            test13Result, test14Result, test15Result, test16Result, test17Result, test18Result,\n            test19Result};\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total",
