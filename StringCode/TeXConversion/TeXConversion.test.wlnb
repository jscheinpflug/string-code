   "kind": 2,
   "value": "expr19 = Private`Wedge[Private`Differential[Private`z[3, 1][t], {t}], Private`Differential[Private`zbar[3, 2][tbar], {tbar}]];\ntest19 = ToTeX[expr19];\nexpected19 = \"dz_{1} \\\\wedge d\\\\bar{z}_{2}\";\ntest19Result = test19 === expected19;\nPrint[\"Test 19 (compact wedge): \", If[test19Result, \"PASSED\", \"FAILED - got \" <> test19]];\ntest19Result",
   "languageId": "wolfram",
   "outputs": [],
