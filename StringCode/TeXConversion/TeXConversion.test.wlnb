   "value": "expr21 = Private`Differential[Private`q[4, 2][t], {t}];\ntest21 = ToTeX[expr21, \"OutputMode\" -> \"Display\"];\ntest21Result = StringStartsQ[test21, \"\\\\[\"] && StringEndsQ[test21, \"\\\\]\"] && StringContainsQ[test21, \"dq_{2}\"];\nPrint[\"Test 21 (display mode): \", If[test21Result, \"PASSED\", \"FAILED - got \" <> test21]];\ntest21Result",
   "languageId": "wolfram",
   "outputs": [],
