  {
   "kind": 1,
   "value": "### Test 9: Normal ordered product with TypeII fields\n\nR[c[0,0], ct[0,0], dX[\\[Mu],0,0], \\[Psi][\\[Nu],0,0]]",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "test9 = ToTeX[R[c[0, 0], ct[0, 0], dX[\\[Mu], 0, 0], \\[Psi][\\[Nu], 0, 0]]];\n(* Should contain colons, c, bar{c}, partial X, psi *)\ntest9HasColons = StringContainsQ[test9, \":\"];\ntest9HasC = StringContainsQ[test9, \"c\"];\ntest9HasBarC = StringContainsQ[test9, \"\\\\bar{c}\"];\ntest9HasPartialX = StringContainsQ[test9, \"\\\\partial X\"];\ntest9HasPsi = StringContainsQ[test9, \"\\\\psi\"];\ntest9Result = test9HasColons && test9HasC && test9HasBarC && test9HasPartialX && test9HasPsi;\nPrint[\"Test 9 (R[c,ct,dX,psi]): \", If[test9Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  Result: \", test9];\ntest9Result",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>Test 9 (R[c,ct,dX,psi]): PASSED\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"Test 9 (R[c,ct,dX,psi]): PASSED\\n\"",
       "mime": "text/plain"
      }
     ],
     "id": "5cdf3880-8687-42a1-b25e-2433dc607804",
     "metadata": {
      "cellLabel": "",
      "isBoxData": false
     }
    },
    {
     "items": [
      {
       "data": "<pre>  Result: :c\\bar{c}\\partial X^{\\mu}\\psi^{\\nu}:\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"  Result: :c\\\\bar{c}\\\\partial X^{\\\\mu}\\\\psi^{\\\\nu}:\\n\"",
       "mime": "text/plain"
      }
     ],
     "id": "ef9d4aba-c47c-4eff-949c-63c6cfbe4040",
     "metadata": {
      "cellLabel": "",
      "isBoxData": false
     }
    },
    {
     "items": [
