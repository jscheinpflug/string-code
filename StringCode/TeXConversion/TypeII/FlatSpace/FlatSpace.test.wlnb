 "cells": [
  {
   "kind": 1,
   "value": "# TypeII FlatSpace TeXConversion Unit Tests\n\nUnit tests for TeXConversion of TypeII FlatSpace fields:\n- Free boson (dX, dXt)\n- Plane wave (expX)\n- Profile (ProfileX)\n- Free matter fermion (psi, psit)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Needs[\"StringCode`\"]\nStringCode`InitStringCode[<|\"theory\" -> \"TypeII\", \"CFT\" -> \"FlatSpace\", \"conventions\"-> \"TypeII-Xi\", \"bracket\"->\"Flat\"|>]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1770237130395,
     "endTime": 1770237130521
    },
    "executionOrder": 8,
    "success": true
   }
