  {
   "kind": 1,
   "value": "## Summary",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "allTests = {test1Result, test2Result, test3Result, test4Result, test5Result,\n            test6Result, test7Result, test8Result, test9Result, test10Result};\npassed = Count[allTests, True];\ntotal = Length[allTests];\nPrint[\"\\n=== SUMMARY ===\"];\nPrint[\"Passed: \", passed, \"/\", total];\nIf[passed == total, Print[\"All tests PASSED!\"], Print[\"Some tests FAILED.\"]];\npassed == total",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<pre>\n=== SUMMARY ===\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"\\n=== SUMMARY ===\\n\"",
       "mime": "text/plain"
