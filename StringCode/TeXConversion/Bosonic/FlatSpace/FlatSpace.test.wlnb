   "value": "test10 = ToTeX[R[ProfileX[h[\\[Mu], \\[Nu]], {\\[Lambda]}, 0, 0], c[0, 0], ct[0, 0], dX[\\[Rho], 0, 0], dXt[\\[Sigma], 0, 0]]];\n(* Should be a colon-delimited expression with all the fields *)\ntest10Result = StringContainsQ[test10, \":\"] && StringLength[test10] > 20;\nPrint[\"Test 10 (Full plan example): \", If[test10Result, \"PASSED\", \"FAILED\"]];\nPrint[\"  Result: \", test10];\ntest10Result",
   "languageId": "wolfram",
