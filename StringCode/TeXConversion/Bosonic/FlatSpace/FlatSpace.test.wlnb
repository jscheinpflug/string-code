      {
       "data": "\"  Result: :c\\\\bar{c}\\\\partial X^{\\\\rho}\\\\bar{\\\\partial}\\\\\\n \\n>    X^{\\\\sigma}\\\\partial_{\\\\lambda} h(\\\\mu ,\\\\nu )(0):\\n\"",
       "mime": "text/plain"
      }
