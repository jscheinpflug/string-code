    },
    {
     "items": [
      {
       "data": "<pre>  Result: :c\\bar{c}\\partial X^{\\rho}\\bar{\\partial}\\\n \n&gt;    X^{\\sigma}\\partial_{\\lambda} h(\\mu ,\\nu )(0):\n</pre>",
       "mime": "x-application/wolfram-language-html"
